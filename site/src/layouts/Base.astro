---
import '../styles/swiss.css';
import fontUrl from '../fonts/archivo-latin-wdth-normal.woff2?url';
import { site, url, nav, footerNav } from '../config/site';
import Wordmark from '../components/Wordmark.astro';

interface Props { title?: string; description?: string; page: 'home' | 'essays' | 'essay' | 'about' | 'team' | 'contact'; head?: boolean }
const { title, description = site.description, page, head = true } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const current = (href: string) => (href === url(`${page}/`) || (page === 'team' && href === url('about/')) ? 'page' : undefined);
---
<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ecece8" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="gridlines" aria-hidden="true">{Array.from({ length: 12 }, () => <i />)}</div>
    {head && (
      <header class="site-head grid">
        <Wordmark />
        <nav aria-label="Primary">
          {nav.map((n) => <a class="navlink" href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
        </nav>
      </header>
    )}
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot grid">
      <div class="site-foot__top" aria-hidden="true"></div>
      <div class="site-foot__id"><Wordmark /><p class="ph">[Location]</p></div>
      <nav class="site-foot__nav" aria-label="Footer">
        <ul>{footerNav.map((n) => <li><a class="textlink" href={n.href}>{n.label}</a></li>)}</ul>
      </nav>
      <div class="site-foot__meta"><p>{site.email}</p><p class="site-foot__c">© {site.year} {site.name}</p></div>
    </footer>
  </body>
</html>
