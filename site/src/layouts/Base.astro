---
import '@fontsource-variable/archivo/standard.css';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { site, url, mailto } from '../config/site';

interface Props { title?: string; description?: string; page: 'home' | 'essays' | 'essay' | 'about' | 'team' | 'contact' }
const { title, description = site.description, page } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const nav = [
  { label: 'Capabilities', href: url('#capabilities'), key: 'capabilities' },
  { label: 'Approach', href: url('#approach'), key: 'approach' },
  { label: 'Company', href: url('about/'), key: 'about' },
  { label: 'Contact', href: url('#contact'), key: 'contact' },
];
const foot = [
  { label: 'Capabilities', href: url('#capabilities') },
  { label: 'Approach', href: url('#approach') },
  { label: 'Research', href: url('essays/') },
  { label: 'About', href: url('about/') },
  { label: 'Team', href: url('team/') },
  { label: 'Contact', href: url('contact/') },
];
---
<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0c1128" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      (function () {
        try {
          var t = sessionStorage.getItem('tk.veil');
          if (t && !matchMedia('(prefers-reduced-motion: reduce)').matches) { document.documentElement.classList.add('veil-arrive'); window.__veilTitle = t; }
          sessionStorage.removeItem('tk.veil');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="hd">
      <a class="brand" href={url()} aria-label={`${site.name}, home`}>
        <Mark />
        {page !== 'home' && <span class="brand__word">{site.name}</span>}
      </a>
      <nav class="nav t-label" aria-label="Site">
        {nav.map((n) => (
          <a class="lk" href={n.href} aria-current={page === n.key || (page === 'team' && n.key === 'about') || (page === 'contact' && n.key === 'contact') ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="ft t-label">
      <nav class="ft__nav" aria-label="Footer">
        {foot.map((n) => <a class="lk" href={n.href}>{n.label}</a>)}
      </nav>
      {mailto ? <a class="lk ft__mail" href={mailto}>{site.email}</a> : <span class="ft__mail">{site.email}</span>}
      <span class="ft__c">© {site.year} {site.name}</span>
    </footer>
    <div class="veil" aria-hidden="true"><i style="--y:-50vmax"></i><i style="--y:0vmax"><span data-veil-title></span></i><i style="--y:50vmax"></i><b></b></div>
    <script is:inline>
      (function () { var t = window.__veilTitle, el = document.querySelector('[data-veil-title]'); if (t && el) el.textContent = t; })();
    </script>
    <script>
      // Page change: the agent crosses, three light planes slide in along the site's axis, the middle one carrying
      // the destination's title; the new page opens with the same planes sliding on and away, no hold.
      const veil = document.querySelector<HTMLElement>('.veil');
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      const TITLES: Record<string, string> = { '': 'Corollary Labs', essays: 'Research', about: 'About', team: 'Team', contact: 'Contact' };
      const titleFor = (a: HTMLAnchorElement, u: URL) => {
        if (a.dataset.title) return a.dataset.title;
        const key = u.pathname.slice(base.length).replace(/^\/|\/$/g, '');
        return TITLES[key] ?? (a.textContent || '').replace(/\s+/g, ' ').replace(/[→←]/g, '').trim().slice(0, 48);
      };
      const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.addEventListener('click', (e) => {
        if (rm || !veil || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element).closest?.('a');
        if (!a || a.target || a.hasAttribute('download')) return;
        const u = new URL(a.href, location.href);
        if (!/^https?:$/.test(u.protocol) || u.origin !== location.origin) return;
        if (u.pathname.replace(/\/$/, '') === location.pathname.replace(/\/$/, '')) return;
        e.preventDefault();
        const t = titleFor(a, u);
        const span = veil.querySelector<HTMLElement>('[data-veil-title]');
        if (span) span.textContent = t;
        try { sessionStorage.setItem('tk.veil', t || ' '); } catch {}
        veil.classList.add('is-in');
        setTimeout(() => { location.href = u.href; }, 400);
      });
      window.addEventListener('pageshow', (e) => { if (e.persisted) veil?.classList.remove('is-in'); });
      setTimeout(() => document.documentElement.classList.remove('veil-arrive'), 900);
    </script>
  </body>
</html>
