---
import '@fontsource-variable/inter-tight/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScoreBar from '../components/ScoreBar.astro';
import { site, u } from '../config/site';

interface Props { title?: string; description?: string; page: string; header?: boolean; bar?: 'inline' | 'home' }
const { title, description = site.description, page, header = true, bar = 'inline' } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
---
<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f3f3ef" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {header && <Header current={page} />}
    <ScoreBar home={bar === 'home'} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // text marked data-play is inked left to right the first time it comes into view
      const els = document.querySelectorAll<HTMLElement>('[data-play]');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) els.forEach((e) => e.classList.add('is-played'));
      else {
        const io = new IntersectionObserver((entries) => entries.forEach((en) => {
          if (en.isIntersecting) { en.target.classList.add('is-played'); io.unobserve(en.target); }
        }), { rootMargin: '0px 0px -18% 0px' });
        els.forEach((e) => { if (!e.hasAttribute('data-play-manual')) io.observe(e); });
      }
      const marks = document.querySelectorAll<HTMLElement>('.bigmark, [data-body] h2');
      if (!('IntersectionObserver' in window)) marks.forEach((m) => m.classList.add('is-on'));
      else {
        const mo = new IntersectionObserver((entries) => entries.forEach((en) => {
          if (en.isIntersecting) { en.target.classList.add('is-on'); mo.unobserve(en.target); }
        }), { rootMargin: '0px 0px -30% 0px' });
        marks.forEach((m) => mo.observe(m));
      }
    </script>
  </body>
</html>
