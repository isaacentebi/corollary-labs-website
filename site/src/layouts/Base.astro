---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/martian-mono/wdth.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import Footer from '../components/Footer.astro';
import { site, nav, url } from '../config/site';

interface Props { title?: string; description?: string; page: 'home' | 'essays' | 'essay' | 'about' | 'team' | 'contact' }
const { title, description = site.description, page } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0a0a09" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('rm');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="hd">
      <a class="hd__brand" href={url()} aria-label={`${site.name}, home`}>
        <Mark class="hd__mark" />
        <span class="hd__word">Corollary <span>Labs</span></span>
      </a>
      <nav class="hd__nav mono" aria-label="Site">
        {nav.map((n) => (
          <a href={n.href} aria-current={n.match?.some((m) => path.includes(`/${m}`)) ? 'page' : undefined}>
            <span class="hd__n">{n.n}</span>{n.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
