---
import '@fontsource-variable/archivo/standard.css';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { site, url } from '../config/site';

interface Props { title?: string; description?: string; page: 'home' | 'essays' | 'essay' | 'about' | 'team' | 'contact' }
const { title, description = site.description, page } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const nav = [
  { label: 'Essays', href: url('essays/'), key: 'essays' },
  { label: 'About', href: url('about/'), key: 'about' },
  { label: 'Team', href: url('team/'), key: 'team' },
  { label: 'Contact', href: url('contact/'), key: 'contact' },
];
---
<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0c1128" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="hd">
      <a class="brand" href={url()} aria-label={`${site.name}, home`}>
        <Mark />
        <span class="brand__word">{site.name}</span>
      </a>
      <nav class="nav t-label" aria-label="Site">
        {nav.map((n) => (
          <a class="lk" href={n.href} aria-current={page === n.key || (page === 'essay' && n.key === 'essays') ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="ft t-label">
      <span>© {site.year} {site.name}</span>
      <nav class="ft__nav" aria-label="Footer">
        {nav.map((n) => <a class="lk" href={n.href}>{n.label}</a>)}
      </nav>
      <a class="lk" href={`mailto:${site.email}`}>{site.email}</a>
    </footer>
  </body>
</html>
