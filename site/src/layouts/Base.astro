---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Mark from '../components/Mark.astro';
import Selector from '../components/Selector.astro';
import MotionSwitch from '../components/MotionSwitch.astro';
import { site, type PageKey } from '../config/site';
import { url } from '../lib/url';

interface Props { title?: string; description?: string; page: PageKey | 'essay'; header?: boolean }
const { title, description = site.description, page, header = true } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
---
<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#dcdad4" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      (function () {
        var d = document.documentElement, v = null;
        try { v = localStorage.getItem('cyber.motion'); } catch (e) {}
        if (!v) v = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'off' : 'on';
        d.setAttribute('data-motion', v);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {header && (
      <header class="site-head wrap">
        <div class="site-head__left">
          <a class="brand" href={url()}><Mark /><span class="brand__word">{site.name}</span></a>
        </div>
        <div class="site-head__right">
          <MotionSwitch />
          <Selector current={page} />
        </div>
      </header>
    )}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/controls';
    </script>
  </body>
</html>
