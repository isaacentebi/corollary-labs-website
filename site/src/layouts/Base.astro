---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { u } from '../lib/url';

interface Props { title?: string; description?: string; page: string; field?: 'fixed' | 'none'; tone?: 'day' | 'dusk'; intro?: boolean; shift?: 'right' }
const { title, description = site.description, page, field = 'fixed', tone = 'day', intro = false, shift } = Astro.props;
// the page's first colour, before the light is drawn (the first scene's own field, never a cream flash)
const pageBg = tone === 'dusk' ? '#0b1522' : '#e3e8ec';
const ogImage = new URL(u('/og.png'), Astro.site).href;
const fullTitle = title ? `${title} — ${site.name}` : site.homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en" data-page={page} data-tone={tone} data-nav-tone={tone} style={`--page-bg:${pageBg}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={pageBg} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={u('/fonts/albert-sans.woff2')} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href={u('/fonts/fonts.css')} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { if (sessionStorage.getItem('cl-visited')) document.documentElement.classList.add('returning'); sessionStorage.setItem('cl-visited', '1'); } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {field === 'fixed' && <canvas class="field" data-field data-intro={intro ? 'on' : undefined} data-shift={shift} aria-hidden="true"></canvas>}
    <Nav current={page} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
