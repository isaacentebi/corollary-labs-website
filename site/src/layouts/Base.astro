---
import '@fontsource-variable/instrument-sans/wdth.css';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { site, url } from '../config/site';
interface Props { title?: string; description?: string; page?: string }
const { title, description = site.description, page = 'page' } = Astro.props;
const full = title ? `${title} — ${site.name}` : site.name;
const nav = [
  { label: 'Essays', href: url('essays/'), key: 'essays' },
  { label: 'About', href: url('about/'), key: 'about' },
  { label: 'Team', href: url('team/'), key: 'team' },
  { label: 'Contact', href: url('contact/'), key: 'contact' },
];
---
<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EEEBE3" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
      <!-- the brayer: fine streaks where the ink ran thin, drawn over each part along its length -->
      <pattern id="streak" patternUnits="userSpaceOnUse" width="61" height="5.3">
        <rect x="0" y="0.3" width="38" height="0.9" fill="#EEEBE3" opacity="0.09" />
        <rect x="21" y="1.6" width="40" height="0.35" fill="#EEEBE3" opacity="0.14" />
        <rect x="4" y="2.6" width="27" height="1.3" fill="#EEEBE3" opacity="0.06" />
        <rect x="35" y="3.4" width="21" height="0.5" fill="#EEEBE3" opacity="0.12" />
        <rect x="9" y="4.5" width="46" height="0.6" fill="#EEEBE3" opacity="0.07" />
        <circle cx="47" cy="1.1" r="0.22" fill="#EEEBE3" opacity="0.5" />
        <circle cx="13" cy="4.1" r="0.16" fill="#EEEBE3" opacity="0.5" />
      </pattern>
    </svg>
    <header class="top" data-top>
      <a class="brand" href={url('')} aria-label={`${site.name}, home`}>
        <Mark size={30} />
        <span class="brand__name">{site.name}</span>
      </a>
      <button class="top__menu" type="button" data-menu aria-expanded="false" aria-controls="site-nav"><span class="ov" data-text="Menu">Menu</span></button>
      <nav class="top__nav" id="site-nav" aria-label="Site">
        {nav.map((n) => (
          <a href={n.href} class="ov" data-text={n.label} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="foot__grid">
        <a class="brand brand--foot" href={url('')}><Mark size={22} /><span>{site.name}</span></a>
        {page !== 'home' && (
          <nav class="foot__nav" aria-label="Footer">
            {nav.map((n) => <a href={n.href} class="ov" data-text={n.label}>{n.label}</a>)}
          </nav>
        )}
        <p class="foot__meta"><span>{site.email}</span><span>© {site.year}</span></p>
      </div>
    </footer>
    <script>
      // The header: hides while you read down, returns as soon as you scroll up.
      // On phones, the four links fold into a menu.
      const top = document.querySelector<HTMLElement>('[data-top]');
      const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
      if (top) {
        let last = scrollY, ticking = false;
        const update = () => {
          ticking = false;
          const y = scrollY, dy = y - last;
          top.classList.toggle('is-solid', y > 24);
          if (Math.abs(dy) > 4) {
            const hide = dy > 0 && y > 120 && top.dataset.open !== 'true' && !top.contains(document.activeElement);
            top.classList.toggle('is-hidden', hide);
            last = y;
          }
        };
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        top.addEventListener('focusin', () => top.classList.remove('is-hidden'));
        update();
      }
      if (top && btn) {
        const label = btn.querySelector('span')!;
        const set = (open: boolean) => {
          top.dataset.open = String(open);
          btn.setAttribute('aria-expanded', String(open));
          label.textContent = open ? 'Close' : 'Menu';
          label.dataset.text = label.textContent;
        };
        btn.addEventListener('click', () => set(top.dataset.open !== 'true'));
        addEventListener('keydown', (e) => { if (e.key === 'Escape' && top.dataset.open === 'true') { set(false); btn.focus(); } });
      }
    </script>
  </body>
</html>
