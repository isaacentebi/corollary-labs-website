---
import '@fontsource-variable/unbounded/wght.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Mark from '../components/Mark.astro';
import Footer from '../components/Footer.astro';
import { site, href, nav } from '../config/site';

type Page = 'home' | 'essays' | 'essay' | 'about' | 'team' | 'contact' | 'notfound';
interface Props { title?: string; description?: string; page: Page; theme?: 'violet' | 'paper' }
const { title, description = site.description, page, theme = 'violet' } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const current = Astro.url.pathname;
// page change: the old content goes first, then the new content comes in (the field is never cross-faded)
const out = { name: 'clOut', duration: '120ms', easing: 'ease-in', fillMode: 'both' };
const inn = { name: 'clIn', duration: '280ms', delay: '120ms', easing: 'cubic-bezier(.2,.7,.2,1)', fillMode: 'both' };
const pageAnim = { forwards: { old: out, new: inn }, backwards: { old: out, new: inn } };
---
<!doctype html>
<html lang="en" data-page={page} data-theme={theme} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content={theme === 'paper' ? '#eeeaff' : '#22158a'} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <ClientRouter fallback="swap" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('rm');
    </script>
  </head>
  <body>
    <canvas id="field" class="field" aria-hidden="true" transition:persist="field"></canvas>
    <div class="probe" aria-hidden="true" transition:persist="probe"><i></i></div>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="top__home" href={href()} aria-label={`${site.name}, home`}>
        <Mark size={24} /><span>{site.name}</span>
      </a>
      <nav class="top__nav" aria-label="Main">
        {nav.map((n) => (
          <a href={href(n.path)} aria-current={'current' in n && n.current.some((c) => current.startsWith(href(c))) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <div class="page" transition:name="page" transition:animate={pageAnim}>
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
