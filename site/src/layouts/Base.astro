---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Mark from '../components/Mark.astro';
interface Props { title?: string; description?: string; page?: string; over?: boolean }
const { title, description = 'Corollary Labs deploys AI agents inside organisations and rebuilds the operations around them.', page = '', over = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const full = title ? `${title} — Corollary Labs` : 'Corollary Labs';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#18181a" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body data-page={page}>
    <div id="top"></div>
    <header class:list={['hdr', { 'hdr--over': over }]} data-header>
      <a class="hdr__home" href={base} aria-label="Corollary Labs, home"><Mark size={22} /><span class="hdr__name">Corollary Labs</span></a>
      <nav class="mono" aria-label="Main">
        <a href={`${base}#capabilities`}>Capabilities</a>
        <a href={`${base}#approach`}>Approach</a>
        <a href={`${base}about/`} aria-current={page === 'about' || page === 'team' ? 'page' : undefined}>Company</a>
        <a href={`${base}#contact`}>Contact</a>
      </nav>
    </header>
    <main><slot /></main>
    <Footer />
    <script>
      import { mountWoven, mountLooms } from '../scripts/loom2d';
      mountWoven();
      mountLooms();
    </script>
  </body>
</html>
