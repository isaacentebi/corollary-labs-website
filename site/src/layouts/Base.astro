---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Deck from '../components/Deck.astro';
import MHead from '../components/MHead.astro';
import Menu from '../components/Menu.astro';
import { site } from '../config/site';
import { url } from '../lib/url';

interface Props { title?: string; description?: string; page: string; home?: boolean }
const { title, description = site.description, page, home = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
---
<!doctype html>
<html lang="en" data-page={page} data-motion="on" data-sound="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#dcdad4" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      (function () {
        var d = document.documentElement, m = null, s = null;
        try { m = localStorage.getItem('cyber.motion'); s = localStorage.getItem('cyber.sound'); } catch (e) {}
        if (!m) m = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'off' : 'on';
        d.setAttribute('data-motion', m);
        d.setAttribute('data-sound', s === 'on' ? 'on' : 'off');
        // with motion off, pages cut instead of carrying the face across
        window.addEventListener('pagereveal', function (e) { if (e.viewTransition && d.getAttribute('data-motion') === 'off') e.viewTransition.skipTransition(); });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Menu current={page} />
    <div class="shell">
      <div class="col">
        {!home && <MHead current={page}><slot name="mhead" /></MHead>}
        <main id="main">
          <slot />
        </main>
        <Footer />
      </div>
      <Deck current={page} statement={home} brandTag={home ? 'h1' : 'div'}>
        <slot name="deck" />
      </Deck>
    </div>
    <script>
      import '../scripts/controls';
    </script>
  </body>
</html>
