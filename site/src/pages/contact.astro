---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import '../styles/pages.css';
---
<Base page="contact" title="Contact">
  <div class="wrap page">
    <header class="page-head">
      <h1 class="h-page">Contact</h1>
    </header>
    <section class="split">
      <h2 class="t-label"><span class="lamp is-on"></span>Write</h2>
      <div>
        <p class="contact-big"><a href="#">{site.email}</a></p>
        <p class="ph">[One line on what to write about]</p>
      </div>
    </section>
    <section class="split">
      <h2 class="t-label"><span class="lamp"></span>Address</h2>
      <p class="ph contact-addr">[Street]<br />[City, postcode]<br />[Country]</p>
    </section>
  </div>
</Base>
