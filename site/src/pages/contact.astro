---
import Base from '../layouts/Base.astro';
import { site, url } from '../config/site';
import '../styles/pages.css';
---
<Base page="contact" title="Contact" description={`Contact ${site.name}.`}>
  <section class="page">
    <header class="ph-row reveal">
      <p class="ph-row__n mono">04</p>
      <h1 class="ph-row__t">Contact</h1>
      <p class="ph-row__m mono"><span><b>Table 4.</b> Contact</span><span>One row</span></p>
    </header>
    <a class="ct__mail reveal" href={`mailto:${site.email}`}>{site.email}</a>

    <table class="tb colo reveal">
      <caption class="mono"><b>Details</b></caption>
      <tbody>
        <tr><td class="mono" style="width:30%;color:var(--i3)">Email</td><td><a class="link" href={`mailto:${site.email}`}>{site.email}</a></td></tr>
        <tr><td class="mono" style="color:var(--i3)">Location</td><td class="ph">[City]</td></tr>
        <tr><td class="mono" style="color:var(--i3)">Writing to us</td><td class="ph">[Placeholder — what to write about.]</td></tr>
        <tr><td class="mono" style="color:var(--i3)">Reading</td><td><a class="link" href={url('essays/')}>Essays</a></td></tr>
      </tbody>
    </table>
  </section>
</Base>
