---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
// one pale stone and one rose one, and the address resting in a clearing between them
const stones = [{ x: -0.3, y: 0.2, r: 0.13 }, { x: 0.33, y: -0.22, r: 0.07, rose: 1 }];
const mstones = [{ x: -0.18, y: 0.3, r: 0.13 }, { x: 0.26, y: -0.3, r: 0.08 }];
---
<Base page="contact" title="Contact">
  <section class="contact-band band" data-band={JSON.stringify({ stones, mstones, clear: '[data-clear]' })}>
    <div class="contact-band__in" data-clear>
      <h1>Contact</h1>
      <p class="contact-email">{site.email}</p>
      <p class="contact-lines"><span>[Address]</span><span>[Other channel]</span></p>
    </div>
  </section>
</Base>
