---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
// a large slab and a small rose stone, and the address resting in a clearing between them
const stones = [{ x: -0.3, y: 0.22, r: 0.16, sq: 0.55, a: 1.3 }, { x: 0.33, y: -0.24, r: 0.05, rose: 1, gloss: 0.85 }, { x: 0.38, y: -0.14, r: 0.028, tone: 1, gloss: 0.8 }];
const mstones = [{ x: -0.16, y: 0.32, r: 0.15 }, { x: 0.24, y: -0.32, r: 0.08 }, { x: 0.36, y: -0.26, r: 0.04 }];
---
<Base page="contact" title="Contact">
  <section class="contact-band band" data-band={JSON.stringify({ stones, mstones, drag: true, clear: '[data-clear]' })}>
    <div class="contact-band__in" data-clear>
      <h1>Contact</h1>
      <p class="contact-line contact-line--sm">Deploying agents in your organisation? Talk to us.</p>
      <p class="contact-email">{site.email}</p>
      <p class="contact-lines"><span>[Address]</span><span>[Other channel]</span></p>
    </div>
  </section>
</Base>
