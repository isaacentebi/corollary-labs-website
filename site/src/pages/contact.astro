---
import Base from '../layouts/Base.astro';
import WovenTitle from '../components/WovenTitle.astro';
import Loom from '../components/Loom.astro';
import '../styles/pages.css';
---
<Base title="Contact" page="contact">
  <WovenTitle text="Contact" cap={26} width="680px" />
  <section class="wrap sheet">
    <p class="lede">[Contact — one sentence]</p>
    <p class="contact__mail"><span class="lnk">[Email]</span></p>
    <dl class="colophon">
      <div><dt class="mono">Address</dt><dd>[Address]</dd></div>
      <div><dt class="mono">Press</dt><dd>[Email]</dd></div>
    </dl>
  </section>
  <section class="wrap plate">
    <Loom rows={18} cellCss={5} threads={[{ af: 0.5, vc: 9, R: 34 }]} grow ms={3000} />
  </section>
</Base>
