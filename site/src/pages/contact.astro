---
import Base from '../layouts/Base.astro';
---
<Base page="contact" title="Contact">
  <section class="page wrap shaft">
    <header class="phead">
      <h1 class="phead__title">Contact</h1>
    </header>
    <div class="split">
      <dl class="colophon colophon--stack">
        <div><dt class="label">Email</dt><dd class="big ph">[Email]</dd></div>
        <div><dt class="label">Address</dt><dd class="ph">[Address — two lines]</dd></div>
        <div><dt class="label">Press</dt><dd class="ph">[Press contact]</dd></div>
      </dl>
      <div class="split__fig">
        <canvas class="plate plate--small" data-axon="org" data-th="-0.9" aria-hidden="true"></canvas>
      </div>
    </div>
  </section>
</Base>
