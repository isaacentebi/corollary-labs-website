---
import Base from '../layouts/Base.astro';
import Woven from '../components/Woven.astro';
import '../styles/pages.css';
---
<Base title="Contact" page="contact">
  <div class="title" style="--tw: 620px"><h1>Contact</h1><Woven text="Contact" /></div>
  <section class="wrap page-grid">
    <p class="lede ph">[Contact — one sentence]</p>
    <dl class="colophon mono">
      <div><dt>Email</dt><dd class="ph">[Email]</dd></div>
      <div><dt>Address</dt><dd class="ph">[Address]</dd></div>
    </dl>
  </section>
</Base>
