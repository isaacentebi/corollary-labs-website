---
import Base from '../layouts/Base.astro';
import Glyph from '../components/Glyph.astro';
import { site } from '../config/site';
import '../styles/pages.css';
---
<Base page="contact" title="Contact">
  <section class="page">
    <header class="page__head" data-glyph-host>
      <h1 class="display">Contact</h1>
      <Glyph seed="contact" class="page__glyph" big />
    </header>
    <dl class="contact">
      <div><dt class="t-label">Email</dt><dd><a class="contact__mail lk" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
      <div><dt class="t-label">Address</dt><dd class="ph">[Address]</dd></div>
      <div><dt class="t-label">Elsewhere</dt><dd class="ph">[Links]</dd></div>
    </dl>
  </section>
</Base>
