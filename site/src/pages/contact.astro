---
import Base from '../layouts/Base.astro';
---
<Base page="contact" title="Contact">
  <header class="phead">
    <h1 class="phead__t cut">Contact</h1>
  </header>
  <section class="contact cut">
    <p class="contact__mail ph">[Email]</p>
    <dl class="contact__list">
      <div><dt class="label">Address</dt><dd class="ph">[Address]</dd></div>
      <div><dt class="label">Press</dt><dd class="ph">[Press email]</dd></div>
      <div><dt class="label">Elsewhere</dt><dd class="ph">[Links]</dd></div>
    </dl>
  </section>
</Base>
