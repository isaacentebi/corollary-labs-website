---
import Base from '../layouts/Base.astro';
import Face from '../components/Face.astro';
import { site, hasEmail } from '../config/site';
import '../styles/pages.css';
---
<Base page="contact" title="Contact">
  <Face kind="contact" class="face--band" />
  <div class="page">
    <header class="page-head">
      <h1 class="h-page">Contact</h1>
    </header>
    <section class="split">
      <h2 class="t-label mono"><span class="lamp"></span>Write</h2>
      <div>
        <p class="contact-line">Deploying agents in your organisation? Talk to us.</p>
        {hasEmail ? <p class="contact-big"><a href={`mailto:${site.email}`} data-ping="0">{site.email}</a></p> : <p class="contact-big ph" data-ping="0">{site.email}</p>}
      </div>
    </section>
    <section class="split">
      <h2 class="t-label mono"><span class="lamp"></span>Address</h2>
      <p class="ph contact-addr">[Street]<br />[City, postcode]<br />[Country]</p>
    </section>
  </div>
</Base>
<script>
  import '../scripts/faces';
</script>
