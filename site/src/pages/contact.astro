---
import Base from '../layouts/Base.astro';
import PagePlate from '../components/PagePlate.astro';
import { site } from '../config/site';
import '../styles/pages.css';
const rows = [
  { k: 'Email', v: site.email, href: `mailto:${site.email}` },
  { k: 'Address', v: '[Address]' },
  { k: 'Elsewhere', v: '[Links]' },
];
---
<Base page="contact" title="Contact">
  <PagePlate title="Contact" variant={3}>
    <p class="plate__line ph">[Contact — one line under the title]</p>
  </PagePlate>
  <section class="page page--after">
    <div class="tilt" style={`--n:${rows.length}`}>
      <svg class="tilt__axis" aria-hidden="true" preserveAspectRatio="none"><line x1="100%" y1="0" x2="0" y2="100%" /></svg>
      <dl class="contact">
        {rows.map((r, i) => (
          <div style={`--i:${i}`}>
            <dt class="t-label">{r.k}</dt>
            <dd class={r.href ? '' : 'ph'}>{r.href ? <a class="contact__mail lk" href={r.href}>{r.v}</a> : r.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
