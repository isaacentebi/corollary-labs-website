---
import Base from '../layouts/Base.astro';
import Email from '../components/Email.astro';
import { contact, site } from '../config/site';
---
<Base page="contact" title={contact.title} description={contact.line} tone="dusk">
  <!-- the finished field: every band turned -->
  <section class="c wrap" data-light="contact" data-tone-section="dusk" aria-labelledby="c-h">
    <div class="c__text" data-tone-probe>
      <h1 id="c-h" class="label">{contact.title}</h1>
      <p class="c__line">{contact.line}</p>
      <p class="c__email"><Email /></p>
      <dl class="c__meta">
        <div><dt>Location</dt><dd class="ph">{site.location}</dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .c { min-height: 100svh; display: flex; justify-content: center; align-items: flex-start; text-align: center; padding-top: 22svh; }
  .c__text { display: grid; gap: 16px; justify-items: center; }
  .c__line { font-size: var(--fs-display); font-weight: 300; line-height: 1.06; letter-spacing: -0.024em; max-width: 14em; text-wrap: balance; }
  .c__email { font-size: var(--fs-h3); font-weight: 350; }
  .c__meta { margin: 6px 0 0; font-size: var(--fs-small); color: var(--ink-2); }
  .c__meta dd { margin: 2px 0 0; }
  @media (max-width: 759px) { .c { padding-top: 18svh; } .c__line { font-size: 1.7rem; } }
</style>
