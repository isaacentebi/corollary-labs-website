---
import Base from '../layouts/Base.astro';
import { ideas, practice, thinking, research, contact } from '../config/site';
import { u } from '../lib/url';
---
<Base page="thinking" title="How we think" description={thinking.intro} shift="right">
  <section class="t-head wrap" data-light="hero" data-tone-section="day">
    <h1 class="t-head__title" data-reveal>{thinking.title}</h1>
    <p class="t-head__intro" data-reveal data-d="1">{thinking.intro}</p>
    <ol class="t-head__index" data-reveal data-d="2">
      {ideas.map((it, i) => <li><a href={`#${it.key}`}><span class="faint">{String(i + 1).padStart(2, '0')}</span> {it.title}</a></li>)}
    </ol>
  </section>

  {ideas.map((it, i) => (
    <section id={it.key} class={`idea idea--${it.key}`} data-light={it.key} data-tone-section="dusk" aria-labelledby={`h-${it.key}`}>
      <div class="idea__text wrap">
        <div class="idea__panel">
          <h2 id={`h-${it.key}`} class="idea__title">{it.title}</h2>
          <p class="idea__line">{it.line}</p>
          {it.body.map((b) => <p class="idea__body">{b}</p>)}
        </div>
      </div>
    </section>
  ))}

  <div class="t-dawn" data-light="dawn" data-tone-section="dusk" aria-hidden="true"></div>

  <section class="practice wrap" data-light="research" data-tone-section="day" aria-labelledby="practice-h">
    <h2 id="practice-h" class="label" data-reveal>{practice.title}</h2>
    <ol class="practice__list">
      {practice.items.map((p, i) => (
        <li data-reveal data-d={String(i)}>
          <span class="faint">{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.name}</h3>
          <p class="muted">{p.text}</p>
        </li>
      ))}
    </ol>
    <div class="practice__next" data-reveal>
      <a class="link" href={u('/research/')}>{research.title} <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn" href={u('/contact/')}>{contact.title}</a>
    </div>
  </section>
</Base>

<style>
  .t-head { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: 22px; padding-top: 90px; padding-bottom: 8vh; max-width: min(56vw, 900px); box-sizing: content-box; }
  .t-head__title { font-size: var(--fs-display); font-weight: 300; letter-spacing: -0.025em; }
  .t-head__intro { font-size: var(--fs-h3); font-weight: 320; line-height: 1.3; letter-spacing: -0.01em; max-width: 26em; text-wrap: pretty; }
  .t-head__index { margin-top: 18px; display: grid; gap: 2px; border-top: 1px solid var(--rule); max-width: 30rem; }
  .t-head__index a { display: flex; gap: 16px; font-variant-numeric: tabular-nums; padding: 11px 0; border-bottom: 1px solid var(--rule); font-size: 1.02rem; transition: padding 0.4s var(--ease); }
  .t-head__index a:hover { padding-left: 6px; }

  .idea { min-height: 200vh; position: relative; }
  .idea--auto, .idea--deform { min-height: 240vh; }
  .idea__text { position: sticky; top: 0; min-height: 100vh; display: flex; align-items: center; }
  .idea__panel { max-width: min(40vw, 34rem); display: grid; gap: 14px; }

  .idea__title { font-size: 1rem; font-weight: 500; letter-spacing: 0; color: var(--lit-2); }
  .idea__line { font-size: var(--fs-h2); font-weight: 300; line-height: 1.12; letter-spacing: -0.018em; text-wrap: balance; margin-bottom: 8px; }
  .idea__body { font-size: 1.06rem; line-height: 1.6; color: var(--lit-2); max-width: 30em; }
  .t-dawn { height: 70vh; }

  .practice { padding-top: 22vh; padding-bottom: 18vh; }
  .practice__list { margin-top: 28px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; border-top: 1px solid var(--rule); padding-top: 26px; }
  .practice__list li { display: grid; gap: 10px; align-content: start; }
  .practice__list h3 { font-size: var(--fs-h3); font-weight: 360; }
  .practice__next { margin-top: 64px; display: flex; gap: 32px; align-items: center; font-weight: 480; }

  @media (max-width: 759px) {
    .t-head { max-width: none; justify-content: flex-end; padding-bottom: 10vh; }
    /* phones: the light has the screen to itself, then the text passes over it, then the light again */
    .idea, .idea--auto, .idea--deform { min-height: 0; }
    .idea__text { position: relative; min-height: 0; display: block; padding-top: 62svh; padding-bottom: 46svh; }
    .idea__panel { max-width: none; text-shadow: 0 0 18px rgba(8, 11, 36, 0.55), 0 0 2px rgba(8, 11, 36, 0.4); }
    .idea__line { font-size: 1.4rem; }
    .idea__body { font-size: 0.98rem; }
    .practice__list { grid-template-columns: 1fr; }
    .t-dawn { height: 50vh; }
  }
</style>
