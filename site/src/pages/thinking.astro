---
import Base from '../layouts/Base.astro';
import { ideas, thinking, research, contact } from '../config/site';
import { u } from '../lib/url';
// each idea has its own composition; the text goes where the light is not
const tone: Record<string, 'day' | 'dusk'> = { io: 'dusk', auto: 'dusk', combine: 'day', deform: 'dusk', diffuse: 'dusk' };
---
<Base page="thinking" title="How we think" description={thinking.intro}>
  <section class="t-head wrap" data-light="hero" data-tone-section="day">
    <div class="t-head__text" data-tone-probe>
      <h1 class="t-head__title">{thinking.title}</h1>
      <p class="t-head__intro">{thinking.intro}</p>
      <ol class="t-head__index">
        {ideas.map((it, i) => <li><a href={`#${it.key}`}><span class="t-head__n">{String(i + 1).padStart(2, '0')}</span> {it.title}</a></li>)}
      </ol>
    </div>
  </section>

  {ideas.map((it) => (
    <section id={it.key} class={`idea idea--${it.key}`} data-light={it.key} data-tone-section={tone[it.key]} aria-labelledby={`h-${it.key}`}>
      <div class="idea__text wrap">
        <div class="idea__panel" data-tone-probe>
          <h2 id={`h-${it.key}`} class="idea__title">{it.title}</h2>
          <p class="idea__line">{it.line}</p>
          {it.body.map((b) => <p class={`idea__body${b.startsWith('[') ? ' ph' : ''}`}>{b}</p>)}
        </div>
      </div>
    </section>
  ))}

  <div class="t-dawn" data-light="dawn" data-tone-section="dusk" aria-hidden="true"></div>

  <section class="t-end wrap" data-light="contact" data-tone-section="day" aria-label="Next">
    <div class="t-end__text" data-tone-probe>
      <a class="btn" href={u('/contact/')}>{contact.title}</a>
      <a class="link" href={u('/research/')}>{research.title} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .t-head { min-height: 100svh; display: flex; align-items: flex-start; padding-top: 20vh; }
  .t-head__text { display: grid; gap: 20px; max-width: min(52vw, 820px); }
  .t-head__title { font-size: var(--fs-display); font-weight: 300; letter-spacing: -0.025em; }
  .t-head__intro { font-size: var(--fs-h3); font-weight: 320; line-height: 1.3; letter-spacing: -0.01em; max-width: 26em; color: var(--ink-2); }
  .t-head__index { margin-top: 10px; display: grid; border-top: 1px solid var(--rule); max-width: 30rem; }
  .t-head__index a { display: flex; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--rule); font-size: 1.02rem; transition: padding 0.4s var(--ease); }
  .t-head__n { font-variant-numeric: tabular-nums; color: var(--ink-2); }
  .t-head__index a:hover { padding-left: 6px; }

  .idea { min-height: 200vh; position: relative; }
  .idea--auto, .idea--deform { min-height: 230vh; }
  .idea__text { position: sticky; top: 0; min-height: 100vh; display: flex; }
  .idea__panel { max-width: min(38vw, 32rem); display: grid; gap: 12px; align-content: start; }
  .idea__title { font-size: 1rem; font-weight: 520; letter-spacing: 0; }
  .idea__line { font-size: var(--fs-h2); font-weight: 300; line-height: 1.12; letter-spacing: -0.018em; text-wrap: balance; margin-bottom: 6px; }
  .idea__body { font-size: 1.06rem; line-height: 1.6; color: var(--ink-2); max-width: 30em; }
  /* where the words sit, per idea */
  .idea--io .idea__text, .idea--diffuse .idea__text { align-items: flex-start; padding-top: 15vh; }
  .idea--auto .idea__text, .idea--deform .idea__text { align-items: flex-end; padding-bottom: 11vh; }
  .idea--combine .idea__text { align-items: center; }
  .idea--deform .idea__panel { max-width: min(52vw, 44rem); }
  .t-dawn { height: 80vh; }
  .t-end { min-height: 92svh; display: flex; justify-content: center; padding-top: 44svh; }
  .t-end__text { display: flex; gap: 28px; align-items: center; height: max-content; font-weight: 480; }

  @media (max-width: 759px) {
    .t-head { padding-top: 34svh; }
    .t-head__text { max-width: none; }
    /* phones: the light keeps the upper half; the words hold the lower half */
    .idea, .idea--auto, .idea--deform { min-height: 170vh; }
    .idea__text, .idea--io .idea__text, .idea--diffuse .idea__text, .idea--auto .idea__text, .idea--deform .idea__text, .idea--combine .idea__text {
      position: sticky; top: 50svh; min-height: 0; display: block; padding: 0 var(--g) 3svh;
    }
    .idea__panel, .idea--deform .idea__panel { max-width: none; gap: 8px; }
    .idea__line { font-size: 1.3rem; }
    .idea__body { font-size: 1rem; line-height: 1.5; }
    .t-dawn { height: 50vh; }
    .t-end { padding-top: 16svh; }
  }
</style>
