---
import Base from '../layouts/Base.astro';
import { ideas, thinking, research, contact } from '../config/site';
import { u } from '../lib/url';
---
<Base page="thinking" title="How we think" description={thinking.intro} tone="dusk">
  <section class="t-head wrap" data-light="hero" data-tone-section="dusk">
    <div class="t-head__text" data-tone-probe>
      <h1 class="t-head__title">{thinking.title}</h1>
      <p class="t-head__intro">{thinking.intro}</p>
      <ol class="t-head__index">
        {ideas.map((it, i) => <li><a href={`#${it.key}`}><span class="t-head__n">{String(i + 1).padStart(2, '0')}</span> {it.title}</a></li>)}
      </ol>
    </div>
  </section>

  {ideas.map((it) => (
    <section id={it.key} class={`idea idea--${it.key}`} data-light={it.key} data-tone-section="dusk" aria-labelledby={`h-${it.key}`}>
      <div class="idea__text wrap">
        <div class="idea__panel" data-tone-probe>
          <h2 id={`h-${it.key}`} class="idea__title">{it.title}</h2>
          <p class="idea__line">{it.line}</p>
          {it.body.map((b) => <p class={`idea__body${b.startsWith('[') ? ' ph' : ''}`}>{b}</p>)}
        </div>
      </div>
    </section>
  ))}

  <section class="t-end wrap" data-light="contact" data-tone-section="dusk" aria-label="Next">
    <div class="t-end__text" data-tone-probe>
      <a class="btn" href={u('/contact/')}>{contact.title}</a>
      <a class="link" href={u('/research/')}>{research.title} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .t-head { min-height: 86svh; display: flex; align-items: flex-start; padding-top: 18vh; }
  .t-head__text { display: grid; gap: 20px; max-width: min(52vw, 820px); }
  .t-head__title { font-size: var(--fs-display); font-weight: 300; letter-spacing: -0.025em; }
  .t-head__intro { font-size: var(--fs-h3); font-weight: 320; line-height: 1.3; letter-spacing: -0.01em; max-width: 26em; color: var(--ink-2); }
  .t-head__index { margin-top: 10px; display: grid; border-top: 1px solid var(--rule); max-width: 30rem; }
  .t-head__index a { display: flex; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--rule); font-size: 1.02rem; font-variant-numeric: tabular-nums; }
  .t-head__n { color: var(--ink-2); }

  /* each idea: about one and a quarter screens; the words sit where the light is not */
  .idea { min-height: 110vh; position: relative; }
  .idea__text { position: sticky; top: 0; height: 100vh; display: flex; }
  .idea__panel { max-width: min(38vw, 32rem); display: grid; gap: 12px; align-content: start; }
  .idea__title { font-size: 1rem; font-weight: 540; letter-spacing: 0; }
  .idea__line { font-size: var(--fs-h2); font-weight: 300; line-height: 1.12; letter-spacing: -0.018em; text-wrap: balance; margin-bottom: 6px; }
  .idea__body { font-size: 1.06rem; line-height: 1.6; color: var(--ink-2); max-width: 30em; }
  .idea--io .idea__text, .idea--combine .idea__text, .idea--diffuse .idea__text { align-items: flex-start; padding-top: 14vh; }
  .idea--auto .idea__text, .idea--deform .idea__text { align-items: flex-end; padding-bottom: 9vh; }
  .idea--deform .idea__panel { max-width: min(46vw, 40rem); }
  .t-end { min-height: 60svh; display: flex; justify-content: center; align-items: center; }
  .t-end__text { display: flex; gap: 28px; align-items: center; font-weight: 480; }

  @media (max-width: 759px) {
    .t-head { padding-top: 26svh; min-height: 90svh; }
    .t-head__text { max-width: none; }
    /* phones: the light keeps the upper part; the words hold the lower part */
    .idea { min-height: 125vh; }
    .idea__text, .idea--io .idea__text, .idea--combine .idea__text, .idea--diffuse .idea__text, .idea--auto .idea__text, .idea--deform .idea__text {
      position: sticky; top: 50svh; height: auto; display: block; padding: 0 var(--g) 3svh;
    }
    .idea__panel, .idea--deform .idea__panel { max-width: none; gap: 8px; }
    .idea__line { font-size: 1.3rem; }
    .idea__body { font-size: 1rem; line-height: 1.5; }
  }
</style>
