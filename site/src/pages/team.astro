---
// The team's print has one part per person, bolted to one spine. Point at a person and
// their part is the one left printed.
import Base from '../layouts/Base.astro';
import Print from '../components/Print.astro';
import { teamPrint } from '../lib/parts';
const people = [1, 2, 3, 4];
const parts = teamPrint(people.length).map((p, i) => ({ ...p, who: i >= 1 && i <= people.length ? String(i - 1) : undefined }));
---
<Base page="team" title="Team" description="[Team — meta description]">
  <section class="page">
    <header class="cover">
      <Print parts={parts} state="after" class="cover__print" pad={4} tag={(p) => (p as { who?: string }).who} />
      <h1 class="cover__title">Team</h1>
    </header>
    <div class="page__body">
      <p class="lede">[Team — one sentence introducing the people]</p>
      <ul class="people" data-people>
        {people.map((n, i) => (
          <li tabindex="0" data-who={i}>
            <Print parts={parts} state="after" class="people__print" pad={3} hl={String(i)} tag={(p) => (p as { who?: string }).who} />
            <span class="who">[Name {n}]</span>
            <span class="role">[Role]</span>
            <span class="line">[One line: background]</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <script>
    const print = document.querySelector<SVGElement>('.cover__print');
    document.querySelectorAll<HTMLElement>('[data-people] li').forEach((li) => {
      const on = () => print?.setAttribute('data-hl', li.dataset.who!);
      const off = () => print?.removeAttribute('data-hl');
      li.addEventListener('pointerenter', on); li.addEventListener('pointerleave', off);
      li.addEventListener('focus', on); li.addEventListener('blur', off);
    });
  </script>
</Base>
