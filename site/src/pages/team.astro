---
import Base from '../layouts/Base.astro';
import MiniScore from '../components/MiniScore.astro';
const people = [1, 2, 3, 4];
---
<Base page="team" title="Team" description="[Meta description]">
  <header class="page-head">
    <div class="part__side"><span class="label">{String(people.length).padStart(2, '0')}</span></div>
    <h1>Team</h1>
  </header>
  <section class="part" style="border-top: 0; padding-top: 0;">
    <div class="part__side"></div>
    <div class="part__body">
      <ul class="people">
        {people.map((n) => (
          <li>
            <span class="who">[Name]</span>
            <span class="role">[Role]</span>
            <MiniScore seed={`team-${n}`} w={420} h={40} voices={1} r={0} />
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
