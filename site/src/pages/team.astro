---
import Base from '../layouts/Base.astro';
import Face from '../components/Face.astro';
import '../styles/pages.css';
const people = [0, 1, 2, 3];
---
<Base page="team" title="Team">
  <Face kind="team" class="face--band" />
  <div class="page">
    <header class="page-head">
      <h1 class="h-page">Team</h1>
      <p class="page-head__note ph">[One line about the team]</p>
    </header>
    <ul class="team">
      {people.map((i) => (
        <li class="team__col" data-ping={i} tabindex="0">
          <span class="team__n mono">{String(i + 1).padStart(2, '0')}</span>
          <p class="team__name ph">[Name]</p>
          <p class="team__role mono ph">[Role]</p>
          <p class="team__line ph">[One line — background]</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
<script>
  import '../scripts/faces';
</script>
