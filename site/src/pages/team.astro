---
import Base from '../layouts/Base.astro';
import Pebble from '../components/Pebble.astro';
const people = Array.from({ length: 4 }, () => ({ name: '[Name]', role: '[Role]' }));
// one stone per person, in a loose group; hovering a person warms their stone
const stones = [
  { x: 0.2, y: -0.06, r: 0.12 }, { x: 0.33, y: 0.1, r: 0.1 }, { x: 0.42, y: -0.12, r: 0.09 }, { x: 0.26, y: 0.24, r: 0.07 },
];
const mstones = [{ x: -0.24, y: -0.3, r: 0.1 }, { x: 0.0, y: -0.24, r: 0.09 }, { x: 0.22, y: -0.32, r: 0.08 }, { x: 0.34, y: -0.16, r: 0.06 }];
---
<Base page="team" title="Team">
  <section class="page-band page-band--left band" data-band={JSON.stringify({ stones, mstones, clear: '[data-clear]', hover: '[data-person]' })}>
    <div class="wrap page-band__in"><h1 data-clear>Team</h1></div>
    <div class="band__edge"></div>
  </section>
  <section class="page-body wrap">
    <div class="cols" data-reveal>
      <p class="label">Team</p>
      <p class="lead ph">[Team — one sentence]</p>
    </div>
    <div class="cols" data-reveal>
      <p class="label">People</p>
      <ul class="people">
        {people.map((p, i) => (
          <li class="person" tabindex="0" data-person>
            <Pebble size={44} seed={i + 30} />
            <span class="person__name">{p.name}</span>
            <span class="person__role">{p.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
