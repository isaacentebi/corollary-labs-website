---
// Team: placeholders until names, roles and portraits are chosen.
import Base from '../layouts/Base.astro';
import { site, url } from '../config/site';
import '../styles/pages.css';

const people = Array.from({ length: 4 }, (_, i) => ({ n: String(i + 1).padStart(2, '0'), name: '[Name]', role: '[Role]', line: '[Placeholder — one line on their work.]' }));
---
<Base page="team" title="Team" description={`The team at ${site.name}.`}>
  <section class="page">
    <p class="page__kick mono reveal"><b>03</b><span>Team</span><span>{String(people.length).padStart(2, '0')} rows</span></p>
    <h1 class="page__title reveal">Team</h1>
    <p class="page__lede reveal"><span class="ph">[Placeholder — one sentence on who works at {site.name}.]</span></p>

    <table class="tb tm">
      <thead class="mono"><tr><th>No.</th><th>Name</th><th>Role</th><th class="-hide-s">Work</th></tr></thead>
      <tbody>
        {people.map((p) => (
          <tr class="reveal">
            <td class="mono">{p.n}</td>
            <td class="tm__name ph">{p.name}</td>
            <td class="mono ph">{p.role}</td>
            <td class="ph -hide-s">{p.line}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <table class="tb colo reveal">
      <caption class="mono"><b>Joining</b></caption>
      <tbody>
        <tr><td class="mono" style="width:30%;color:var(--i3)">Work here</td><td class="ph">[Placeholder — how to get in touch about working here.]</td></tr>
        <tr><td class="mono" style="color:var(--i3)">Contact</td><td><a class="link" href={url('contact/')}>Contact page</a></td></tr>
      </tbody>
    </table>
  </section>
</Base>
