---
import Base from '../layouts/Base.astro';
import Emblem from '../components/Emblem.astro';
const people = [1, 2, 3, 4];
---
<Base page="team" title="Team">
  <header class="phead">
    <h1 class="phead__t cut">Team</h1>
    <p class="phead__d cut ph">[Team — one sentence]</p>
  </header>
  <ul class="people">
    {people.map((n) => (
      <li class="person cut">
        <Emblem seed={`person-${n}`} n={3} class="person__mark" />
        <p class="person__name ph">[Name]</p>
        <p class="person__role mono ph">[Role]</p>
        <p class="person__bio ph">[Bio — two sentences]</p>
      </li>
    ))}
  </ul>
</Base>
