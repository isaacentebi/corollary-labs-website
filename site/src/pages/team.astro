---
import Base from '../layouts/Base.astro';
import Woven from '../components/Woven.astro';
import Drawdown from '../components/Drawdown.astro';
import '../styles/pages.css';
const people = [1, 2, 3, 4];
---
<Base title="Team" page="team">
  <div class="title" style="--tw: 360px"><h1>Team</h1><Woven text="Team" /></div>
  <section class="wrap">
    <ul class="people">
      {people.map((n) => (
        <li>
          <div class="people__sw"><Drawdown cols={20} rows={21} axis={3 + n * 3} cy={4 + n * 3} radius={9 + n * 2} seed={'p' + n} /></div>
          <p class="people__name ph">[Name]</p>
          <p class="mono ph">[Role]</p>
          <p class="people__bio ph">[Bio — two lines]</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
