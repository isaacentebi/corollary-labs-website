---
import Base from '../layouts/Base.astro';
const people = Array.from({ length: 4 }, () => ({ name: '[Name]', role: '[Role]' }));
// one stone per person inside one contour; pick a stone up and the contour stretches with it and settles
const stones = [
  { x: 0.18, y: -0.02, r: 0.13, sq: 0.1 }, { x: 0.3, y: 0.12, r: 0.075, tone: 1, gloss: 0.85 },
  { x: 0.36, y: -0.1, r: 0.15, sq: 0.62, a: 1.32 }, { x: 0.25, y: 0.26, r: 0.05, gloss: 0.4 },
];
const mstones = [{ x: -0.2, y: -0.14, r: 0.09 }, { x: 0.0, y: -0.1, r: 0.055 }, { x: 0.2, y: -0.16, r: 0.1 }, { x: 0.33, y: -0.04, r: 0.04 }];
---
<Base page="team" title="Team">
  <section class="page-band page-band--left band" data-band={JSON.stringify({ stones, mstones, group: true, drag: true, clear: '[data-clear]', hover: '[data-person]' })}>
    <div class="wrap page-band__in"><h1 data-clear>Team</h1></div>
    <div class="band__edge"></div>
  </section>
  <section class="page-body wrap">
    <div class="cols" data-reveal>
      <p class="label">Team</p>
      <p class="lead ph">[Team — one sentence]</p>
    </div>
    <div class="cols" data-reveal>
      <p class="label">People</p>
      <ul class="people">
        {people.map((p, i) => (
          <li class="person" tabindex="0" data-person>
            <span class="row__n mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="person__name">{p.name}</span>
            <span class="person__role">{p.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
