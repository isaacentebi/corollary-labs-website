---
import Sheet from '../layouts/Sheet.astro';
import Band from '../components/Band.astro';
import TeamList from '../components/TeamList.astro';
import { url } from '../config/site';
---
<Sheet active="company" page="team" title="Team">
  <Band lines={['Team']} state="four" fit={3.15} />
  <section class="page">
    <TeamList bios />
    <p class="page__next"><a class="more" href={url('about/')}>About the company →</a></p>
  </section>
</Sheet>
