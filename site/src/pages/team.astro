---
// Team — a list of people. Placeholders until names are chosen.
import Base from '../layouts/Base.astro';
import { site, u } from '../config/site';
import '../styles/pages.css';

const people = [1, 2, 3, 4].map((n) => ({ n, name: '[Name]', role: '[Role]' }));
---
<Base page="team" title="Team" description={`Team — ${site.name}`}>
  <article class="page">
    <h1 class="page__title">Team</h1>
    <div class="rule"></div>
    <section class="fmblock -first" aria-label="People">
      {people.map((p) => (
        <div class="fm"><div class="fm__k ph">{p.role}</div><div class="fm__v ph">{p.name}</div></div>
      ))}
    </section>
    <section class="fmblock" aria-label="Jobs">
      <div class="fm"><div class="fm__k">Jobs</div><div class="fm__v ph">[Jobs]</div></div>
      <div class="fm"><div class="fm__k">Contact</div><div class="fm__v"><a href={u('contact/')}>Contact</a></div></div>
    </section>
  </article>
</Base>
