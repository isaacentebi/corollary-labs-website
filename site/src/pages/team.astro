---
// Team: one column per person. Placeholders until names are chosen.
// Below 600px each person's column stacks under the previous one.
import Base from '../layouts/Base.astro';
import { site, url } from '../config/site';
import '../styles/pages.css';

const people = Array.from({ length: 4 }, (_, i) => ({ n: String(i + 1).padStart(2, '0') }));
const rows = [
  { k: 'Name', cls: '-name', ph: '[Name]' },
  { k: 'Role', cls: '-role', ph: '[Role]' },
  { k: 'Work', cls: '-work', ph: '[Work — one line]' },
];
---
<Base page="team" title="Team" >
  <section class="page">
    <header class="ph-row reveal">
      <p class="ph-row__n mono">03</p>
      <h1 class="ph-row__t">Team</h1>
    </header>
    <p class="page__lede ph reveal">[Team — one sentence]</p>

    <div class="tg reveal" role="table" aria-label="Team" style={`--n:${people.length}`}>
      <div class="tg__keys mono" aria-hidden="true">
        <span class="tg__h"></span>
        {rows.map((r) => <span class:list={['tg__k', r.cls]}>{r.k}</span>)}
      </div>
      {people.map((p) => (
        <div class="tg__col" role="rowgroup">
          <span class="tg__h mono" role="columnheader">{p.n}</span>
          {rows.map((r) => (
            <span class:list={['tg__c', r.cls]} role="cell">
              <em class="mono">{r.k}</em><span class="nyw mono">{r.ph}</span>
            </span>
          ))}
        </div>
      ))}
    </div>

    <div class="cc cc--short reveal" role="table" aria-label="Jobs">
      <div class="cc__row" role="row"><span class="cc__k mono" role="rowheader">Jobs</span><span class="cc__cell -ph" role="cell"><span class="nyw mono">[Jobs — one line]</span></span></div>
      <div class="cc__row" role="row"><span class="cc__k mono" role="rowheader">Contact</span><span class="cc__cell -fact" role="cell"><a href={url('contact/')}>Contact</a></span></div>
    </div>
  </section>
</Base>
