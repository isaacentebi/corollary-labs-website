---
import Base from '../layouts/Base.astro';
const people = Array.from({ length: 4 }, (_, i) => i + 1);
---
<Base page="team" title="Team">
  <section class="page wrap">
    <header class="phead">
      <h1 class="phead__title">Team</h1>
    </header>
    <p class="lede ph intro">[Team — one sentence]</p>
    <ul class="team">
      {people.map((n) => (
        <li data-reveal>
          <span class="mono team__n">{String(n).padStart(2, '0')}</span>
          <span class="team__name ph">[Name]</span>
          <span class="team__role ph">[Role]</span>
          <span class="team__bio ph">[Short biography — two lines]</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
