---
import Base from '../layouts/Base.astro';
const people = Array.from({ length: 4 }, () => ({ name: '[Name]', role: '[Role]' }));
// one stone per person, centred, inside one contour; hover a person (or a stone) and their name appears beside it;
// pick a stone up and the contour stretches with it and settles
const stones = [
  { x: -0.07, y: -0.08, r: 0.13, sq: 0.1 }, { x: 0.06, y: 0.04, r: 0.075, tone: 1, gloss: 0.85 },
  { x: 0.13, y: -0.14, r: 0.15, sq: 0.62, a: 1.32 }, { x: -0.02, y: 0.14, r: 0.05, gloss: 0.4 },
];
const mstones = [{ x: -0.18, y: -0.14, r: 0.11 }, { x: 0.06, y: -0.04, r: 0.07 }, { x: 0.24, y: -0.2, r: 0.12 }, { x: -0.04, y: 0.08, r: 0.05 }];
---
<Base page="team" title="Team">
  <section class="page-band page-band--team band" data-band={JSON.stringify({ stones, mstones, group: true, drag: true, clear: '[data-clear]', hover: '[data-person]', labels: '[data-label]' })}>
    {people.map((p) => <span class="stone-label ph" data-label aria-hidden="true">{p.name}</span>)}
    <div class="wrap page-band__in"><h1 data-clear>Team</h1></div>
    <div class="band__edge"></div>
  </section>
  <section class="page-body wrap">
    <div class="cols" data-reveal>
      <p class="label">Team</p>
      <p class="lead ph">[Team — one sentence]</p>
    </div>
    <div class="cols" data-reveal>
      <p class="label">People</p>
      <ul class="people">
        {people.map((p, i) => (
          <li class="person" tabindex="0" data-person>
            <span class="row__n mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="person__name">{p.name}</span>
            <span class="person__role">{p.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
