---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import '../styles/pages.css';
const people = Array.from({ length: 4 }, (_, i) => String(i + 1).padStart(2, '0'));
---
<Base page="team" title="Team">
  <header class="phead grid">
    <PageTitle text="Team" />
    <p class="phead__lead lead ph">[Team — one sentence]</p>
  </header>
  <section class="section grid" aria-labelledby="t1">
    <h2 class="section__label label" id="t1">People</h2>
    <ol class="people">
      {people.map((n) => (
        <li class="person">
          <span class="person__n label">{n}</span>
          <span class="person__name ph">[Name]</span>
          <span class="person__role label ph">[Role]</span>
          <span class="person__line ph">[One line on their work]</span>
        </li>
      ))}
    </ol>
  </section>
</Base>
