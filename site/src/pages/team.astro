---
import Base from '../layouts/Base.astro';
import Glyph from '../components/Glyph.astro';
import '../styles/pages.css';
const people = [1, 2, 3, 4];
---
<Base page="team" title="Team">
  <section class="page">
    <header class="page__head">
      <h1 class="display">Team</h1>
    </header>
    <ol class="team">
      {people.map((n) => (
        <li class="person" data-glyph-host tabindex="0">
          <Glyph seed={`person-${n}`} class="person__g" />
          <span class="t-label person__n">0{n}</span>
          <p class="person__name">[Name]</p>
          <p class="person__role t-label ph">[Role]</p>
          <p class="person__bio ph">[One or two lines — background]</p>
        </li>
      ))}
    </ol>
  </section>
</Base>
