---
import Base from '../layouts/Base.astro';
import { u } from '../config/site';
const stones = [{ x: 0.24, y: 0.16, r: 0.09, tone: 1, gloss: 0.85 }];
const mstones = [{ x: 0.2, y: 0.3, r: 0.1 }];
---
<Base page="404" title="404" footer={false}>
  <section class="contact-band band" data-band={JSON.stringify({ stones, mstones, drag: true, clear: '[data-clear]' })}>
    <div class="contact-band__in" data-clear>
      <h1>404</h1>
      <a class="more" href={u('/')}>Home</a>
    </div>
  </section>
</Base>
