---
import Sheet from '../layouts/Sheet.astro';
import Band from '../components/Band.astro';
import { regions, url } from '../config/site';
---
<Sheet active={null} page="lost" title="Not found">
  <Band lines={['404']} state="lost" fit={2.0} />
  <section class="page">
    <ul class="lost-links">
      {regions.map((r) => <li><a href={r.href}>{r.key === 'home' ? 'Home' : r.label}</a></li>)}
      <li><a href={url('essays/')}>Research</a></li>
    </ul>
  </section>
</Sheet>
