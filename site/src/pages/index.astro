---
// Home: the company, read as a set of tables. The hero states the company beside the live input–output table;
// Approach replays the table's story in four beats; everything else is set in the same table grammar.
import Base from '../layouts/Base.astro';
import { site, hero, capabilities, approach, research, company, contact, url } from '../config/site';
import { getCollection, render } from 'astro:content';
import { SUPPLIED } from '../scripts/economy';
import '../styles/home.css';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const latest = await Promise.all(essays.slice(0, 3).map(async (e) => ({ e, fm: (await render(e)).remarkPluginFrontmatter })));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
const pad = (n: number) => String(n).padStart(2, '0');
const ids = Array.from({ length: 32 }, (_, i) => i);
const short = ['Exec.', 'Plans', 'Obj.'];
---
<Base page="home">
  <!-- Hero: the company, and the table it works on (hover reads a cell; a click traces its suppliers) -->
  <section class="hr" data-hero aria-labelledby="hr-name">
    <div class="hr__stage" data-hstage>
      <canvas class="hr__gl" data-gl aria-hidden="true"></canvas>
      <div class="hr__labels mono" aria-hidden="true">
        <span class="st__title" data-title>Table 1 · 32 firms<span class="-full"> · input coefficients</span></span>
        <span class="st__axis -buyer" data-buyer>Buyer →</span>
        <span class="st__axis -supplier" data-supplier><span class="-w">Supplier</span><span>↓</span></span>
        {ids.map((s) => <span class="st__id -c" data-cl={s}>{pad(s + 1)}</span>)}
        {ids.map((s) => <span class="st__id -r" data-rl={s}>{pad(s + 1)}</span>)}
      </div>
      <div class="st__tip mono" data-tip aria-hidden="true"></div>
    </div>
    <div class="hr__copy" data-hcopy>
      <h1 id="hr-name" class="hr__name"><span>Corollary</span> <span>Labs</span></h1>
      <p class="hr__head">{hero.headline}</p>
      <p class="hr__sub">{hero.subline}</p>
      <div class="hr__act">
        <a class="btn -p" href={site.contactHref}>Contact us</a>
        <a class="btn" href="#approach">Our approach <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <!-- 01 Capabilities -->
  <section id="capabilities" class="sec" aria-labelledby="cap-t">
    <header class="sec__h reveal">
      <p class="sec__n mono">01</p>
      <h2 id="cap-t" class="sec__t">Capabilities</h2>
    </header>
    <table class="tb cap">
      <thead class="mono"><tr><th class="num">No.</th><th>Capability</th><th class="-hide-s"></th></tr></thead>
      <tbody>
        {capabilities.map((c, i) => (
          <tr class="reveal">
            <td class="num mono cap__n">{pad(i + 1)}</td>
            <td class="cap__t"><span>{c.t}.</span><span class="cap__d -show-s">{c.d}</span></td>
            <td class="cap__d -hide-s">{c.d}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- 02 Approach: the table's story, in four beats -->
  <section id="approach" class="sec -ap" aria-labelledby="ap-t">
    <header class="sec__h reveal">
      <p class="sec__n mono">02</p>
      <h2 id="ap-t" class="sec__t">Approach</h2>
    </header>
    <p class="sec__lede reveal">{approach.intro}</p>
  </section>
  <div class="st" data-story role="figure" aria-label="The table in four beats: the organisation, an agent enters, it reorganises, the change spreads">
    <div class="st__stage" data-stage>
      <canvas class="st__gl" data-gl aria-hidden="true"></canvas>

      <div class="st__labels mono" data-labels aria-hidden="true">
        <span class="st__title" data-title>Table 1 · 32 firms<span class="-full"> · input coefficients</span></span>
        <span class="st__axis -buyer" data-buyer>Buyer →</span>
        <span class="st__axis -supplier" data-supplier><span class="-w">Supplier</span><span>↓</span></span>
        {ids.map((s) => <span class="st__id -c" data-cl={s}>{pad(s + 1)}</span>)}
        {ids.map((s) => <span class="st__id -r" data-rl={s}>{pad(s + 1)}</span>)}
        {SUPPLIED.map((s, k) => <span class="st__row" data-row={k}><span class="-full">{s}</span><span class="-short">{short[k]}</span></span>)}
        <span class="st__row -agent" data-row="a">Agent</span>
        <span class="st__rule" data-rule></span>
        <span class="st__rounds" data-rounds></span>
      </div>
      <div class="st__nums mono" data-nums aria-hidden="true"></div>
      <span class="st__sum mono" data-sum aria-hidden="true">Sum 1.000</span>
      <span class="st__chip mono" data-chip aria-hidden="true"></span>
      <div class="st__tip mono" data-tip aria-hidden="true"></div>

      <ol class="st__beats" data-beats aria-label="Approach">
        <li class="st__bh mono" aria-hidden="true"><span>02</span>Approach</li>
        {approach.beats.map((b, i) => (
          <li><button type="button" data-goto={i}><span class="st__bn mono">{pad(i + 1)}</span><span class="st__bt">{b}</span><i class="st__bp" data-bp={i}></i></button></li>
        ))}
      </ol>
    </div>
  </div>
  <section class="sec -pr" aria-label="Principles">
    <table class="tb pr">
      <thead class="mono"><tr><th class="num">No.</th><th>Principle</th><th class="-hide-s"></th></tr></thead>
      <tbody>
        {approach.principles.map((p, i) => (
          <tr class="reveal">
            <td class="num mono cap__n">{pad(i + 1)}</td>
            <td class="cap__t"><span>{p.t}.</span><span class="cap__d -show-s">{p.d}</span></td>
            <td class="cap__d -hide-s">{p.d}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- Research -->
  <section id="research" class="sec" aria-labelledby="re-t">
    <header class="sec__h reveal">
      <p class="sec__n mono">—</p>
      <h2 id="re-t" class="sec__t">Research</h2>
    </header>
    <p class="sec__lede reveal">{research.intro}</p>
    <table class="tb re">
      <thead class="mono"><tr><th class="num">No.</th><th>Title</th><th class="-hide-s">Date</th><th class="num">Min.</th></tr></thead>
      <tbody>
        {latest.map(({ e, fm }, i) => (
          <tr class="reveal">
            <td class="num mono cap__n">{pad(essays.length - i)}</td>
            <td><a class="re__a" href={url(`essays/${e.id}/`)}><span class="re__t">{e.data.title}</span><span class="re__d">{e.data.dek}</span></a></td>
            <td class="mono -hide-s re__m"><time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time></td>
            <td class="num mono re__m">{pad(fm.minutesRead)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="sec__more reveal"><a class="mono link" href={url('essays/')}>All research →</a></p>
  </section>

  <!-- 03 Company -->
  <section id="company" class="sec" aria-labelledby="co-t">
    <header class="sec__h reveal">
      <p class="sec__n mono">03</p>
      <h2 id="co-t" class="sec__t">Company</h2>
    </header>
    <div class="co">
      <div class="co__row reveal">
        <h3 class="co__k mono">About</h3>
        <p class="co__about">{company.about} <span class="ph">{company.aboutPh}</span></p>
      </div>
      <div class="co__row reveal">
        <h3 class="co__k mono">Team</h3>
        <ul class="co__team">
          {company.team.map((p, i) => (
            <li class="co__cell"><span class="mono co__cn">{pad(i + 1)}</span><span class="ph">{p.name} — {p.role}</span></li>
          ))}
        </ul>
      </div>
      <p class="sec__more reveal"><a class="mono link" href={url('about/')}>About the company →</a></p>
    </div>
  </section>

  <!-- 04 Contact -->
  <section id="contact" class="sec -ct" aria-labelledby="ct-t">
    <header class="sec__h reveal">
      <p class="sec__n mono">04</p>
      <h2 id="ct-t" class="sec__t">Contact</h2>
    </header>
    <div class="ct reveal">
      <p class="ct__line">{contact.line}</p>
      <p class="ct__cell"><span class="mono ct__k">Email</span><span class="ct__v">{site.email}</span></p>
    </div>
  </section>

  <script>
    import { initHero } from '../scripts/hero';
    import { initStory } from '../scripts/story';
    initHero();
    initStory();
  </script>
</Base>
