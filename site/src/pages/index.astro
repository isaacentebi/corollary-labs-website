---
// Home: one drawing that changes in three states over about three screens of scroll (the firm → it reorganises
// around an agent → the change spreads), then the business content: about, latest essays, links.
import Base from '../layouts/Base.astro';
import { figs, site, u } from '../config/site';
import { getCollection } from 'astro:content';
import '../styles/home.css';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base page="home">
  <section class="home" data-home aria-labelledby="home-title">
    <div class="stage" data-stage>
      <canvas class="stage__canvas" data-specimen role="img"
        aria-label={`Figures 1 to ${figs.length}: ${figs.map((f, i) => `${i + 1}, ${f.title}`).join('; ')}`}></canvas>
      <div class="legends">
        {figs.map((f, i) => (
          <div class:list={['legend', { '-last': i === figs.length - 1 }]} data-legend data-s0={f.s[0]} data-s1={f.s[1]}>
            <p class="legend__n">Fig. {i + 1} / {figs.length}</p>
            <h2 class="legend__title t-title">{f.title}</h2>
            <p class="legend__text ph">{f.legend}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="flow">
      <header class="hero" data-hero>
        <h1 class="hero__name t-display" id="home-title"><span>Corollary</span> <span>Labs</span></h1>
        <p class="hero__statement"><span class="ph">[Statement]</span></p>
        <p class="hero__cue t-label" aria-hidden="true"><span class="hero__cue-dot"></span>Scroll</p>
      </header>
      <div class="run" aria-hidden="true"></div>
    </div>
  </section>

  <section class="after" aria-label="About and essays">
    <div class="after__about">
      <p class="t-label">About</p>
      <p class="after__text ph">[About — one paragraph]</p>
      <a class="after__more link-u" href={u('about/')}>About →</a>
      <p class="after__contact"><span class="t-label">Contact</span><a class="link-u" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div class="after__essays">
      <p class="t-label">Essays</p>
      <ol>
        {essays.map((e) => (
          <li><a href={u(`essays/${e.id}/`)}><span class="after__etitle">{e.data.title}</span><time class="t-label" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time></a></li>
        ))}
      </ol>
      <a class="after__more link-u" href={u('essays/')}>All essays →</a>
    </div>
  </section>
  <script>
    import { initHome } from '../scripts/home';
    initHome();
  </script>
</Base>
