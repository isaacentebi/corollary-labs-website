---
// Home, as a company: the name and what we do over the living cell (hero), capabilities, the approach
// (the one drawing told in four beats), research, company, contact.
import Base from '../layouts/Base.astro';
import Mail from '../components/Mail.astro';
import { beats, capabilities, contactHref, principles, site, team, u } from '../config/site';
import { getCollection } from 'astro:content';
import { slideSVG } from '../lib/slides';
import { blob, hash } from '../lib/blob';
import '../styles/pages.css';
import '../styles/home.css';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const latest = essays.slice(0, 3).map((e) => ({ e, svg: slideSVG(e.id, essays.indexOf(e) % 3) }));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const keys = ['a', 'b', 'c', 'd'];
const cell = (k: string) => blob(hash(`cap-${k}`), 20, 20, 17, 0.05);
---
<Base page="home">
  <section class="hero" data-hero aria-labelledby="hero-title">
    <canvas class="hero__canvas" data-specimen role="img" aria-label={`${beats[0].n} ${beats[0].title}`}></canvas>
    <div class="hero__copy">
      <h1 class="hero__name t-display" id="hero-title">{site.name}</h1>
      <p class="hero__head">We deploy AI agents inside organisations and rebuild the operations around them.</p>
      <p class="hero__sub">Agent design, model fine-tuning, systems integration and evaluation, from first workflow to production.</p>
      <div class="hero__actions">
        <a class="btn -primary" href={contactHref}>Contact us</a>
        <a class="btn -quiet" href="#approach">Our approach</a>
      </div>
    </div>
  </section>

  <section class="sec cap" id="capabilities" aria-labelledby="cap-title">
    <h2 class="sec__title t-title" id="cap-title" data-reveal>Capabilities</h2>
    <ol class="cap__list">
      {capabilities.map((c, i) => (
        <li class="cap__item" data-reveal style={`--rd:${i * 0.08}s`}>
          <span class="cap__key" aria-hidden="true"><svg viewBox="0 0 40 40"><path d={cell(keys[i])} /></svg><i>{keys[i]}</i></span>
          <h3 class="cap__title t-title">{c.title}.</h3>
          <p class="cap__text">{c.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec appr" id="approach" aria-labelledby="appr-title">
    <div class="appr__grid">
      <div class="appr__text">
        <h2 class="sec__title t-title" id="appr-title" data-reveal>Approach</h2>
        <p class="appr__intro" data-reveal>We start from the workflow: its inputs, its outputs and the decisions made inside it. We then design the organisation that works with the agents, not only the agents.</p>
      </div>
      <ol class="beats" data-beats aria-label="Approach, in four steps">
        {beats.map((b, i) => (
          <li><button type="button" class="beat" data-beat={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="appr-fig"><span class="beat__n">{b.n}</span><span class="beat__t">{b.title}</span></button></li>
        ))}
      </ol>
      <figure class="appr__fig" id="appr-fig">
        <canvas data-approach role="img" aria-label={`${beats[0].n} ${beats[0].title}`}></canvas>
      </figure>
    </div>
    <ol class="principles">
      {principles.map((p, i) => (
        <li data-reveal style={`--rd:${i * 0.08}s`}>
          <span class="principles__n">{i + 1}</span>
          <h3 class="principles__title t-title">{p.title}.</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec res" id="research" aria-labelledby="res-title">
    <div class="res__head">
      <h2 class="sec__title t-title" id="res-title" data-reveal>Research</h2>
      <p class="res__intro" data-reveal>Essays on agents, organisations and how new technology spreads.</p>
    </div>
    <ol class="res__list">
      {latest.map(({ e, svg }, i) => (
        <li data-reveal style={`--rd:${i * 0.08}s`}>
          <a class="slide" href={u(`essays/${e.id}/`)}>
            <svg class="slide__svg" viewBox="0 0 200 200" aria-hidden="true" set:html={svg} />
            <span class="res__title t-title">{e.data.title}</span>
            <time class="t-label" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
          </a>
        </li>
      ))}
    </ol>
    <a class="more link-u" href={u('essays/')}>All research →</a>
  </section>

  <section class="sec co" id="company" aria-labelledby="co-title">
    <h2 class="sec__title t-title" id="co-title" data-reveal>Company</h2>
    <div class="co__grid">
      <div class="co__about" data-reveal>
        <p class="t-label">About</p>
        <p class="co__text">Corollary Labs is an AI company. <span class="ph">[About — founding story and team, one paragraph]</span></p>
      </div>
      <div class="co__team" data-reveal style="--rd:0.1s">
        <p class="t-label">Team</p>
        <ul>
          {team.map((p) => <li class="ph"><span class="co__name">{p.name}</span><span class="co__role">{p.role}</span></li>)}
        </ul>
        <a class="more link-u" href={u('about/')}>About the company →</a>
      </div>
    </div>
  </section>

  <section class="sec reach" id="contact" aria-labelledby="reach-title">
    <h2 class="sec__title t-title" id="reach-title" data-reveal>Contact</h2>
    <p class="reach__line" data-reveal>Deploying agents in your organisation? Talk to us.</p>
    <p class="reach__mail" data-reveal style="--rd:0.1s"><Mail /></p>
  </section>

  <script>
    import { initHome } from '../scripts/home';
    initHome();
  </script>
</Base>
