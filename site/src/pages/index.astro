---
// Home — a company page in the Proof design language: the live string-diagram plate under the hero, then
// Capabilities, Approach (one interactive figure), Research, Company and Contact.
// Copy is the temporary company copy from IA-BRIEF.md; anything not yet known stays a [bracketed] placeholder.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site, u } from '../config/site';
import '../styles/home.css';

const placeholderEmail = site.email.startsWith('[');
const contactHref = placeholderEmail ? '#contact' : `mailto:${site.email}`;

const capabilities = [
  { t: 'Agent deployment', d: 'Agents that execute defined workflows inside existing systems, with permissions, logging and human review.' },
  { t: 'Model fine-tuning', d: 'Models adapted and evaluated on your data for the specific tasks your agents perform.' },
  { t: 'Systems integration', d: 'Connections to the systems where work already happens: ERP, CRM, data warehouses and internal tools.' },
  { t: 'Evaluation and governance', d: 'Continuous measurement of accuracy, cost and risk, with an audit trail for every action an agent takes.' },
];
// one small string diagram per capability, drawn on the section's running wire (y = 24 in a 120 × 48 box)
const glyphs = [
  // an agent (solid box) on the wire
  `<rect class="g-s" x="46" y="12" width="22" height="24"/>`,
  // the agent takes a second input: the model, adapted (blue)
  `<path class="g-w g-b" d="M14 6 H28 C38 6 38 18 46 18"/><rect class="g-s" x="46" y="12" width="22" height="24"/>`,
  // the wire joins existing systems (open boxes) on either side
  `<rect class="g-o" x="14" y="14" width="18" height="20"/><rect class="g-s" x="52" y="12" width="22" height="24"/><rect class="g-o" x="92" y="14" width="18" height="20"/>`,
  // every action is observed: a copy of the wire goes to a record (blue)
  `<rect class="g-s" x="30" y="12" width="22" height="24"/><circle class="g-d" cx="78" cy="24" r="3.4"/><path class="g-w g-b" d="M78 24 C86 24 86 42 96 42 H106"/><rect class="g-bx" x="106" y="36" width="12" height="12"/>`,
];

const principles = [
  { t: 'Workflow first.', d: 'We map how work is actually done before choosing a model.' },
  { t: 'Design the reorganisation.', d: 'Roles, handoffs and controls change when agents arrive. We plan that change.' },
  { t: 'Measure in production.', d: 'Every deployment reports on accuracy, cost and time saved.' },
];
const beats = ['The organisation', 'An agent enters', 'It reorganises', 'The change spreads'];

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const team = [1, 2, 3, 4];
---
<Base page="home">
  <!-- Hero: the company over the live plate ─────────────────────── -->
  <header class="plate0" data-hero>
    <canvas class="plate0__field" data-field aria-hidden="true"></canvas>
    <div class="plate0__text">
      <h1 class="plate0__title">Corollary Labs</h1>
      <p class="plate0__head">We deploy AI agents inside organisations and rebuild the operations around them.</p>
      <p class="plate0__sub">Agent design, model fine-tuning, systems integration and evaluation, from first workflow to production.</p>
      <p class="plate0__act">
        <a class="btn" href={contactHref}>Contact us</a>
        <a class="btn -line" href="#approach">Our approach</a>
      </p>
    </div>
  </header>

  <!-- 1 Capabilities ────────────────────────────────────────────── -->
  <section class="blk" id="capabilities" aria-labelledby="h-cap">
    <h2 class="blk__h" id="h-cap"><span class="blk__n">1</span>Capabilities</h2>
    <ol class="caps">
      {capabilities.map((c, i) => (
        <li class="cap">
          <span class="cap__gw"><svg class="cap__g" viewBox="0 0 120 48" width="120" height="48" aria-hidden="true" set:html={glyphs[i]} /></span>
          <h3 class="cap__t">{c.t}</h3>
          <p class="cap__d">{c.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 2 Approach: one interactive figure ────────────────────────── -->
  <section class="blk ap" id="approach" data-ap aria-labelledby="h-ap">
    <div class="blk__head">
      <h2 class="blk__h" id="h-ap"><span class="blk__n">2</span>Approach</h2>
      <p class="blk__intro">We start from the workflow: its inputs, its outputs and the decisions made inside it. We then design the organisation that works with the agents, not only the agents.</p>
    </div>
    <div class="ap__fig">
      <ol class="ap__beats" aria-label="Figure steps">
        {beats.map((b, i) => (
          <li><button type="button" class="ap__beat" data-beat={i} aria-pressed={i === 0 ? 'true' : 'false'}><span class="ap__n">0{i + 1}</span><span class="ap__bt">{b}</span></button></li>
        ))}
      </ol>
      <figure class="ap__stage">
        <div class="ap__box">
          <svg class="dg" data-dg viewBox="-50 0 850 460" role="img" aria-label="Diagram of an organisation's workflow"></svg>
          <svg class="eco" data-eco viewBox="0 0 1000 560" role="img" aria-label="Diagram of many organisations and the connections between them"></svg>
        </div>
        <figcaption class="legend" aria-label="Key">
          <span><svg viewBox="0 0 22 16" aria-hidden="true"><rect x="2" y="2" width="18" height="12" class="lg-open" /></svg>people</span>
          <span><svg viewBox="0 0 22 16" aria-hidden="true"><rect x="2" y="2" width="18" height="12" class="lg-solid" /></svg>agent</span>
          <span><svg viewBox="0 0 22 16" aria-hidden="true"><rect x="2" y="2" width="18" height="12" class="lg-bnd" /></svg>boundary</span>
          <span><svg viewBox="0 0 22 16" aria-hidden="true"><path d="M1 8 H21" class="lg-blue" /></svg>changed</span>
        </figcaption>
      </figure>
    </div>
    <ol class="prin">
      {principles.map((p, i) => (
        <li class="prin__i"><span class="prin__n">{i + 1}</span><p><span class="prin__t">{p.t}</span> {p.d}</p></li>
      ))}
    </ol>
  </section>

  <!-- 3 Research ─────────────────────────────────────────────────── -->
  <section class="blk" id="research" aria-labelledby="h-rs">
    <div class="blk__head">
      <h2 class="blk__h" id="h-rs"><span class="blk__n">3</span>Research</h2>
      <p class="blk__intro">Essays on agents, organisations and how new technology spreads.</p>
    </div>
    <ol class="rs">
      {essays.map((e) => (
        <li>
          <a class="rs__row" href={u(`essays/${e.id}/`)}>
            <time class="rs__date" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
            <span class="rs__main"><span class="rs__t">{e.data.title}</span><span class="rs__d">{e.data.dek}</span></span>
          </a>
        </li>
      ))}
    </ol>
    <p class="more"><a href={u('essays/')}>All research →</a></p>
  </section>

  <!-- 4 Company ──────────────────────────────────────────────────── -->
  <section class="blk" id="company" aria-labelledby="h-co">
    <h2 class="blk__h" id="h-co"><span class="blk__n">4</span>Company</h2>
    <div class="co">
      <div class="co__about">
        <h3 class="co__k">About</h3>
        <p class="co__p">Corollary Labs is an AI company. <span class="ph">[About — founding story and team, one paragraph]</span></p>
      </div>
      <div class="co__team">
        <h3 class="co__k">Team</h3>
        <ul class="co__list">
          {team.map(() => <li class="ph">[Name — Role]</li>)}
        </ul>
        <p class="more"><a href={u('about/')}>About the company →</a></p>
      </div>
    </div>
  </section>

  <!-- 5 Contact: the inverted plate ─────────────────────────────── -->
  <section class="blk ct" id="contact" aria-labelledby="h-ct">
    <h2 class="blk__h" id="h-ct"><span class="blk__n">5</span>Contact</h2>
    <p class="ct__line">Deploying agents in your organisation? Talk to us.</p>
    <p class="ct__mail">{placeholderEmail ? <span>{site.email}</span> : <a href={`mailto:${site.email}`}>{site.email}</a>}</p>
  </section>
</Base>

<script>
  import '../scripts/home';
</script>
