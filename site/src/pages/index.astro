---
import Base from '../layouts/Base.astro';
import Face from '../components/Face.astro';
import Mark from '../components/Mark.astro';
import Scale from '../components/Scale.astro';
import { getCollection } from 'astro:content';
import { site, hasEmail } from '../config/site';
import { url } from '../lib/url';
import '../styles/home.css';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
const n2 = (i: number) => String(i + 1).padStart(2, '0');
// Contact us is a mailto once a real address exists; until then it goes to the Contact block.
const contactHref = hasEmail ? `mailto:${site.email}` : '#contact';

const caps = [
  { t: 'Agent deployment', d: 'Agents that execute defined workflows inside existing systems, with permissions, logging and human review.' },
  { t: 'Model fine-tuning', d: 'Models adapted and evaluated on your data for the specific tasks your agents perform.' },
  { t: 'Systems integration', d: 'Connections to the systems where work already happens: ERP, CRM, data warehouses and internal tools.' },
  { t: 'Evaluation and governance', d: 'Continuous measurement of accuracy, cost and risk, with an audit trail for every action an agent takes.' },
];
const legend = ['The organisation', 'An agent enters', 'It reorganises', 'The change spreads'];
const shown = [0, 1 / 3, 2 / 3, 1];
const principles = [
  { t: 'Workflow first', d: 'We map how work is actually done before choosing a model.' },
  { t: 'Design the reorganisation', d: 'Roles, handoffs and controls change when agents arrive. We plan that change.' },
  { t: 'Measure in production', d: 'Every deployment reports on accuracy, cost and time saved.' },
];
const team = [0, 1, 2, 3];
---
<Base page="home" home>
  <!-- the first screen: the company, on the instrument's nameplate -->
  <section class="hero" aria-labelledby="h-name">
    <Face kind="home" class="face--hero" interactive label="A field of gauges in equilibrium. Point to disturb it; click, or use the arrow keys, to choose where an agent enters." />
    <div class="nameplate">
      <h1 class="nameplate__word" id="h-name"><Mark class="nameplate__mark" /><span>Corollary Labs</span></h1>
      <div class="nameplate__copy">
        <p class="nameplate__headline">We deploy AI agents inside organisations and rebuild the operations around them.</p>
        <p class="nameplate__sub">Agent design, model fine-tuning, systems integration and evaluation, from first workflow to production.</p>
        <div class="keys">
          <a class="key key--primary" href={contactHref}><span class="key__lamp" aria-hidden="true"></span>Contact us</a>
          <a class="key" href="#approach">Our approach</a>
        </div>
      </div>
    </div>
  </section>

  <div class="tail">
    <!-- 01 Capabilities: one gauge per capability; pointing at one swings its needle -->
    <section class="t-block" id="capabilities" aria-labelledby="h-caps" data-face-scope>
      <h2 class="t-label mono" id="h-caps"><span class="lamp"></span>Capabilities</h2>
      <div>
        <Face kind="caps" class="face--caps" label="Four gauges, one per capability" />
        <ol class="cols caps">
          {caps.map((c, i) => (
            <li class="cols__col" data-ping={i}>
              <span class="cols__n mono">{n2(i)}</span>
              <h3 class="cols__title">{c.t}</h3>
              <p class="cols__text">{c.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 02 Approach: the story, as one figure played by its legend -->
    <section class="t-block" id="approach" aria-labelledby="h-approach">
      <h2 class="t-label mono" id="h-approach"><span class="lamp"></span>Approach</h2>
      <div>
        <p class="lede">We start from the workflow: its inputs, its outputs and the decisions made inside it. We then design the organisation that works with the agents, not only the agents.</p>
        <figure class="story" data-story>
          <Face kind="approach" class="face--approach" label="The organisation, an agent entering it, the organisation reorganising around it, and the change spreading to linked organisations." />
          <Scale stops={shown} labels={legend} orient="h" class="story__scale--h" />
          <Scale stops={shown} labels={legend} orient="v" class="story__scale--v" />
        </figure>
        <ol class="cols principles">
          {principles.map((p, i) => (
            <li class="cols__col">
              <span class="cols__n mono">{n2(i)}</span>
              <h3 class="cols__title">{p.t}</h3>
              <p class="cols__text">{p.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 03 Research: one lamp per essay -->
    <section class="t-block" id="research" aria-labelledby="h-research">
      <h2 class="t-label mono" id="h-research"><span class="lamp"></span>Research</h2>
      <div>
        <p class="t-intro">Essays on agents, organisations and how new technology spreads.</p>
        <div class="strip" style="--i:0">
          <div class="strip__bar" aria-hidden="true">
            <span class="strip__scale"></span>
            {essays.map((_, i) => <span class="strip__lamp" style={`--c:${i}`}><span class="mono">{n2(i)}</span></span>)}
            <span class="strip__pointer"></span>
          </div>
          <ol class="strip__list">
            {essays.map((e, i) => (
              <li style={`--c:${i}`}>
                <a href={url(`essays/${e.id}/`)}>
                  <span class="strip__meta mono"><span>{n2(i)}</span><time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time></span>
                  <span class="strip__title">{e.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
          <a class="t-more" href={url('essays/')}>All research <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- 04 Company -->
    <section class="t-block" id="company" aria-labelledby="h-company">
      <h2 class="t-label mono" id="h-company"><span class="lamp"></span>Company</h2>
      <div>
        <p class="lede">Corollary Labs is an AI company. <span class="ph">[About — founding story and team, one paragraph]</span></p>
        <ul class="cols roster" aria-label="Team">
          {team.map((i) => (
            <li class="cols__col">
              <span class="cols__n mono">{n2(i)}</span>
              <p class="cols__title ph">[Name]</p>
              <p class="roster__role mono ph">[Role]</p>
            </li>
          ))}
        </ul>
        <a class="t-more" href={url('about/')}>About the company <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- 05 Contact: one lamp, lit -->
    <section class="t-block contact" id="contact" aria-labelledby="h-contact">
      <h2 class="t-label mono" id="h-contact"><span class="lamp is-on"></span>Contact</h2>
      <div class="contact__plate">
        <p class="contact__line">Deploying agents in your organisation? Talk to us.</p>
        {hasEmail ? <p class="contact__email"><a href={`mailto:${site.email}`}>{site.email}</a></p> : <p class="contact__email ph">{site.email}</p>}
      </div>
    </section>
  </div>

  <script>
    import '../scripts/home';
    import '../scripts/faces';
  </script>
</Base>
