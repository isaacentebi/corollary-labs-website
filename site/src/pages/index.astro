---
import Base from '../layouts/Base.astro';
import { essayThreads, fmt, pad } from '../lib/essays';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const essays = (await essayThreads()).slice(0, 3);
---
<Base over page="home">
  <section class="story" aria-label="Corollary Labs">
    <div class="stage" data-stage data-state="0">
      <canvas class="cloth" role="img" aria-label="Corollary Labs, woven. Click the cloth to insert a thread."></canvas>
      <h1 class="sr">Corollary Labs</h1>
      <div class="draft" data-draft aria-hidden="true">
        <span class="draft__l draft__l--thr">Threading</span>
        <span class="draft__l draft__l--tie">Tie-up</span>
        <span class="draft__l draft__l--tre">Treadling</span>
      </div>
      <div class="band">
        <div class="caps">
          <p class="cap cap--0 mono">[Statement]</p>
          <p class="cap cap--1 mono">[Caption 1 — one line]</p>
          <p class="cap cap--2 mono">[Caption 2 — one line]</p>
          <p class="cap cap--3 mono">[Caption 3 — one line]</p>
        </div>
        <div class="tools">
          <button class="ins mono" type="button" data-insert>Insert thread</button>
          <span class="count mono" data-count aria-live="polite"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="about wrap" aria-label="About">
    <a class="kick mono" href={`${base}about/`}>About <span aria-hidden="true">→</span></a>
    <p class="about__p">[About — one paragraph]</p>
  </section>

  <section class="latest wrap" aria-label="Essays">
    <a class="kick mono" href={`${base}essays/`}>Essays <span aria-hidden="true">→</span></a>
    <ol class="threads">
      {essays.map(({ e, n, af }) => (
        <li>
          <a class="thr" href={`${base}essays/${e.id}/`}>
            <span class="thr__n mono">{pad(n)}</span>
            <span class="thr__t">{e.data.title}</span>
            <time class="thr__d mono" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
            <span class="thr__rule" aria-hidden="true"><i style={`left:${(af * 100).toFixed(2)}%`}></i></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <nav class="pages wrap" aria-label="Pages">
    <a href={`${base}about/`}><span class="mono">About</span><span class="pages__arrow" aria-hidden="true">→</span></a>
    <a href={`${base}team/`}><span class="mono">Team</span><span class="pages__arrow" aria-hidden="true">→</span></a>
    <a href={`${base}contact/`}><span class="mono">Contact</span><span class="pages__arrow" aria-hidden="true">→</span></a>
  </nav>

  <script>
    import { mountCloth } from '../scripts/cloth';
    const stage = document.querySelector<HTMLElement>('[data-stage]')!;
    mountCloth(stage, stage.querySelector('canvas')!);
  </script>
</Base>
