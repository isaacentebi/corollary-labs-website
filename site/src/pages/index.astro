---
import Base from '../layouts/Base.astro';
import Drawdown from '../components/Drawdown.astro';
import { getCollection } from 'astro:content';
import { hash } from '../lib/weave';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
---
<Base top={false} page="home">
  <section class="story" aria-label="Corollary Labs">
    <div class="stage" data-stage data-state="0">
      <canvas class="cloth" data-cloth aria-hidden="true"></canvas>
      <h1 class="sr">Corollary Labs</h1>
      <p class="cap cap--0 mono"><span class="ph">[Statement]</span></p>
      <p class="cap cap--1 mono"><span class="ph">[Caption 1 — one line]</span></p>
      <p class="cap cap--2 mono"><span class="ph">[Caption 2 — one line]</span></p>
      <p class="cap cap--3 mono"><span class="ph">[Caption 3 — one line]</span></p>
      <ol class="steps mono" aria-hidden="true"><li>1</li><li>2</li><li>3</li><li>4</li></ol>
    </div>
  </section>

  <section class="about wrap" aria-labelledby="about-h">
    <h2 id="about-h" class="label mono">About</h2>
    <p class="about__p ph">[About — one paragraph]</p>
    <a class="lnk mono" href={`${base}about/`}>About</a>
  </section>

  <section class="latest wrap" aria-labelledby="essays-h">
    <div class="latest__head">
      <h2 id="essays-h" class="label mono">Essays</h2>
      <a class="lnk mono" href={`${base}essays/`}>All essays</a>
    </div>
    <ol class="elist">
      {essays.map((e, n) => (
        <li>
          <a class="erow" href={`${base}essays/${e.id}/`}>
            <span class="erow__sw"><Drawdown cols={40} rows={6} axis={6 + Math.floor(hash(e.id) * 28)} cy={3} radius={10 + n * 7} seed={e.id} /></span>
            <span class="erow__t">{e.data.title}</span>
            <time class="erow__d mono" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <nav class="pages wrap" aria-label="Pages">
    <a href={`${base}about/`}><span class="mono">About</span><span class="pages__arrow" aria-hidden="true">→</span></a>
    <a href={`${base}team/`}><span class="mono">Team</span><span class="pages__arrow" aria-hidden="true">→</span></a>
    <a href={`${base}contact/`}><span class="mono">Contact</span><span class="pages__arrow" aria-hidden="true">→</span></a>
  </nav>

  <script>
    import { mountCloth } from '../scripts/cloth';
    const stage = document.querySelector<HTMLElement>('[data-stage]')!;
    mountCloth(stage, stage.querySelector('canvas')!);
  </script>
</Base>
