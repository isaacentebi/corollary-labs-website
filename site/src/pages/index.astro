---
import Base from '../layouts/Base.astro';
import Unit from "../components/Unit.astro";
import { getCollection, render } from 'astro:content';
import { site, u } from '../config/site';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const rows = await Promise.all(essays.map(async (e) => ({ e, fm: (await render(e)).remarkPluginFrontmatter })));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
---
<Base page="home">
  <section class="stage" data-stage aria-label="Corollary Labs">
    <div class="stage__pin">
      <canvas class="stage__canvas" tabindex="0" aria-label="Axonometric drawing. Drag or use the arrow keys to turn it; click or press Enter to plug in a unit."></canvas>
      <div class="stage__text">
        <h1 class="stage__name">{site.name}</h1>
        <p class="stage__statement ph">[Statement — one or two sentences]</p>
      </div>
      <ol class="stage__states" aria-label="Sequence">
        <li data-state><span class="n">1</span><span class="ph">[Caption — the structure as it stands]</span></li>
        <li data-state><span class="n">2</span><span class="ph">[Caption — units plug in; the structure reorganises and grows]</span></li>
        <li data-state><span class="n">3</span><span class="ph">[Caption — the change spreads along the network]</span></li>
      </ol>
      <p class="stage__hint" aria-hidden="true"><span class="hint-mouse">Drag to turn · Click to plug in</span><span class="hint-touch">Tap to plug in</span><span class="hint-city">Click or tap to plug in</span></p>
      <div class="stage__rule" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class="tail">
    <div class="wrap shaft">
      <div class="block about-block" data-reveal>
        <h2 class="label">About</h2>
        <div>
          <p class="lede ph">[About — one paragraph]</p>
          <a class="more" href={u('about/')}>About <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="block" data-reveal>
        <h2 class="label">Essays</h2>
        <ol class="elist">
          {rows.map(({ e, fm }) => (
            <li>
              <a class="erow" href={u(`essays/${e.id}/`)}>
                <span class="erow__glyph"><Unit /></span>
                <time class="erow__date mono" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
                <span class="erow__main"><span class="erow__title">{e.data.title}</span><span class="erow__dek">{e.data.dek}</span></span>
                <span class="erow__time mono">{fm.minutesRead} min</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="more" href={u('essays/')}>All essays <span aria-hidden="true">→</span></a>
      </div>

      <nav class="block links" aria-label="Pages" data-reveal>
        <h2 class="label">Pages</h2>
        <ul class="bigl">
          <li><a href={u('about/')}><span>About</span><span aria-hidden="true">→</span></a></li>
          <li><a href={u('team/')}><span>Team</span><span aria-hidden="true">→</span></a></li>
          <li><a href={u('contact/')}><span>Contact</span><span aria-hidden="true">→</span></a></li>
        </ul>
      </nav>
    </div>
  </section>
</Base>
