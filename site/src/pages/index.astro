---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site, u } from '../config/site';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const pad = (n: number) => String(n).padStart(2, '0');
// a thin strip of ground between sections: one small group you can pick apart
const strip = {
  stones: [{ x: 0.21, y: 0.02, r: 0.075, tone: 1, gloss: 0.8 }, { x: 0.265, y: -0.02, r: 0.12, sq: 0.6, a: 1.3 }, { x: 0.32, y: 0.03, r: 0.05, rose: 1, gloss: 0.85 }],
  mstones: [{ x: 0.04, y: 0.02, r: 0.08 }, { x: 0.22, y: -0.02, r: 0.12 }, { x: 0.37, y: 0.03, r: 0.055 }],
  group: true, drag: true, moat: 60, pad: 18, bounded: true,
};
---
<Base page="home">
  <section class="field" data-field aria-label={site.name}>
    <div class="field__stick">
      <canvas class="field__canvas" data-canvas aria-hidden="true"></canvas>
      <div class="field__fallback" aria-hidden="true"></div>
      <div class="field__center" data-center>
        <h1 class="field__name" data-name><span>Corollary</span> <span>Labs</span></h1>
        <p class="field__ph field__ph--0 ph" data-ph="0">[Statement]</p>
      </div>
      <p class="field__ph field__ph--1 ph" data-ph="1">[Sentence]</p>
      <p class="field__ph field__ph--2 ph" data-ph="2">[Sentence]</p>
      <p class="field__idx mono" data-idx aria-hidden="true">01/04 t 0.00</p>
      <div class="field__cue" data-cue aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class="home-about wrap" data-reveal>
    <p class="label">About</p>
    <p class="home-about__text ph">[About — one paragraph]</p>
  </section>

  <div class="strip band" data-band={JSON.stringify(strip)} aria-hidden="true"></div>

  <section class="home-essays wrap" data-reveal>
    <div class="home-essays__head">
      <p class="label">Essays</p>
      <a class="more" href={u('essays/')}>All essays</a>
    </div>
    <ol class="rows">
      {essays.map((e, i) => (
        <li>
          <a class="row" href={u(`essays/${e.id}/`)}>
            <span class="row__n mono">{pad(i + 1)}</span>
            <span class="row__title">{e.data.title}</span>
            <time class="row__date" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
