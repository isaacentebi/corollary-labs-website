---
// Home: the company first (name, what it does, two actions) on the plain sheet, then capabilities, the approach figure,
// research, company and contact. The sheet under the hero answers the pointer; the approach figure carries the story.
import Sheet from '../layouts/Sheet.astro';
import { getCollection } from 'astro:content';
import { url, site, copy, mailHref } from '../config/site';
import Mark from '../components/Mark.astro';
import Capabilities from '../components/Capabilities.astro';
import Story from '../components/Story.astro';
import Principles from '../components/Principles.astro';
import Rings from '../components/Rings.astro';
const team = [[2, 1, -3, 2], [-4, 2, 2, -2], [1, -5, -3, 3], [-6, -1, 3, 1]];
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
---
<Sheet active="home" page="home">
  <section class="hero band" data-band data-state="hero" aria-labelledby="hero-h">
    <Mark size={34} cls="hero__mark" />
    <div class="hero__body">
      <h1 id="hero-h" class="band__title hero__name" data-latent><span class="band__line">Corollary</span> <span class="band__line">Labs</span></h1>
      <p class="hero__headline">{copy.headline}</p>
      <p class="hero__sub">{copy.subline}</p>
      <div class="actions">
        <a class="btn btn--primary" href={mailHref}>Contact us</a>
        <a class="btn" href="#approach">Our approach</a>
      </div>
    </div>
  </section>

  <section class="sec" id="capabilities" aria-labelledby="cap-h">
    <div class="sec__head">
      <h2 id="cap-h" class="kicker">Capabilities</h2>
    </div>
    <Capabilities />
  </section>

  <section class="approach" id="approach" aria-labelledby="app-h">
    <div class="sec sec--flush">
      <div class="sec__head">
        <h2 id="app-h" class="kicker">Approach</h2>
      </div>
      <p class="sec__intro">{copy.approachIntro}</p>
    </div>
    <Story />
    <div class="sec sec--after">
      <Principles />
    </div>
  </section>

  <section class="sec" id="research" aria-labelledby="res-h">
    <div class="sec__head">
      <h2 id="res-h" class="kicker">Research</h2>
      <a class="more" href={url('essays/')}>All research →</a>
    </div>
    <p class="sec__intro sec__intro--small">{copy.researchIntro}</p>
    <ol class="rows">
      {essays.map((e) => (
        <li>
          <a class="row" href={url(`essays/${e.id}/`)}>
            <time class="row__date" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
            <span class="row__title">{e.data.title}</span>
            <span class="row__dek">{e.data.dek}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec" id="company" aria-labelledby="co-h">
    <div class="sec__head">
      <h2 id="co-h" class="kicker">Company</h2>
    </div>
    <div class="company">
      <div>
        <h3 class="sub">About</h3>
        <p class="company__about">{copy.about} <span class="ph">[About — founding story and team, one paragraph]</span></p>
      </div>
      <div>
        <h3 class="sub">Team</h3>
        <ul class="team-lines">
          {team.map((o) => <li><Rings cls="team-lines__disc" w={48} h={48} pitch={3.2} dx={o[0]} dy={o[1]} hx={o[2]} hy={o[3]} /><span class="ph">[Name — Role]</span></li>)}
        </ul>
        <a class="more" href={url('about/')}>About the company →</a>
      </div>
    </div>
  </section>

  <section class="sec sec--contact" id="contact" aria-labelledby="ct-h">
    <div class="sec__head">
      <h2 id="ct-h" class="kicker">Contact</h2>
    </div>
    <p class="contact__line">{copy.contactLine}</p>
    <p class="mail"><span>{site.email}</span></p>
  </section>
</Sheet>
