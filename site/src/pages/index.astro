---
// Home: one firm under the aperture, read as a plate with five legends.
// The specimen is sticky; the legends scroll beside it (left for figs 1–3, right for 4–5, below it on phones).
// Letters on the drawing (a, b, c…) are the keys listed under each legend.
import Base from '../layouts/Base.astro';
import { site, figs } from '../config/site';
import '../styles/home.css';
const L = 'abcdefghij'; // key letters
---
<Base page="home">
  <section class="home" data-home aria-labelledby="home-title">
    <div class="stage" data-stage>
      <canvas class="stage__canvas" data-specimen role="img"
        aria-label={`Five drawings of a firm as a living cell. ${figs.map((f, i) => `Figure ${i + 1}, ${f.title}: ${f.legend}`).join(' ')}`}></canvas>
      <div class="keys" data-keys aria-hidden="true"></div>
    </div>

    <div class="flow">
      <header class="block hero" data-block="0">
        <h1 class="hero__name t-display" id="home-title">
          <span>Corollary</span> <span>Labs</span>
        </h1>
        <p class="hero__statement">
          {site.name} is a company. <span class="ph">[Placeholder — one sentence on what it studies.]</span> <span class="ph">[Placeholder — one sentence on what it builds.]</span>
        </p>
        <p class="hero__cue t-label" aria-hidden="true"><span class="hero__cue-dot"></span>Scroll</p>
      </header>

      {figs.map((f, i) => (
        <article class:list={['block', 'fig', { '-right': f.side === 'right', '-last': i === figs.length - 1 }]} data-block={i + 1} aria-labelledby={`fig-${i + 1}`}>
          <div class="legend" data-legend={i + 1}>
            <p class="legend__n">Fig. {i + 1}</p>
            <h2 class="legend__title t-title" id={`fig-${i + 1}`}>{f.title}</h2>
            <p class="legend__text">{f.legend}</p>
            {f.keys.length > 0 && (
              <ul class="legend__keys">
                {f.keys.map((k, j) => <li><i>{L[j]}</i> {k}</li>)}
              </ul>
            )}
          </div>
        </article>
      ))}
      <div class="block tail" data-block="6" aria-hidden="true"></div>
    </div>
  </section>
  <script>
    import { initHome } from '../scripts/home';
    initHome();
  </script>
</Base>
