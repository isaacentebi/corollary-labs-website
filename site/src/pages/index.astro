---
import Base from '../layouts/Base.astro';
import Face from '../components/Face.astro';
import MHead from '../components/MHead.astro';
import Scale from '../components/Scale.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';
import '../styles/home.css';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
const stops = [0, 0.25, 0.56, 1];
const captions = [
  '[State 1 — one line: the organisation in equilibrium]',
  '[State 2 — one line: an agent enters]',
  '[State 3 — one line: the organisation reorganises around it]',
  '[State 4 — one line: the change spreads to linked organisations]',
];
---
<Base page="home" home>
  <h1 class="visually-hidden">Corollary Labs</h1>
  <section class="story" data-story aria-label="Story">
    <div class="stage">
      <MHead current="home" statement />
      <Face kind="home" interactive />
      <div class="stage__foot">
        <Scale stops={stops} orient="h" />
        <p class="caption ph" data-caption data-captions={JSON.stringify(captions)} aria-live="polite">{captions[0]}</p>
      </div>
    </div>
  </section>

  <div class="tail">
    <section class="t-block" aria-labelledby="h-about">
      <h2 class="t-label mono" id="h-about"><span class="lamp"></span>About</h2>
      <div>
        <p class="lede ph">[About — one paragraph, three or four sentences, on what the company studies and builds]</p>
        <a class="t-more" href={url('about/')}>About <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="t-block" aria-labelledby="h-essays">
      <h2 class="t-label mono" id="h-essays"><span class="lamp"></span>Essays</h2>
      <div class="strip" style="--i:0">
        <div class="strip__bar" aria-hidden="true">
          <span class="strip__scale"></span>
          {essays.map((_, i) => <span class="strip__lamp" style={`--c:${i}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span></span>)}
          <span class="strip__pointer"></span>
        </div>
        <ol class="strip__list">
          {essays.map((e, i) => (
            <li style={`--c:${i}`}>
              <a href={url(`essays/${e.id}/`)}>
                <span class="strip__meta mono"><span>{String(i + 1).padStart(2, '0')}</span><time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time></span>
                <span class="strip__title">{e.data.title}</span>
                <span class="strip__dek">{e.data.dek}</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="t-more" href={url('essays/')}>All essays <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>

  <Fragment slot="deck">
    <Scale stops={stops} orient="v" />
    <p class="caption ph" data-caption data-captions={JSON.stringify(captions)}>{captions[0]}</p>
  </Fragment>

  <script>
    import '../scripts/home';
  </script>
</Base>
