---
// Home: the company. Hero (what it is) → Capabilities → Approach (the diagram) → Research → Company → Contact.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Approach from '../components/Approach.astro';
import { getCollection, render } from 'astro:content';
import { site, url } from '../config/site';
import '../styles/landing.css';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const rows = await Promise.all(essays.map(async (e) => ({ e, fm: (await render(e)).remarkPluginFrontmatter })));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
const pad = (n: number) => String(n).padStart(2, '0');

const capabilities = [
  { t: 'Agent deployment.', d: 'Agents that execute defined workflows inside existing systems, with permissions, logging and human review.' },
  { t: 'Model fine-tuning.', d: 'Models adapted and evaluated on your data for the specific tasks your agents perform.' },
  { t: 'Systems integration.', d: 'Connections to the systems where work already happens: ERP, CRM, data warehouses and internal tools.' },
  { t: 'Evaluation and governance.', d: 'Continuous measurement of accuracy, cost and risk, with an audit trail for every action an agent takes.' },
];
const team = Array.from({ length: 4 }, () => ({ name: '[Name]', role: '[Role]' }));
---
<Base page="home">
  <Hero />

  <section class="sec caps" id="capabilities" aria-labelledby="caps-title">
    <header class="sec__head">
      <h2 class="sec__k" id="caps-title">Capabilities</h2>
    </header>
    <ol class="caps__list" data-caps>
      {capabilities.map((c, i) => (
        <li class="cap" data-cap>
          <span class="cap__node" aria-hidden="true"></span>
          <span class="cap__n">{pad(i + 1)}</span>
          <h3 class="cap__t">{c.t}</h3>
          <p class="cap__d">{c.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <Approach />

  <section class="sec research" id="research" aria-labelledby="research-title">
    <header class="sec__head">
      <h2 class="sec__k" id="research-title">Research</h2>
      <p class="sec__intro -small" data-reveal="lines">Essays on agents, organisations and how new technology spreads.</p>
    </header>
    <ol class="home-essays__list" data-reveal="rows">
      {rows.map(({ e, fm }) => (
        <li>
          <a class="home-essay" href={url(`/essays/${e.id}/`)}>
            <time class="home-essay__date" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
            <span class="home-essay__title">{e.data.title}</span>
            <span class="home-essay__dek">{e.data.dek}</span>
            <span class="home-essay__time">{fm.minutesRead} min</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="sec__more"><a class="pill" href={url('/essays/')}>All research <i aria-hidden="true">→</i></a></p>
  </section>

  <section class="sec company" id="company" aria-labelledby="company-title">
    <header class="sec__head">
      <h2 class="sec__k" id="company-title">Company</h2>
    </header>
    <div class="company__grid">
      <div class="company__about">
        <h3 class="company__h">About</h3>
        <p class="company__p" data-reveal="lines">{site.name} is an AI company. <span class="ph">[About — founding story and team, one paragraph]</span></p>
      </div>
      <div class="company__team">
        <h3 class="company__h">Team</h3>
        <ul class="team-mini" data-reveal="rows">
          {team.map((p) => <li class="team-mini__row"><span class="ph">{p.name}</span><span class="team-mini__role ph">{p.role}</span></li>)}
        </ul>
      </div>
    </div>
    <p class="sec__more"><a class="pill" href={url('/about/')}>About the company <i aria-hidden="true">→</i></a></p>
  </section>

  <section class="sec contact" id="contact" aria-labelledby="contact-title">
    <header class="sec__head">
      <h2 class="sec__k" id="contact-title">Contact</h2>
    </header>
    <div class="contact__body">
      <p class="contact__line" data-reveal="lines">Deploying agents in your organisation? Talk to us.</p>
      <p class="contact__email">{site.email}</p>
    </div>
  </section>
</Base>
