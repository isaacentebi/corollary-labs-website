---
// About: the company described the way the site describes every firm, as one column of inputs and outputs.
// Everything in [brackets] is a placeholder to be written with the founder. FOR FOUNDER REVIEW.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site, url } from '../config/site';
import '../styles/pages.css';

const essays = await getCollection('essays', ({ data }) => !data.draft);
const inputs = ['[Input]', '[Input]', '[Input]', '[Input]'];
const outputs: { k: string; v: string; href?: string; real?: boolean }[] = [
  { k: 'Essays', v: `${essays.length} published`, href: url('essays/'), real: true },
  { k: '[Output]', v: '[Placeholder]' },
  { k: '[Output]', v: '[Placeholder]' },
];
// the column drawing: one cell per row of the table below
const cellH = 34, gap = 8, x = 140, w = 150;
const rows = [
  ...inputs.map(() => ({ kind: 'in' as const })),
  ...outputs.map((o) => ({ kind: o.real ? ('real' as const) : ('out' as const) })),
];
const yOf = (i: number) => 30 + i * (cellH + gap) + (i >= inputs.length ? 34 : 0);
const H = yOf(rows.length - 1) + cellH + 30;
---
<Base page="about" title="About" description={`About ${site.name}.`}>
  <section class="page">
    <header class="ph-row reveal">
      <p class="ph-row__n mono">02</p>
      <h1 class="ph-row__t">About</h1>
      <p class="ph-row__m mono"><span><b>Table 0.</b> {site.name}</span><span>One column</span></p>
    </header>
    <p class="page__lede reveal">{site.name} is a company. <span class="ph">[Placeholder — one sentence on what it studies.]</span> <span class="ph">[Placeholder — one sentence on what it builds.]</span></p>

    <div class="ab">
      <figure class="ab__fig reveal">
        <svg viewBox={`0 0 420 ${H}`} role="img" aria-label={`${site.name} drawn as one column of a table: ${inputs.length} input cells (placeholders) and ${outputs.length} output cells, one of which, Essays, is filled.`}>
          <text x={x - 16} y="20" fill="var(--i3)" font-family="var(--f-m)" font-size="10" text-anchor="end" letter-spacing=".4">COL.</text>
          <text x={x} y="20" fill="var(--i)" font-family="var(--f-m)" font-size="10" letter-spacing=".4">CL</text>
          {rows.map((r, i) => (
            r.kind === 'real'
              ? <rect x={x} y={yOf(i)} width={w} height={cellH} fill="var(--i)" />
              : <rect x={x + 0.5} y={yOf(i) + 0.5} width={w - 1} height={cellH - 1} fill="none" stroke="var(--ln2)" stroke-dasharray="3 3" />
          ))}
          <line x1={x} x2={x + w} y1={yOf(inputs.length) - 17} y2={yOf(inputs.length) - 17} stroke="var(--ln2)" />
          <text x={x - 16} y={yOf(0) + 22} fill="var(--i2)" font-family="var(--f-m)" font-size="10" text-anchor="end" letter-spacing=".4">INPUTS</text>
          <text x={x - 16} y={yOf(inputs.length) + 22} fill="var(--i2)" font-family="var(--f-m)" font-size="10" text-anchor="end" letter-spacing=".4">OUTPUTS</text>
          <text x={x + w + 16} y={yOf(inputs.length) + 22} fill="var(--i)" font-family="var(--f-m)" font-size="10" letter-spacing=".4">ESSAYS · {String(essays.length).padStart(2, '0')}</text>
        </svg>
        <figcaption class="mono">{site.name} as one column. Dashed cells are not yet written.</figcaption>
      </figure>

      <table class="tb reveal">
        <caption class="mono"><b>Table 0.</b> {site.name}, inputs and outputs</caption>
        <tbody>
          <tr><th scope="rowgroup" colspan="2" class="mono">Inputs</th></tr>
          {inputs.map((k) => <tr><td class="ph">{k}</td><td class="ph">[Placeholder]</td></tr>)}
          <tr><th scope="rowgroup" colspan="2" class="mono">Outputs</th></tr>
          {outputs.map((o) => <tr><td class:list={{ ph: !o.real }}>{o.k}</td><td class:list={{ ph: !o.real }}>{o.href ? <a class="link" href={o.href}>{o.v}</a> : o.v}</td></tr>)}
        </tbody>
      </table>
    </div>

    <table class="tb colo reveal">
      <caption class="mono"><b>Colophon</b></caption>
      <tbody>
        <tr><td class="mono" style="width:30%;color:var(--i3)">Entity</td><td>{site.name} is a company.</td></tr>
        <tr><td class="mono" style="color:var(--i3)">Founded</td><td class="ph">[Year]</td></tr>
        <tr><td class="mono" style="color:var(--i3)">Location</td><td class="ph">[City]</td></tr>
        <tr><td class="mono" style="color:var(--i3)">Contact</td><td><a class="link" href={`mailto:${site.email}`}>{site.email}</a></td></tr>
      </tbody>
    </table>
  </section>
</Base>
