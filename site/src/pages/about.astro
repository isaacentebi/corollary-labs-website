---
import Sheet from '../layouts/Sheet.astro';
import Band from '../components/Band.astro';
import { site } from '../config/site';
---
<Sheet active="about" page="about" title="About">
  <Band lines={['About']} state="agent" fit={3.5} />
  <section class="page">
    <p class="statement ph">[About — one paragraph]</p>
    <div class="cols">
      <p class="ph">[Paragraph]</p>
      <p class="ph">[Paragraph]</p>
    </div>
    <dl class="colophon">
      <div><dt>Company</dt><dd>{site.name}</dd></div>
      <div><dt>Entity</dt><dd class="ph">[Entity]</dd></div>
      <div><dt>Founded</dt><dd class="ph">[Year]</dd></div>
      <div><dt>Location</dt><dd class="ph">[City]</dd></div>
      <div><dt>Contact</dt><dd><a href="mailto:">{site.email}</a></dd></div>
    </dl>
  </section>
</Sheet>
