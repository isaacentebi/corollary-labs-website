---
// About: statement, a plate of the reorganised firm (figure 4 of the home page), and a specimen label.
// Everything in [brackets] is a placeholder, to be written with the founder.
import Base from '../layouts/Base.astro';
import { site, figs } from '../config/site';
import '../styles/pages.css';

const rows = [
  { k: 'Entity', v: `${site.name} is a company.` },
  { k: 'Founded', v: '[Year]' },
  { k: 'Location', v: '[City]' },
  { k: 'Contact', v: site.email, href: `mailto:${site.email}` },
];
---
<Base page="about" title="About" description={`About ${site.name}.`}>
  <article class="page about" aria-labelledby="about-title">
    <p class="page__kicker t-label" data-reveal>Draft, placeholders in brackets</p>
    <h1 class="page__title t-display" id="about-title" data-reveal>About</h1>
    <div class="about__grid">
      <p class="about__statement" data-reveal>
        {site.name} is a company. <span class="ph">[Placeholder — one sentence on what it studies.]</span> <span class="ph">[Placeholder — one sentence on what it builds.]</span>
      </p>
      <figure class="plate" data-reveal style="--rd:0.15s">
        <canvas data-plate="4" role="img" aria-label={`Figure 4, ${figs[3].title}. ${figs[3].legend}`}></canvas>
        <figcaption class="t-label">Figure 4, {figs[3].title}</figcaption>
      </figure>
    </div>
    <section class="label-card" aria-label="Colophon" data-reveal>
      <dl>
        {rows.map((r) => (
          <div>
            <dt class="t-label">{r.k}</dt>
            <dd class:list={{ ph: r.v.startsWith('[') }}>{r.href ? <a class="link-u" href={r.href}>{r.v}</a> : r.v}</dd>
          </div>
        ))}
      </dl>
    </section>
  </article>
  <script>
    import { initPlates } from '../scripts/plate';
    initPlates();
  </script>
</Base>
