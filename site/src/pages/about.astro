---
import Base from '../layouts/Base.astro';
import Pebble from '../components/Pebble.astro';
import { u } from '../config/site';
const stones = [
  { x: 0.3, y: -0.02, r: 0.14 }, { x: 0.4, y: 0.16, r: 0.1 }, { x: 0.22, y: 0.2, r: 0.07, rose: 1 },
];
const mstones = [{ x: -0.1, y: -0.3, r: 0.12 }, { x: 0.2, y: -0.26, r: 0.09 }, { x: 0.06, y: -0.12, r: 0.06 }];
---
<Base page="about" title="About">
  <section class="page-band page-band--left band" data-band={JSON.stringify({ stones, mstones, clear: '[data-clear]' })}>
    <div class="wrap page-band__in"><h1 data-clear>About</h1></div>
    <div class="band__edge"></div>
  </section>
  <section class="page-body wrap">
    <div class="cols" data-reveal>
      <p class="label">About</p>
      <p class="lead ph">[About — one paragraph]</p>
    </div>
    <div class="cols" data-reveal>
      <p class="label">[Heading]</p>
      <div>
        <p class="prose-ph">[Paragraph]</p>
        <p class="prose-ph">[Paragraph]</p>
      </div>
    </div>
    <div class="cols" data-reveal>
      <p class="label">Company</p>
      <dl class="facts">
        <div><dt>Entity</dt><dd>[Entity]</dd></div>
        <div><dt>Founded</dt><dd>[Year]</dd></div>
        <div><dt>Location</dt><dd>[City]</dd></div>
        <div><dt>Contact</dt><dd>[Email]</dd></div>
      </dl>
    </div>
    <div class="cols" data-reveal>
      <span></span>
      <div class="inline-links">
        <a class="more" href={u('team/')}><span>Team</span><Pebble size={34} seed={21} /></a>
        <a class="more" href={u('contact/')}><span>Contact</span><Pebble size={34} seed={22} /></a>
      </div>
    </div>
  </section>
</Base>
