---
import Base from '../layouts/Base.astro';
---
<Base page="about" title="About">
  <section class="page wrap shaft">
    <header class="phead">
      <h1 class="phead__title">About</h1>
    </header>
    <div class="split">
      <div class="split__text">
        <p class="lede ph">[About — opening paragraph]</p>
        <p class="ph">[About — second paragraph]</p>
        <p class="ph">[About — third paragraph]</p>
      </div>
      <div class="split__fig">
        <canvas class="plate" data-axon="about" data-th="-0.3" aria-hidden="true"></canvas>
      </div>
    </div>
    <dl class="colophon">
      <div><dt class="label">Entity</dt><dd class="ph">[Legal entity]</dd></div>
      <div><dt class="label">Founded</dt><dd class="ph">[Year]</dd></div>
      <div><dt class="label">Location</dt><dd class="ph">[City]</dd></div>
      <div><dt class="label">Contact</dt><dd class="ph">[Email]</dd></div>
    </dl>
  </section>
</Base>
