---
import Base from '../layouts/Base.astro';
import PagePlate from '../components/PagePlate.astro';
import '../styles/pages.css';
---
<Base page="about" title="About">
  <PagePlate title="About" variant={1}>
    <p class="plate__line ph">[About — one line under the title]</p>
  </PagePlate>
  <section class="page page--after">
    <div class="prose">
      <p class="prose__lede ph">[About — opening paragraph]</p>
      <p class="ph">[About — second paragraph]</p>
      <p class="ph">[About — third paragraph]</p>
    </div>
  </section>
</Base>
