---
import Base from '../layouts/Base.astro';
import Print from '../components/Print.astro';
---
<Base page="about" title="About" description="[About — meta description]">
  <section class="page">
    <h1 class="page__title">About</h1>
    <Print seed="about" class="page__print" base={5} agents={2} />
    <div class="page__body">
      <p class="lede">[About — opening paragraph: who we are and what we work on]</p>
      <p>[About — second paragraph: the questions we study]</p>
      <p>[About — third paragraph: how we work, and with whom]</p>
      <p>[About — fourth paragraph: where we are based; how to reach us]</p>
    </div>
  </section>
</Base>
