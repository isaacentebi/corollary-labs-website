---
// About: the company described the way the home page describes every firm, as one annotated column of cells:
// its inputs, its outputs, and the facts about it. Everything in [brackets] is a placeholder. FOR FOUNDER REVIEW.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site, url } from '../config/site';
import '../styles/pages.css';

const essays = await getCollection('essays', ({ data }) => !data.draft);
const pad = (n: number) => String(n).padStart(2, '0');
type Cell = { k: string; v: string; href?: string; kind?: 'ph' | 'on' | 'fact' };
const groups: { name: string; note: string; cells: Cell[] }[] = [
  { name: 'Inputs', note: 'Not yet written', cells: Array.from({ length: 4 }, () => ({ k: '[Input]', v: '[Placeholder]', kind: 'ph' as const })) },
  {
    name: 'Outputs', note: `${pad(essays.length)} essays published`, cells: [
      { k: 'Essays', v: `${pad(essays.length)} published`, href: url('essays/'), kind: 'on' },
      { k: '[Output]', v: '[Placeholder]', kind: 'ph' },
      { k: '[Output]', v: '[Placeholder]', kind: 'ph' },
    ],
  },
  {
    name: 'Colophon', note: '', cells: [
      { k: 'Entity', v: `${site.name} is a company.`, kind: 'fact' },
      { k: 'Founded', v: '[Year]', kind: 'ph' },
      { k: 'Location', v: '[City]', kind: 'ph' },
      { k: 'Contact', v: site.email, href: `mailto:${site.email}`, kind: 'fact' },
    ],
  },
];
---
<Base page="about" title="About" description={`About ${site.name}.`}>
  <section class="page">
    <header class="ph-row reveal">
      <p class="ph-row__n mono">02</p>
      <h1 class="ph-row__t">About</h1>
      <p class="ph-row__m mono"><span><b>Table 0.</b> {site.name}</span><span>One column</span></p>
    </header>
    <p class="page__lede reveal">{site.name} is a company. <span class="ph">[Placeholder — one sentence on what it studies.]</span> <span class="ph">[Placeholder — one sentence on what it builds.]</span></p>

    <div class="cc reveal" role="table" aria-label={`${site.name} as one column: inputs, outputs and colophon`}>
      <p class="cc__head mono" role="row"><span role="columnheader"></span><span role="columnheader">Col. CL · {site.name}</span></p>
      {groups.map((g) => (
        <div class="cc__group" role="rowgroup">
          <p class="cc__gname mono" role="row"><span role="rowheader">{g.name}</span><span class="cc__note">{g.note}</span></p>
          {g.cells.map((c) => (
            <div class="cc__row" role="row">
              <span class:list={['cc__k mono', { ph: c.kind === 'ph' }]} role="rowheader">{c.k}</span>
              <span class:list={['cc__cell', `-${c.kind}`]} role="cell">{c.href ? <a href={c.href}>{c.v}</a> : c.v}</span>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>
</Base>
