---
// About — the company, its team and its details. Placeholders in [brackets].
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import '../styles/pages.css';

const people = [1, 2, 3, 4];
---
<Base page="about" title="About" description={`About — ${site.name}`}>
  <article class="page">
    <h1 class="page__title">About</h1>
    <div class="rule"></div>

    <p class="statement">
      Corollary Labs is an AI company. <span class="ph">[About — founding story and team, one paragraph]</span>
    </p>

    <section class="team" id="team" aria-labelledby="team-h">
      <h2 class="team__h" id="team-h">Team</h2>
      <div class="fmblock -first">
        {people.map(() => (
          <div class="fm"><div class="fm__k ph">[Role]</div><div class="fm__v ph">[Name]</div></div>
        ))}
      </div>
    </section>

    <section class="fmblock" aria-label="Company details">
      <div class="fm"><div class="fm__k">Company</div><div class="fm__v ph">[Legal entity]</div></div>
      <div class="fm"><div class="fm__k">Founded</div><div class="fm__v ph">[Year]</div></div>
      <div class="fm"><div class="fm__k">Location</div><div class="fm__v ph">[City]</div></div>
      <div class="fm"><div class="fm__k">Contact</div><div class="fm__v">{site.email.startsWith('[') ? <span class="ph">{site.email}</span> : <a href={`mailto:${site.email}`}>{site.email}</a>}</div></div>
    </section>

    <section class="markfig" aria-labelledby="mark-h">
      <div class="markfig__art">
        <svg viewBox="0 0 440 250" role="img" aria-label="Logo, drawn large">
          <path class="mk-w" d="M20 172 H170 M270 172 H420" />
          <path class="mk-w mk-loop" d="M270 112 H304 Q324 112 324 92 V54 Q324 34 304 34 H136 Q116 34 116 54 V92 Q116 112 136 112 H170" />
          <rect x="170" y="82" width="100" height="126" class="mk-b" />
          <text x="220" y="154" class="mk-t mk-in">f</text>
          <text x="60" y="160" class="mk-t">X</text><text x="380" y="160" class="mk-t">Y</text>
          <text x="150" y="102" class="mk-t -b">U</text><text x="290" y="102" class="mk-t -b">U</text>
        </svg>
      </div>
      <div class="markfig__text">
        <h2 id="mark-h" class="fm__k">Logo</h2>
        <p class="ph">[Paragraph — the logo]</p>
      </div>
    </section>
  </article>
</Base>
