---
import Base from '../layouts/Base.astro';
import MiniScore from '../components/MiniScore.astro';
---
<Base page="about" title="About" description="[Meta description]">
  <header class="page-head">
    <div class="part__side"><span class="mark">E</span></div>
    <h1>About</h1>
    <div class="page-head__strip"><MiniScore seed="about" w={1080} h={170} voices={6} stroke={0.9} /></div>
  </header>
  <section class="part">
    <div class="part__side"><h2 class="label">About</h2></div>
    <div class="part__body">
      <p class="lead">[About — one paragraph]</p>
      <div class="prose placeholder">
        <p>[About — second paragraph]</p>
        <p>[About — third paragraph]</p>
      </div>
    </div>
  </section>
  <section class="part">
    <div class="part__side"><h2 class="label">[Heading]</h2></div>
    <div class="part__body prose placeholder">
      <p>[Paragraph]</p>
    </div>
  </section>
</Base>
