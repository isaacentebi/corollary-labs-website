---
import Base from '../layouts/Base.astro';
import Woven from '../components/Woven.astro';
import Drawdown from '../components/Drawdown.astro';
import '../styles/pages.css';
---
<Base title="About" page="about">
  <div class="title" style="--tw: 460px"><h1>About</h1><Woven text="About" /></div>
  <section class="wrap page-grid">
    <p class="lede ph">[Statement — two sentences]</p>
    <div class="page-body">
      <p class="ph">[About — paragraph 1]</p>
      <p class="ph">[About — paragraph 2]</p>
    </div>
    <figure class="page-fig"><Drawdown cols={96} rows={28} axis={47} cy={14} radius={40} seed="about" /></figure>
    <dl class="colophon mono">
      <div><dt>Entity</dt><dd class="ph">[Legal name]</dd></div>
      <div><dt>Founded</dt><dd class="ph">[Year]</dd></div>
      <div><dt>Location</dt><dd class="ph">[City]</dd></div>
      <div><dt>Contact</dt><dd class="ph">[Email]</dd></div>
    </dl>
  </section>
</Base>
