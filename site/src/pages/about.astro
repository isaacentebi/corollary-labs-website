---
import Base from '../layouts/Base.astro';
import Glyph from '../components/Glyph.astro';
import '../styles/pages.css';
---
<Base page="about" title="About">
  <section class="page">
    <header class="page__head" data-glyph-host>
      <h1 class="display">About</h1>
      <Glyph seed="about" class="page__glyph" big />
    </header>
    <div class="prose">
      <p class="prose__lede ph">[About — opening paragraph]</p>
      <p class="ph">[About — second paragraph]</p>
      <p class="ph">[About — third paragraph]</p>
    </div>
  </section>
</Base>
