---
import Base from '../layouts/Base.astro';
import { u } from '../config/site';
// the same ground seen from very far away, at dusk: many small groups, the lines as texture
const band = { far: { n: 15, seed: 5 }, dusk: 0.9, tilt: 0.62, zoom: 1, space: 7, clear: '[data-clear]' };
---
<Base page="about" title="About">
  <section class="page-band page-band--left page-band--tall band" data-band={JSON.stringify(band)}>
    <div class="wrap page-band__in"><h1 data-clear>About</h1></div>
  </section>
  <section class="page-body wrap">
    <div class="cols" data-reveal>
      <p class="label">About</p>
      <p class="lead ph">[About — one paragraph]</p>
    </div>
    <div class="cols" data-reveal>
      <p class="label ph">[Heading]</p>
      <div>
        <p class="prose-ph">[Paragraph]</p>
        <p class="prose-ph">[Paragraph]</p>
      </div>
    </div>
    <div class="cols" data-reveal>
      <p class="label">Company</p>
      <dl class="facts">
        <div><dt>Entity</dt><dd>[Entity]</dd></div>
        <div><dt>Founded</dt><dd>[Year]</dd></div>
        <div><dt>Location</dt><dd>[City]</dd></div>
        <div><dt>Contact</dt><dd>[Email]</dd></div>
      </dl>
    </div>
  </section>
</Base>
