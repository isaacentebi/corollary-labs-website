---
// About: one column of cells (inputs, outputs, details), in the home table's cell style.
// Everything in [brackets] is a placeholder.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site, url } from '../config/site';
import '../styles/pages.css';

const essays = await getCollection('essays', ({ data }) => !data.draft);
const pad = (n: number) => String(n).padStart(2, '0');
type Cell = { k: string; v: string; href?: string; kind?: 'ph' | 'on' | 'fact' };
const groups: { name: string; cells: Cell[] }[] = [
  { name: 'Inputs', cells: Array.from({ length: 4 }, () => ({ k: '[Input]', v: '[Input — description]', kind: 'ph' as const })) },
  {
    name: 'Outputs', cells: [
      { k: 'Essays', v: `${pad(essays.length)} essays (drafts)`, href: url('essays/'), kind: 'on' },
      { k: '[Output]', v: '[Output — description]', kind: 'ph' },
      { k: '[Output]', v: '[Output — description]', kind: 'ph' },
    ],
  },
  {
    name: 'Details', cells: [
      { k: 'Company', v: '[Company]', kind: 'ph' },
      { k: 'Founded', v: '[Year]', kind: 'ph' },
      { k: 'Location', v: '[City]', kind: 'ph' },
      { k: 'Email', v: site.email, href: `mailto:${site.email}`, kind: 'fact' },
    ],
  },
];
---
<Base page="about" title="About" description="[Meta description]">
  <section class="page">
    <header class="ph-row reveal">
      <p class="ph-row__n mono">02</p>
      <h1 class="ph-row__t">About</h1>
    </header>
    <p class="page__lede ph reveal">[About — one paragraph]</p>

    <div class="cc reveal" role="table" aria-label="About">
      {groups.map((g) => (
        <div class="cc__group" role="rowgroup">
          <p class="cc__gname mono" role="row"><span role="rowheader">{g.name}</span></p>
          {g.cells.map((c) => (
            <div class="cc__row" role="row">
              <span class:list={['cc__k mono', { ph: c.kind === 'ph' }]} role="rowheader">{c.k}</span>
              {c.kind === 'ph'
                ? <span class="cc__cell -ph" role="cell"><span class="nyw mono">{c.v}</span></span>
                : <span class:list={['cc__cell', `-${c.kind}`]} role="cell">{c.href ? <a href={c.href}>{c.v}</a> : c.v}</span>}
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>
</Base>
