---
import Base from '../layouts/Base.astro';
import { u } from '../config/site';
const people = Array.from({ length: 4 }, () => ({ name: '[Name]', role: '[Role]' }));
// the same ground seen from very far away, at dusk: many small groups, the lines as texture
const band = { far: { n: 14, seed: 5 }, dusk: 0.9, tilt: 0.62, zoom: 1, space: 10, kScale: 0.6, clear: '[data-clear]' };
---
<Base page="about" title="About">
  <section class="page-band page-band--left page-band--tall band" data-band={JSON.stringify(band)}>
    <div class="wrap page-band__in"><h1 data-clear>About</h1></div>
  </section>
  <section class="page-body wrap">
    <div class="cols" data-reveal>
      <p class="label">About</p>
      <p class="lead">Corollary Labs is an AI company. <span class="ph">[About — founding story and team, one paragraph]</span></p>
    </div>
    <div class="cols" data-reveal>
      <p class="label ph">[Heading]</p>
      <div>
        <p class="prose-ph">[Paragraph]</p>
        <p class="prose-ph">[Paragraph]</p>
      </div>
    </div>
    <div class="cols" data-reveal id="team">
      <p class="label">Team</p>
      <div>
        <ul class="people">
          {people.map((p, i) => (
            <li class="person">
              <span class="row__n mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="person__name">{p.name}</span>
              <span class="person__role">{p.role}</span>
            </li>
          ))}
        </ul>
        <a class="more" href={u('team/')}>Team</a>
      </div>
    </div>
    <div class="cols" data-reveal>
      <p class="label">Company</p>
      <dl class="facts">
        <div><dt>Entity</dt><dd>[Entity]</dd></div>
        <div><dt>Founded</dt><dd>[Year]</dd></div>
        <div><dt>Location</dt><dd>[City]</dd></div>
        <div><dt>Contact</dt><dd>[Email]</dd></div>
      </dl>
    </div>
  </section>
</Base>
