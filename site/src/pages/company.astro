---
import Base from '../layouts/Base.astro';
import Email from '../components/Email.astro';
import { company, site, research, contact } from '../config/site';
import { u } from '../lib/url';
---
<Base page="company" title={company.title} description={company.about}>
  <section id="about" class="about wrap" data-light="read" data-tone-section="day" aria-labelledby="about-h">
    <div class="about__text" data-tone-probe>
      <h1 id="about-h" class="about__title">{company.title}</h1>
      <p class="about__more ph">{company.aboutMore}</p>
      <dl class="facts">
        <div><dt>Founded</dt><dd class="ph">{site.founded}</dd></div>
        <div><dt>Location</dt><dd class="ph">{site.location}</dd></div>
        <div><dt>Entity</dt><dd class="ph">{site.entity}</dd></div>
        <div><dt>Email</dt><dd><Email /></dd></div>
      </dl>
    </div>
  </section>

  <section id="team" class="team wrap" data-light="read" data-tone-section="day" aria-labelledby="team-h">
    <h2 id="team-h" class="label">Team</h2>
    <ul class="team__list">
      {company.team.map((m) => (
        <li class="member"><span class="member__name ph">{m.name}</span><span class="member__role ph">{m.role}</span></li>
      ))}
    </ul>
    <div class="team__next">
      <a class="link" href={u('/research/')}>{research.title} <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn" href={u('/contact/')}>{contact.title}</a>
    </div>
  </section>
</Base>

<style>
  .about { padding-top: 20vh; padding-bottom: 6vh; }
  .about__text { display: grid; gap: 18px; }
  .about__title { font-size: var(--fs-display); font-weight: 300; line-height: 1.05; letter-spacing: -0.025em; }
  .about__lead { font-size: var(--fs-h3); font-weight: 320; line-height: 1.3; max-width: 28em; }
  .about__more { font-size: var(--fs-lede); max-width: 30em; }
  .facts { margin: 20px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 12rem)); gap: 16px 28px; border-top: 1px solid var(--rule); padding-top: 18px; font-size: var(--fs-small); }
  .facts dt { color: var(--ink-2); }
  .facts dd { margin: 4px 0 0; font-size: 1rem; }
  .team { padding-top: 6vh; padding-bottom: 14vh; }
  .team__list { margin-top: 18px; border-top: 1px solid var(--rule); max-width: 46rem; }
  .member { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding: 14px 0; border-bottom: 1px solid var(--rule); font-size: 1.05rem; }
  .team__next { margin-top: 56px; display: flex; gap: 32px; align-items: center; font-weight: 480; }
  @media (max-width: 759px) { .facts { grid-template-columns: 1fr 1fr; } .about { padding-top: 16vh; } }
</style>
