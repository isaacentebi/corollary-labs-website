---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import { getCollection, render } from 'astro:content';
import { site, url } from '../../config/site';
import '../../styles/essay.css';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: essays[(i + 1) % essays.length], n: essays.length - i } }));
}
const { entry, next, n } = Astro.props;
const { Content, headings, remarkPluginFrontmatter: fm } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
const pad = (x: number) => String(x).padStart(2, '0');
---
<Base page="essay" title={entry.data.title} description={entry.data.dek}>
  <div class="es-progress" aria-hidden="true"><i data-progress></i></div>
  <article class="es">
    <header class="es__head">
      <dl class="es__meta mono">
        <div><dt>Research</dt><dd>{pad(n)}</dd></div>
        <div><dt>Date</dt><dd><time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time></dd></div>
        <div><dt>Reading</dt><dd>{fm.minutesRead} min</dd></div>
        <div><dt>Sections</dt><dd>{pad(sections.length)}</dd></div>
      </dl>
      <h1 class="es__title">{entry.data.title}</h1>
      <p class="es__dek">{entry.data.dek}</p>
      {entry.data.placeholder && <p class="es__flag mono">[Placeholder]</p>}
    </header>

    {sections.length > 0 && (
      <nav class="es__toc mono" aria-label="Contents">
        <p class="es__toc-h">Contents</p>
        <ol>{sections.map((h, i) => <li><a href={`#${h.slug}`} data-toc={h.slug}><span>{pad(i + 1)}</span>{h.text}</a></li>)}</ol>
      </nav>
    )}

    <div class="es__body">
      <Content components={{ Figure, Term }} />
    </div>

    <footer class="es__end">
      <p class="mono es__sign">— {site.name}, {fmt(entry.data.date)}</p>
      {next && next.id !== entry.id && (
        <a class="es__next" href={url(`essays/${next.id}/`)}>
          <span class="mono">Next · Research</span>
          <span class="es__next-t">{next.data.title}</span>
          <span class="es__next-d">{next.data.dek}</span>
        </a>
      )}
    </footer>
  </article>
  <script>
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const body = document.querySelector<HTMLElement>('.es__body');
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
    const heads = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
    const on = () => {
      if (!bar || !body) return;
      const r = body.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / r.height));
      bar.style.transform = `scaleX(${p})`;
      let cur = -1; heads.forEach((h, i) => { if (h.getBoundingClientRect().top < innerHeight * 0.35) cur = i; });
      links.forEach((a, i) => a.classList.toggle('-on', i === cur));
    };
    addEventListener('scroll', on, { passive: true }); on();
  </script>
</Base>
