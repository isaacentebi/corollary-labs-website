---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import Loom from '../../components/Loom.astro';
import { render } from 'astro:content';
import { essayThreads, fmt, pad } from '../../lib/essays';
import '../../styles/essay.css';

export async function getStaticPaths() {
  const list = await essayThreads();
  return list.map((it, i) => ({ params: { slug: it.e.id }, props: { it, next: list[(i + 1) % list.length], all: list } }));
}
const { it, next, all } = Astro.props;
const entry = it.e;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// this essay's thread travels; the others are already in the cloth
const threads = all.map((o) => ({ af: o.af, vc: 7, R: o.e.id === entry.id ? 48 : 0 }));
---
<Base page="essays" title={entry.data.title} description={entry.data.dek}>
  <article class="essay">
    <header class="essay__head">
      <p class="mono essay__kicker"><a href={`${base}essays/`}>Research</a> <span aria-hidden="true">/</span> {pad(it.n)} <span aria-hidden="true">/</span> <time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time> <span aria-hidden="true">/</span> {fm.minutesRead} min</p>
      <h1 class="essay__title">{entry.data.title}</h1>
      <p class="essay__dek">{entry.data.dek}</p>
      {entry.data.placeholder && <p class="mono ph">[Placeholder essay]</p>}
    </header>
    <div class="essay__band"><Loom rows={14} cellCss={4} threads={threads} grow ms={2600} /></div>
    <div class="prose">
      <Content components={{ Figure, Term }} />
    </div>
    <footer class="essay__end">
      {next && next.e.id !== entry.id && (
        <a class="essay__next" href={`${base}essays/${next.e.id}/`}><span class="mono">Next — {pad(next.n)}</span><span class="essay__next-t">{next.e.data.title}</span></a>
      )}
      <a class="lnk mono" href={`${base}essays/`}>All research</a>
    </footer>
  </article>
</Base>
