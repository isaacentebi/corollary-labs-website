---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import { getCollection, render } from 'astro:content';
import { site, u } from '../../config/site';
import { slideSVG } from '../../lib/slides';
import '../../styles/pages.css';
import '../../styles/essay.css';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, i, next: essays[(i + 1) % essays.length], ni: (i + 1) % essays.length } }));
}
const { entry, i, next, ni } = Astro.props;
const { Content, headings, remarkPluginFrontmatter: fm } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base page="essay" title={entry.data.title} description={entry.data.dek}>
  <article class="essay" data-essay>
    <aside class="rail" aria-label="Essay information">
      <div class="rail__in">
        <a class="rail__back t-label link-u" href={u('essays/')}>← Essays</a>
        <svg class="rail__slide" viewBox="0 0 200 200" aria-hidden="true" set:html={slideSVG(entry.id, i % 3)} />
        {sections.length > 0 && (
          <nav class="toc" aria-label="Contents">
            <p class="t-label">Contents</p>
            <ol>
              {sections.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}><i aria-hidden="true"></i><span>{h.text}</span></a></li>)}
            </ol>
          </nav>
        )}
      </div>
    </aside>

    <header class="essay__head">
      <p class="t-label" data-reveal><time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time> · {fm.minutesRead} min · {site.name}</p>
      <h1 class="essay__title t-display" data-reveal>{entry.data.title}</h1>
      <p class="essay__dek" data-reveal style="--rd:0.1s">{entry.data.dek}</p>
      {entry.data.placeholder && <p class="essay__flag t-label" data-reveal style="--rd:0.2s">[Placeholder essay]</p>}
    </header>

    <div class="essay__body" data-essay-body>
      <Content components={{ Figure, Term }} />
    </div>

    <footer class="essay__end">
      {next && next.id !== entry.id && (
        <a class="next" href={u(`essays/${next.id}/`)}>
          <svg class="next__slide" viewBox="0 0 200 200" aria-hidden="true" set:html={slideSVG(next.id, ni % 3)} />
          <span class="t-label">Next essay</span>
          <span class="next__title t-title">{next.data.title}</span>
          <span class="next__dek">{next.data.dek}</span>
        </a>
      )}
    </footer>
  </article>
  <script>
    import { initEssay } from '../../scripts/essay';
    initEssay();
  </script>
</Base>
