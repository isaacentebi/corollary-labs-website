---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import Emblem from '../../components/Emblem.astro';
import { getCollection, render } from 'astro:content';
import { site, href } from '../../config/site';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: essays[(i + 1) % essays.length] } }));
}
const { entry, next } = Astro.props;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base page="essay" theme="paper" title={entry.data.title} description={entry.data.dek}>
  <article class="essay">
    <header class="essay__head cut">
      <Emblem seed={entry.id} n={4} class="essay__mark" />
      <p class="mono essay__meta"><a href={href('essays/')}>Essays</a><span>{fmt(entry.data.date)}</span><span>{fm.minutesRead} min</span></p>
      <h1 class="essay__title">{entry.data.title}</h1>
      <p class="essay__dek">{entry.data.dek}</p>
    </header>
    <div class="essay__body cut">
      <Content components={{ Figure, Term }} />
      <p class="essay__sign mono">{site.author}, {fmt(entry.data.date)}</p>
    </div>
    {next && next.id !== entry.id && (
      <a class="erow erow--next cut" href={href(`essays/${next.id}/`)}>
        <Emblem seed={next.id} class="erow__mark" />
        <span class="erow__title">{next.data.title}</span>
        <span class="erow__date mono">Next essay</span>
      </a>
    )}
  </article>
</Base>
