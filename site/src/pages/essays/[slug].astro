---
import Base from '../../layouts/Base.astro';
import Print from '../../components/Print.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import EssayList from '../../components/EssayList.astro';
import { getCollection, render } from 'astro:content';
import { url, fmtDate } from '../../config/site';
import '../../styles/essay.css';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: essays[(i + 1) % essays.length] } }));
}
const { entry, next } = Astro.props;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
---
<Base page="essays" title={entry.data.title} description={entry.data.dek}>
  <article class="essay">
    <header class="essay__head">
      <p class="essay__meta">
        <a class="ov" href={url('essays/')} data-text="Research">Research</a>
        <span>{fmtDate(entry.data.date)}</span>
        <span>{fm.minutesRead} min</span>
      </p>
      <h1 class="essay__title">{entry.data.title}</h1>
      <p class="essay__dek">{entry.data.dek}</p>
      <Print seed={entry.id} state="after" class="essay__print" base={5} agents={2} />
    </header>
    <div class="essay__body">
      <Content components={{ Figure, Term }} />
    </div>
    {next && next.id !== entry.id && (
      <footer class="essay__next">
        <h2 class="label">Next</h2>
        <EssayList essays={[next]} />
      </footer>
    )}
  </article>
</Base>
