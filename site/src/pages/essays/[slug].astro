---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import { getCollection, render } from 'astro:content';
import { site, u } from '../../config/site';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: essays[(i + 1) % essays.length] } }));
}
const { entry, next } = Astro.props;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base page="essay" title={entry.data.title} description={entry.data.dek}>
  <article class="essay wrap">
    <header class="essay__head">
      <p class="essay__meta mono"><a href={u('essays/')}>Essays</a><span aria-hidden="true">/</span><time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time><span aria-hidden="true">/</span><span>{fm.minutesRead} min</span></p>
      <h1 class="essay__title">{entry.data.title}</h1>
      <p class="essay__dek">{entry.data.dek}</p>
    </header>
    <div class="prose">
      <Content components={{ Figure, Term }} />
    </div>
    <footer class="essay__end">
      <p class="mono">{site.author} / {fmt(entry.data.date)}</p>
      {next && next.id !== entry.id && (
        <a class="next" href={u(`essays/${next.id}/`)}>
          <span class="label">Next essay</span>
          <span class="next__title">{next.data.title}</span>
          <span aria-hidden="true" class="next__arrow">→</span>
        </a>
      )}
    </footer>
  </article>
</Base>
