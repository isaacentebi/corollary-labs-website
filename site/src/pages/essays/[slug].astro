---
import Sheet from '../../layouts/Sheet.astro';
import Band from '../../components/Band.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../config/site';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: essays[(i + 1) % essays.length] } }));
}
const { entry, next } = Astro.props;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
---
<Sheet active="essays" page="essay" title={entry.data.title} description={entry.data.dek}>
  <Band lines={[]} state="plate" short>
    <a class="band__back" href={url('essays/')}>Essays</a>
  </Band>
  <article class="essay">
    <header class="essay__head">
      <p class="essay__meta"><time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time><span>{fm.minutesRead} min</span></p>
      <h1 class="essay__title">{entry.data.title}</h1>
      <p class="essay__dek">{entry.data.dek}</p>
    </header>
    <div class="essay__body prose">
      <Content components={{ Figure, Term }} />
    </div>
    {next && next.id !== entry.id && (
      <a class="next" href={url(`essays/${next.id}/`)}>
        <span class="kicker">Next essay</span>
        <span class="next__title">{next.data.title}</span>
      </a>
    )}
  </article>
</Sheet>
