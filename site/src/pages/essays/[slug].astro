---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import MiniScore from '../../components/MiniScore.astro';
import { getCollection, render } from 'astro:content';
import { u, fmtDate } from '../../config/site';
import '../../styles/essay.css';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: essays[(i + 1) % essays.length] } }));
}
const { entry, next } = Astro.props;
const { Content, headings, remarkPluginFrontmatter: fm } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
const L = 'ABCDEFGHIJKLMNOP';
const marks = sections.map((_, i) => L[i]);
---
<Base page="essays" title={entry.data.title} description={entry.data.dek}>
  <article class="essay">
    <header class="essay__head">
      <div class="part__side"><a class="sect sect--big" href={u('/essays/')}><span class="bigmark">F</span><span class="label">Essays</span></a></div>
      <div class="essay__title">
        <p class="essay__meta"><time datetime={entry.data.date.toISOString()}>{fmtDate(entry.data.date)}</time><span>c. {fm.minutesRead}′</span>{entry.data.placeholder && <span>[Placeholder essay]</span>}</p>
        <h1 class="display"><span data-play>{entry.data.title}</span></h1>
        <p class="essay__dek">{entry.data.dek}</p>
      </div>
      <div class="essay__score">
        <MiniScore class="only-wide ms--play" seed={entry.id} w={1080} h={210} voices={6} stroke={0.95} bracket ruler marks={marks} at={100} vt={`score-${entry.id}`} />
        <MiniScore class="only-narrow ms--play" seed={entry.id} w={520} h={250} voices={6} stroke={0.7} bracket ruler marks={marks} at={100} vt={`score-${entry.id}`} />
      </div>
    </header>

    <div class="essay__body prose" data-body>
      <Content components={{ Figure, Term }} />
    </div>

    <footer class="essay__end">
      <p class="essay__sign">— Corollary Labs, {fmtDate(entry.data.date)}</p>
      {next && next.id !== entry.id && (
        <a class="next" href={u(`/essays/${next.id}/`)}>
          <span class="label">Next essay</span>
          <span class="next__title">{next.data.title}</span>
          <span class="next__score"><MiniScore seed={next.id} w={420} h={96} at={40} vt={`score-${next.id}`} /></span>
        </a>
      )}
    </footer>
  </article>
</Base>
