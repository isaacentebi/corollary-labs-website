---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/url';
import '../../styles/pages.css';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: essays[(i + 1) % essays.length] } }));
}
const { entry, next } = Astro.props;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base page="essay" title={entry.data.title} description={entry.data.dek}>
  <article class="essay wrap">
    <header class="essay-head">
      <p class="essay-head__meta label"><a href={url('essays/')}>Essays</a><span aria-hidden="true">/</span><time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time><span aria-hidden="true">/</span><span>{fm.minutesRead} min</span></p>
      <h1 class="essay-head__title">{entry.data.title}</h1>
      <p class="essay-head__dek">{entry.data.dek}</p>
    </header>
    <div class="essay-body">
      <Content components={{ Figure, Term }} />
    </div>
    <footer class="essay-end">
      {next && next.id !== entry.id && (
        <a class="key essay-next" href={url(`essays/${next.id}/`)}>
          <span><span class="label">Next essay</span><span class="essay-next__title">{next.data.title}</span></span>
          <span class="lamp" aria-hidden="true"></span>
        </a>
      )}
    </footer>
  </article>
</Base>
