---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import Pebble from '../../components/Pebble.astro';
import { getCollection, render } from 'astro:content';
import { site, u } from '../../config/site';
import '../../styles/essay.css';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: essays[(i + 1) % essays.length], index: i } }));
}
const { entry, next, index } = Astro.props;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
// each essay gets its own small arrangement of stones to the right of the title
const sets = [
  [{ x: 0.3, y: -0.04, r: 0.13 }, { x: 0.4, y: 0.1, r: 0.09 }, { x: 0.36, y: -0.2, r: 0.05, rose: 1 }],
  [{ x: 0.34, y: 0.02, r: 0.14 }, { x: 0.25, y: -0.16, r: 0.06, rose: 1 }],
  [{ x: 0.28, y: 0.06, r: 0.1 }, { x: 0.38, y: -0.08, r: 0.12 }, { x: 0.44, y: 0.14, r: 0.07 }],
];
const msets = [
  [{ x: 0.1, y: -0.27, r: 0.12 }, { x: 0.32, y: -0.22, r: 0.08 }, { x: 0.3, y: -0.33, r: 0.045 }],
  [{ x: 0.24, y: -0.26, r: 0.13 }, { x: 0.02, y: -0.3, r: 0.055 }],
  [{ x: -0.06, y: -0.27, r: 0.09 }, { x: 0.18, y: -0.3, r: 0.11 }, { x: 0.37, y: -0.22, r: 0.065 }],
];
const stones = sets[index % sets.length];
const mstones = msets[index % msets.length];
---
<Base page="essay" title={entry.data.title} description={entry.data.dek}>
  <article class="essay">
    <header class="essay-head band" data-band={JSON.stringify({ stones, mstones, clear: '[data-essay-title]' })}>
      <div class="essay-head__in wrap">
        <div class="essay-head__block" data-essay-title>
          <p class="essay-head__meta"><a href={u('essays/')}>Essays</a><span aria-hidden="true">·</span><time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time><span aria-hidden="true">·</span><span>{fm.minutesRead} min</span></p>
          <h1 class="essay-head__title">{entry.data.title}</h1>
          <p class="essay-head__dek">{entry.data.dek}</p>
        </div>
      </div>
      <div class="band__edge"></div>
    </header>

    <div class="essay-body wrap">
      <div class="prose" data-reveal>
        <Content components={{ Figure, Term }} />
      </div>
    </div>

    <footer class="essay-end wrap">
      <p class="essay-end__by">{site.author}, {fmt(entry.data.date)}</p>
      {next && next.id !== entry.id && (
        <a class="next" href={u(`essays/${next.id}/`)}>
          <span class="label">Next essay</span>
          <span class="next__row"><Pebble size={48} seed={index + 11} /><span class="next__title">{next.data.title}</span></span>
        </a>
      )}
    </footer>
  </article>
</Base>
