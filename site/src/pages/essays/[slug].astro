---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import { getCollection, render } from 'astro:content';
import { site, u } from '../../config/site';
import '../../styles/essay.css';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: essays[(i + 1) % essays.length], index: i } }));
}
const { entry, next, index } = Astro.props;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base page="essay" title={entry.data.title} description={entry.data.dek}>
  <article class="essay">
    <header class="essay-head">
      <div class="essay-head__in wrap">
        <div class="essay-head__block" data-essay-title>
          <p class="essay-head__meta"><a href={u('essays/')}>Research</a><span aria-hidden="true">·</span><time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time><span aria-hidden="true">·</span><span>{fm.minutesRead} min</span></p>
          <h1 class="essay-head__title">{entry.data.title}</h1>
          <p class="essay-head__dek">{entry.data.dek}</p>
        </div>
      </div>
    </header>

    <div class="essay-body wrap">
      <div class="prose" data-reveal>
        <Content components={{ Figure, Term }} />
      </div>
    </div>

    <footer class="essay-end wrap">
      <p class="essay-end__by">{site.author}, {fmt(entry.data.date)}</p>
      {next && next.id !== entry.id && (
        <a class="next" href={u(`essays/${next.id}/`)}>
          <span class="label">Next</span>
          <span class="next__title">{next.data.title}</span>
        </a>
      )}
    </footer>
  </article>
</Base>
