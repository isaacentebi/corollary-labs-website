---
// Essay — typeset like a paper: centred title block, abstract (the dek), numbered sections, sidenotes in the margin.
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import { getCollection, render } from 'astro:content';
import { site, u } from '../../config/site';
import '../../styles/essay.css';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: essays[(i + 1) % essays.length] } }));
}
const { entry, next } = Astro.props;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base page="essay" title={entry.data.title} description={entry.data.dek}>
  <article class="essay">
    <header class="essay__head">
      <p class="essay__kicker"><a href={u('essays/')}>Essays</a> · {fmt(entry.data.date)} · {fm.minutesRead} min</p>
      <h1 class="essay__title">{entry.data.title}</h1>
      <p class="essay__by">{site.name}</p>
      {entry.data.placeholder && <p class="essay__flag ph">[Placeholder essay]</p>}
      <div class="essay__abs">
        <h2>Abstract</h2>
        <p>{entry.data.dek}</p>
      </div>
    </header>
    <div class="essay__body prose">
      <Content components={{ Figure, Term }} />
    </div>
    {next && next.id !== entry.id && (
      <a class="essay__next" href={u(`essays/${next.id}/`)}>
        <span class="essay__next-k">Next essay</span>
        <span class="essay__next-t">{next.data.title}</span>
      </a>
    )}
  </article>
</Base>
