---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Term from '../../components/Term.astro';
import PageTitle from '../../components/PageTitle.astro';
import { getCollection, render } from 'astro:content';
import { site, url } from '../../config/site';
import '../../styles/essay.css';

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return essays.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: essays[(i + 1) % essays.length] } }));
}
const { entry, next } = Astro.props;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
---
<Base page="essay" title={entry.data.title} description={entry.data.dek}>
  <div class="readbar" aria-hidden="true"><i data-read></i></div>
  <article class="essay">
    <header class="ehead grid">
      <dl class="ehead__meta">
        <div><dt class="label">Index</dt><dd><a class="textlink" href={url("essays/")}>Essays</a></dd></div>
        <div><dt class="label">Date</dt><dd><time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time></dd></div>
        <div><dt class="label">Length</dt><dd>{fm.minutesRead} min</dd></div>
        <div><dt class="label">By</dt><dd>{site.author}</dd></div>
      </dl>
      <PageTitle text={entry.data.title} class="ehead__title" />
      <p class="ehead__dek lead">{entry.data.dek}</p>
    </header>
    <div class="ebody grid">
      <div class="prose">
        <Content components={{ Figure, Term }} />
      </div>
    </div>
    {next && next.id !== entry.id && (
      <nav class="enext grid" aria-label="Next essay">
        <span class="label enext__l">Next</span>
        <a class="enext__a" href={url(`essays/${next.id}/`)}><span class="biglink__m" aria-hidden="true"></span>{next.data.title}</a>
      </nav>
    )}
  </article>
  <script>
    const bar = document.querySelector<HTMLElement>('[data-read]');
    const body = document.querySelector<HTMLElement>('.prose');
    if (bar && body) {
      let raf = 0;
      const upd = () => {
        raf = 0;
        const r = body.getBoundingClientRect();
        const t = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / r.height));
        bar.style.transform = `scaleY(${t})`;
      };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(upd); }, { passive: true });
      upd();
    }
  </script>
</Base>
