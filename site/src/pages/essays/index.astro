---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';
import '../../styles/pages.css';
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base page="essays" title="Essays">
  <div class="wrap page">
    <header class="page-head">
      <h1 class="h-page">Essays</h1>
      <p class="page-head__note ph">[One line on what the essays cover]</p>
    </header>
    <ul class="elist">
      {essays.map((e) => (
        <li>
          <a href={url(`essays/${e.id}/`)}>
            <span class="lamp" aria-hidden="true"></span>
            <time class="elist__date" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
            <span class="elist__title">{e.data.title}</span>
            <span class="elist__dek">{e.data.dek}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
