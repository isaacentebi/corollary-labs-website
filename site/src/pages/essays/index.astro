---
import Base from '../../layouts/Base.astro';
import MiniScore from '../../components/MiniScore.astro';
import { getCollection, render } from 'astro:content';
import { u, fmtDate } from '../../config/site';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const rows = await Promise.all(essays.map(async (e) => ({ e, fm: (await render(e)).remarkPluginFrontmatter })));
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base page="essays" title="Essays" description="[Meta description]">
  <header class="page-head">
    <div class="part__side"><span class="label">{pad(rows.length)}</span></div>
    <h1>Essays</h1>
  </header>
  <section class="part" style="border-top: 0; padding-top: 0;">
    <div class="part__side"></div>
    <div class="part__body">
      <ol class="index">
        {rows.map(({ e, fm }, i) => (
          <li>
            <a class="irow" href={u(`/essays/${e.id}/`)}>
              <span class="irow__n">{pad(rows.length - i)}</span>
              <span class="irow__score"><MiniScore seed={e.id} w={420} h={96} voices={4} /></span>
              <span class="irow__main"><span class="irow__title"><span>{e.data.title}</span></span><span class="irow__dek">{e.data.dek}</span></span>
              <span class="irow__meta"><time datetime={e.data.date.toISOString()}>{fmtDate(e.data.date)}</time><span>c. {fm.minutesRead}′</span></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
