---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { u } from '../../config/site';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const pad = (n: number) => String(n).padStart(2, '0');
// one stone per essay, in a line inside one contour; hovering an essay warms its stone and the others make room
const kinds = [{ sq: 0.1 }, { tone: 1, gloss: 0.8 }, { sq: 0.6, a: 1.3 }, { gloss: 0.4 }, { tone: 0.9 }];
const stones = essays.map((_, i) => ({ x: 0.12 + i * 0.12, y: (i % 2 ? 0.05 : -0.04), r: [0.11, 0.07, 0.13, 0.06, 0.09][i % 5], ...kinds[i % kinds.length] }));
const mstones = essays.map((_, i) => ({ x: -0.28 + i * 0.26, y: -0.3 + (i % 2 ? 0.04 : 0), r: [0.12, 0.08, 0.13, 0.07, 0.1][i % 5] }));
---
<Base page="essays" title="Essays">
  <section class="page-band page-band--left band" data-band={JSON.stringify({ stones, mstones, group: true, drag: true, clear: '[data-clear]', hover: '[data-essay-row]', hoverMode: 'part' })}>
    <div class="wrap page-band__in"><h1 data-clear>Essays</h1></div>
    <div class="band__edge"></div>
  </section>
  <section class="page-body wrap">
    <ol class="essay-list" data-reveal>
      {essays.map((e, i) => (
        <li>
          <a class="essay-row" href={u(`essays/${e.id}/`)} data-essay-row>
            <span class="row__n mono">{pad(i + 1)}</span>
            <span class="essay-row__title">{e.data.title}</span>
            <span class="essay-row__dek">{e.data.dek}</span>
            <span class="essay-row__meta"><time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time></span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
