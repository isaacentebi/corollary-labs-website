---
import Base from '../../layouts/Base.astro';
import Emblem from '../../components/Emblem.astro';
import { getCollection } from 'astro:content';
import { href } from '../../config/site';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base page="essays" title="Essays">
  <header class="phead">
    <h1 class="phead__t cut">Essays</h1>
    <p class="phead__d cut ph">[Essays — one sentence]</p>
  </header>
  <ol class="elist elist--full">
    {essays.map((e) => (
      <li>
        <a class="erow erow--full cut" href={href(`essays/${e.id}/`)}>
          <Emblem seed={e.id} n={4} class="erow__mark" />
          <span class="erow__title">{e.data.title}</span>
          <span class="erow__dek">{e.data.dek}</span>
          <time class="erow__date mono" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
        </a>
      </li>
    ))}
  </ol>
</Base>
