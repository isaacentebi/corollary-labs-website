---
import Base from '../../layouts/Base.astro';
import Pebble from '../../components/Pebble.astro';
import { getCollection } from 'astro:content';
import { u } from '../../config/site';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
// one stone per essay, resting in a loose line to the right of the heading; hovering an essay warms its stone
const stones = essays.map((_, i) => ({ x: 0.16 + i * 0.12, y: (i % 2 ? 0.1 : -0.06) + i * 0.02, r: 0.11 - i * 0.012 }));
const mstones = essays.map((_, i) => ({ x: -0.22 + i * 0.24, y: -0.3 + (i % 2 ? 0.05 : 0), r: 0.13 - i * 0.012 }));
---
<Base page="essays" title="Essays">
  <section class="page-band page-band--left band" data-band={JSON.stringify({ stones, mstones, clear: '[data-clear]', hover: '[data-essay-row]' })}>
    <div class="wrap page-band__in"><h1 data-clear>Essays</h1></div>
    <div class="band__edge"></div>
  </section>
  <section class="page-body wrap">
    <ol class="essay-list" data-reveal>
      {essays.map((e, i) => (
        <li>
          <a class="essay-row" href={u(`essays/${e.id}/`)} data-essay-row>
            <Pebble size={48} seed={i + 3} />
            <span class="essay-row__title">{e.data.title}</span>
            <span class="essay-row__dek">{e.data.dek}</span>
            <span class="essay-row__meta"><time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time></span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
