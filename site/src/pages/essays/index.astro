---
import Sheet from '../../layouts/Sheet.astro';
import Band from '../../components/Band.astro';
import { getCollection } from 'astro:content';
import { url, copy } from '../../config/site';
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
---
<Sheet active={null} page="essays" title="Research">
  <Band lines={['Research']} state="front" fit={5.3} />
  <section class="page">
    <p class="lede">{copy.researchIntro}</p>
    <ol class="rows rows--index">
      {essays.map((e) => (
        <li>
          <a class="row" href={url(`essays/${e.id}/`)}>
            <time class="row__date" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
            <span class="row__title">{e.data.title}</span>
            <span class="row__dek">{e.data.dek}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Sheet>
