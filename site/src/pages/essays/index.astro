---
// Essays — set as a journal's table of contents.
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { u } from '../../config/site';
import '../../styles/pages.css';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const rows = await Promise.all(essays.map(async (e) => ({ e, fm: (await render(e)).remarkPluginFrontmatter })));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base page="essays" title="Essays" description="Essays — Corollary Labs">
  <article class="page">
    <p class="page__kicker">{essays.length} essays</p>
    <h1 class="page__title">Essays</h1>
    <div class="rule"></div>
    <ol class="toc">
      {rows.map(({ e, fm }, i) => (
        <li class="toc__row">
          <a href={u(`essays/${e.id}/`)} class="toc__link">
            <span class="toc__n">{essays.length - i}</span>
            <span class="toc__main">
              <span class="toc__title">{e.data.title}</span>
              <span class="toc__dek">{e.data.dek}</span>
            </span>
            <span class="toc__meta">
              <time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
              <span>{fm.minutesRead} min</span>
              {e.data.placeholder && <span class="ph">[Placeholder]</span>}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </article>
</Base>
