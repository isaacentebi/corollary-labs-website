---
import Base from '../../layouts/Base.astro';
import Woven from '../../components/Woven.astro';
import Drawdown from '../../components/Drawdown.astro';
import { getCollection } from 'astro:content';
import { hash } from '../../lib/weave';
import '../../styles/home.css';
import '../../styles/pages.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
---
<Base title="Essays" page="essays">
  <div class="title" style="--tw: 520px"><h1>Essays</h1><Woven text="Essays" /></div>
  <section class="wrap">
    <ol class="elist elist--index">
      {essays.map((e, n) => (
        <li>
          <a class="erow" href={`${base}essays/${e.id}/`}>
            <span class="erow__sw"><Drawdown cols={40} rows={6} axis={6 + Math.floor(hash(e.id) * 28)} cy={3} radius={10 + n * 7} seed={e.id} /></span>
            <span class="erow__main"><span class="erow__t">{e.data.title}</span><span class="erow__dek">{e.data.dek}</span></span>
            <time class="erow__d mono" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
