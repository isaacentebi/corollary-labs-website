---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { u } from '../../config/site';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const pad = (n: number) => String(n).padStart(2, '0');
// one stone per essay, level with its row, all inside one contour that runs down beside the list;
// hovering an essay warms its stone a little and the others make room
const kinds = [{ sq: 0.1 }, { tone: 1, gloss: 0.8 }, { sq: 0.6, a: 1.3 }, { gloss: 0.4 }, { tone: 0.9 }];
const stones = essays.map((_, i) => ({ x: [-0.06, 0.08, -0.02, 0.1, -0.08][i % 5], y: 0, r: [0.11, 0.07, 0.13, 0.06, 0.09][i % 5], ...kinds[i % kinds.length] }));
---
<Base page="essays" title="Research">
  <section class="essays-page wrap">
    <h1 class="page-title" data-reveal>Research</h1>
    <div class="essays-grid">
      <ol class="essay-list" data-reveal>
        {essays.map((e, i) => (
          <li>
            <a class="essay-row" href={u(`essays/${e.id}/`)} data-essay-row>
              <span class="row__n mono">{pad(i + 1)}</span>
              <span class="essay-row__title">{e.data.title}</span>
              <span class="essay-row__dek">{e.data.dek}</span>
              <span class="essay-row__meta"><time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time></span>
            </a>
          </li>
        ))}
      </ol>
      <div class="essays-field band" data-band={JSON.stringify({ stones, group: true, drag: true, hover: '[data-essay-row]', hoverMode: 'part', anchor: '[data-essay-row]', moat: 90, pad: 26 })} aria-hidden="true"></div>
    </div>
  </section>
</Base>
