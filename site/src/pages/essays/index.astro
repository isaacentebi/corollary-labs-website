---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../config/site';
import '../../styles/pages.css';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const rows = await Promise.all(essays.map(async (e) => {
  const r = await render(e);
  return { e, fm: r.remarkPluginFrontmatter, sections: r.headings.filter((h) => h.depth === 2).length, notes: (e.body?.match(/^\[\^\w+\]:/gm) || []).length };
}));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base page="essays" title="Essays" description="Essays by Corollary Labs.">
  <section class="page">
    <header class="ph-row reveal">
      <p class="ph-row__n mono">01</p>
      <h1 class="ph-row__t">Essays</h1>
      <p class="ph-row__m mono"><span><b>Table 2.</b> Essays</span><span>{pad(rows.length)} rows</span></p>
    </header>
    <table class="tb ix" data-sortable>
      <caption class="mono reveal">Sort by any column heading.</caption>
      <thead class="mono">
        <tr>
          <th class="num"><button type="button" data-sort="n" data-type="num">No.</button></th>
          <th><button type="button" data-sort="title">Title</button></th>
          <th class="-hide-s"><button type="button" data-sort="date" data-type="num">Date</button></th>
          <th class="-hide-s"><button type="button" data-sort="sections" data-type="num">Sections</button></th>
          <th class="-hide-s"><button type="button" data-sort="notes" data-type="num">Notes</button></th>
          <th class="num"><button type="button" data-sort="min" data-type="num">Min.</button></th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ e, fm, sections, notes }, i) => (
          <tr class="reveal" data-n={rows.length - i} data-title={e.data.title} data-date={+e.data.date} data-sections={sections} data-notes={notes} data-min={fm.minutesRead}>
            <td class="num mono ix__n">{pad(rows.length - i)}</td>
            <td><a class="ix__a" href={url(`essays/${e.id}/`)}><span class="ix__t">{e.data.title}</span><span class="ix__d">{e.data.dek}</span>{e.data.placeholder && <span class="ix__ph mono">[Placeholder essay]</span>}</a></td>
            <td class="mono -hide-s"><time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time></td>
            <td class="mono -hide-s"><span class="ix__cells" aria-label={`${sections} sections`}>{Array.from({ length: sections }, () => <i />)}</span>{pad(sections)}</td>
            <td class="mono -hide-s"><span class="ix__cells" aria-label={`${notes} notes`}>{Array.from({ length: notes }, () => <i />)}</span>{pad(notes)}</td>
            <td class="num mono">{pad(fm.minutesRead)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
  <script>
    const t = document.querySelector<HTMLTableElement>('[data-sortable]');
    if (t) {
      const body = t.tBodies[0];
      let key = 'n', dir = -1;
      t.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((b) => b.addEventListener('click', () => {
        const k = b.dataset.sort!; const num = b.dataset.type === 'num';
        dir = k === key ? -dir : num ? -1 : 1; key = k;
        const rows = Array.from(body.rows);
        rows.sort((a, c) => {
          const x = a.dataset[k]!, y = c.dataset[k]!;
          return (num ? +x - +y : x.localeCompare(y)) * dir;
        });
        rows.forEach((r) => body.appendChild(r));
        t.querySelectorAll('[data-sort]').forEach((o) => o.removeAttribute('aria-sort'));
        b.setAttribute('aria-sort', dir > 0 ? 'ascending' : 'descending');
      }));
    }
  </script>
</Base>
