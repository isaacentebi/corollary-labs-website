---
import Base from '../../layouts/Base.astro';
import EssayList from '../../components/EssayList.astro';
import { getCollection, render } from 'astro:content';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const rows = await Promise.all(essays.map(async (e) => ({ e, min: (await render(e)).remarkPluginFrontmatter.minutesRead as number })));
---
<Base page="essays" title="Essays">
  <section class="page">
    <header class="page__head">
      <h1 class="display">Essays</h1>
      <span class="t-label ph">{String(rows.length).padStart(2, '0')}</span>
    </header>
    <EssayList rows={rows} big />
  </section>
</Base>
