---
import Base from '../../layouts/Base.astro';
import InlineCurve from '../../components/InlineCurve.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/index.css';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const rows = await Promise.all(essays.map(async (e) => ({ e, fm: (await render(e)).remarkPluginFrontmatter })));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).replaceAll('/', '.');
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base page="index" title="Essays" description="Essays by Corollary Labs on how new technology spreads.">
  <section class="index o-container" aria-labelledby="index-title">
    <header class="index-band" aria-labelledby="index-title">
      <canvas class="field index-band__field" data-field="index" aria-hidden="true"></canvas>
      <h1 class="u-sr" id="index-title">Essays</h1>
      <span class="index-band__count t-label" aria-hidden="true" data-reveal="scramble">{String(rows.length).padStart(2, '0')} essays</span>
    </header>
    <div class="rule" data-reveal="rule"></div>
    <ol class="index-list" data-reveal="rows">
      {rows.map(({ e, fm }, i) => (
        <li>
          <a class="index-row" href={`/essays/${e.id}/`} data-shuffle-hover>
            <span class="index-row__n t-label">{pad(rows.length - i)}</span>
            <time class="index-row__date t-label" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
            <span class="index-row__main">
              <span class="index-row__title"><span class="index-row__glyph" aria-hidden="true"><InlineCurve progress={[0.2, 0.5, 0.8][i % 3]} /></span><span data-shuffle-target>{e.data.title}</span></span>
              <span class="index-row__dek">{e.data.dek}</span>
            </span>
            <span class="index-row__time t-label">{fm.minutesRead} min</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
