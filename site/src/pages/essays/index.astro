---
import Base from '../../layouts/Base.astro';
import EssayList from '../../components/EssayList.astro';
import Print from '../../components/Print.astro';
import { getCollection } from 'astro:content';
import { essaysPrint } from '../../lib/parts';
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base page="essays" title="Essays" description="[Essays — meta description]">
  <section class="page">
    <header class="cover">
      <Print parts={essaysPrint(essays.map((e) => e.id))} state="after" class="cover__print" pad={4} />
      <h1 class="cover__title">Essays</h1>
    </header>
    <div class="page__body">
      <p class="lede">[Essays — one sentence on what we write about]</p>
    </div>
    <div class="essays-list">
      <EssayList essays={essays} big />
    </div>
  </section>
</Base>
<style>
  .essays-list { grid-column: 1 / -1; margin-top: clamp(24px, 5vh, 56px); }
</style>
