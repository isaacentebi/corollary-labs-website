---
// A static drawdown: every cell is one crossing, drawn as the thread that lies on top.
// Cells within the front (|dx| + |dy| < radius, Manhattan: change travels along threads)
// take the rewoven structure around the new thread at column `axis`; the rest keep the ground satin.
import { groundUp, rewovenUp, hash } from '../lib/weave';
interface Props { cols: number; rows: number; axis?: number | null; cy?: number; radius?: number; seed?: string; label?: string; class?: string }
const { cols, rows, axis = null, cy = Math.floor(rows / 2), radius = 0, seed = 'x', label, class: cls } = Astro.props;
const cells: string[] = [];
const ragged = (n: number) => 1 + 0.6 * hash(seed + ':' + n);
const C = cols + (axis === null ? 0 : 1);
for (let i = 0; i < rows; i++) {
  for (let c = 0; c < C; c++) {
    const isAxis = axis !== null && c === axis;
    const j = axis !== null && c > axis ? c - 1 : c; // cloth column: the new thread is inserted, nothing removed
    const dx = axis === null ? 0 : Math.abs(c - axis);
    const dy = i - cy;
    const reached = axis !== null && (dx * ragged(i) + Math.abs(dy) * 1.7 * ragged(1000 + j)) < radius;
    const up = isAxis || reached ? rewovenUp(dx, dy) : groundUp(i, j);
    const k = isAxis ? (up ? 'a' : 'f') : up ? 'w' : 'f';
    cells.push(up
      ? `<rect class="${k}" x="${c + 0.12}" y="${i}" width="0.76" height="1"/>`
      : `<rect class="${k}" x="${c}" y="${i + 0.12}" width="1" height="0.76"/>`);
  }
}
---
<svg class:list={['dd', cls]} viewBox={`0 0 ${C} ${rows}`} preserveAspectRatio="xMidYMid meet" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} shape-rendering="crispEdges">
  <rect class="g" x="0" y="0" width={C} height={rows} />
  <Fragment set:html={cells.join('')} />
</svg>
<style>
  .dd { width: 100%; height: auto; }
  .dd :global(.g) { fill: var(--gap); }
  .dd :global(.w) { fill: var(--warp-2); }
  .dd :global(.f) { fill: var(--weft-1); }
  .dd :global(.a) { fill: var(--saffron); }
</style>
