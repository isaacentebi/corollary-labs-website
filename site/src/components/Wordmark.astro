---
// The logo: the name, with one new column set between its two words.
import { url } from '../config/site';
interface Props { href?: string | null }
const { href = url() } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag class="wm" href={href ?? undefined} aria-label="Corollary Labs, home">Corollary<i class="wm__m" aria-hidden="true"></i>Labs</Tag>
