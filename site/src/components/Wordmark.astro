---
import { site } from '../config/site';
interface Props { href?: string; class?: string; size?: string }
const { href = '/', class: cls = '', size } = Astro.props;
// Seven dots on a logistic path: the adoption front. Built in code, animated by scripts/wordmark.ts.
const dots = Array.from({ length: 7 }, (_, i) => {
  const x = 2 + i * 6;
  const y = 13.5 - 11 / (1 + Math.exp(-(i - 3.2) * 1.35));
  return { x: +x.toFixed(2), y: +y.toFixed(2) };
});
---
<a href={href} class:list={['wordmark', cls]} data-wordmark aria-label={`${site.name} — home`} style={size ? `font-size:${size}` : undefined}>
  <svg class="wordmark__glyph" viewBox="0 0 40 16" aria-hidden="true">
    {dots.map((d, i) => (
      <circle cx={d.x} cy={d.y} r="1.9" data-i={i} fill={i < 5 ? 'var(--ink)' : 'none'} stroke={i < 5 ? 'none' : 'var(--ink-3)'} stroke-width="0.9" />
    ))}
  </svg>
  <span class="wordmark__word" data-shuffle>{site.word}</span><span class="wordmark__tag">{site.tag}</span>
</a>
