---
// The mark: a gauge whose needle has left its old set point (the short tick at 12),
// with a signal-coloured hub. An equilibrium that has moved.
interface Props { class?: string }
const { class: cls = 'brand__mark' } = Astro.props;
---
<svg class={cls} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="8" fill="#1c1d1f" />
  <circle cx="16" cy="16" r="10" fill="none" stroke="#dcdad4" stroke-opacity=".32" stroke-width="1.2" />
  <path d="M16 4.2 V8" stroke="#dcdad4" stroke-width="1.6" stroke-linecap="round" stroke-opacity=".55" />
  <path d="M14.2 17.2 L23.4 10.9" stroke="#dcdad4" stroke-width="2.1" stroke-linecap="round" />
  <circle cx="16" cy="16" r="2.9" fill="#f2bf1b" />
</svg>
