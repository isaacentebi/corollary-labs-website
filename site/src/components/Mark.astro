---
// Logo mark: a square, a bar across it, and a small cadmium bar arriving from outside.
---
<svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
  <rect class="m-sq" x="-7" y="-7" width="14" height="14" fill="var(--chalk)" />
  <rect class="m-bar" x="-17" y="-1.4" width="34" height="2.8" fill="var(--haze)" />
  <rect class="m-ag" x="-5.5" y="-1.3" width="11" height="2.6" fill="var(--cad)" />
</svg>
