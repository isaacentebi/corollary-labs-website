---
// The mark: a service core with one unit plugged into it, drawn in axonometric.
interface Props { size?: number; class?: string }
const { size = 28, class: cls = '' } = Astro.props;
---
<svg class={`mark ${cls}`} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
    <path d="M7 7v18a4.5 2.2 0 0 0 9 0V7" fill="var(--night)" />
    <ellipse cx="11.5" cy="7" rx="4.5" ry="2.2" fill="var(--night)" />
    <path d="M11.5 11.5v13" stroke-width="1" opacity=".45" />
  </g>
  <g stroke="var(--lamp-edge)" stroke-width=".9" stroke-linejoin="round">
    <path d="M16 13.2 L23.5 9.4 L27.5 11.4 L20 15.2Z" fill="var(--lamp-hi)" />
    <path d="M16 13.2 L20 15.2 L20 21.4 L16 19.4Z" fill="var(--lamp-lo)" />
    <path d="M20 15.2 L27.5 11.4 L27.5 17.6 L20 21.4Z" fill="var(--lamp)" />
    <ellipse cx="23.75" cy="16.4" rx="1.45" ry="1.7" transform="rotate(-27 23.75 16.4)" fill="var(--night)" stroke="none" />
  </g>
</svg>
