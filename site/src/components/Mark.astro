---
// The mark: four Truchet tiles whose inner arcs close into one circle. Hover turns every tile a quarter:
// the circle opens into four corner arcs (same tiles, rewired). One arc carries the accent.
interface Props { size?: number; class?: string }
const { size = 28, class: cls = '' } = Astro.props;
const S = 50, h = 25;
const tiles = [ [0, 0, 2], [1, 0, 3], [1, 1, 0], [0, 1, 1] ];
const arc = (x: number, y: number) => ({
  a: `M${x + h} ${y}A${h} ${h} 0 0 1 ${x} ${y + h}`,
  b: `M${x + h} ${y + S}A${h} ${h} 0 0 1 ${x + S} ${y + h}`,
});
---
<svg class={`mark ${cls}`} viewBox="-6 -6 112 112" width={size} height={size} aria-hidden="true">
  {tiles.map(([i, j, k], n) => {
    const x = i * S, y = j * S, p = arc(x, y);
    return (
      <g transform={`rotate(${k * 90} ${x + h} ${y + h})`}>
        <g class="mark__t" style={`transform-origin:${x + h}px ${y + h}px;--d:${n * 40}ms`}>
          <path d={p.a} class={n === 2 ? 'mark__acid' : ''} />
          <path d={p.b} />
        </g>
      </g>
    );
  })}
</svg>
