---
// The mark: a dial whose needle has moved off its old set point (the faint tick at 12),
// with a signal-coloured hub. One idea: an equilibrium that has moved.
interface Props { class?: string; face?: boolean }
const { class: cls = 'brand__mark', face = true } = Astro.props;
---
<svg class={cls} viewBox="0 0 32 32" aria-hidden="true">
  {face && <rect width="32" height="32" rx="8" fill="#1c1d1f" />}
  <circle cx="16" cy="16" r="9.5" fill="none" stroke={face ? '#dcdad4' : 'currentColor'} stroke-width="1.5" />
  <path d="M16 3.8 V6.4" stroke={face ? '#dcdad4' : 'currentColor'} stroke-width="1.4" stroke-linecap="round" opacity=".45" />
  <path d="M16 16 L22.6 11.4" stroke={face ? '#dcdad4' : 'currentColor'} stroke-width="2" stroke-linecap="round" />
  <circle cx="16" cy="16" r="2.8" fill="#f2bf1b" />
</svg>
