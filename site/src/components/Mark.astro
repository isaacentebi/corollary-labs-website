---
// The mark: an 11 × 11 drawdown. The centre thread is new (saffron); around it the cloth is
// rewoven as block damask, by the same rules as the rest of the site.
import { rewovenUp } from '../lib/weave';
interface Props { size?: number }
const { size = 28 } = Astro.props;
const N = 11, M = 5;
const rects: string[] = [];
for (let i = 0; i < N; i++) for (let c = 0; c < N; c++) {
  const up = rewovenUp(Math.abs(c - M), i - M);
  const cls = c === M ? (up ? 'a' : 'f') : up ? 'w' : 'f';
  rects.push(`<rect class="${cls}" x="${c}" y="${i}" width="1" height="1"/>`);
}
---
<svg class="mark" width={size} height={size} viewBox={`0 0 ${N} ${N}`} aria-hidden="true" shape-rendering="crispEdges"><Fragment set:html={rects.join('')} /></svg>
<style>
  .mark :global(.w) { fill: #232326; }
  .mark :global(.f) { fill: #ebe9e3; }
  .mark :global(.a) { fill: #f2a93b; }
  .mark { outline: 1px solid #232326; outline-offset: -0.5px; }
</style>
