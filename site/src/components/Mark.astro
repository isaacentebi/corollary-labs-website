---
// The mark: three level sets of the summed distance to three points (a 3-ellipse).
// The innermost is almost a triangle, the outer ones relax towards a circle: one shape deformed continuously.
// A single rose point sits at one of the foci.
import { ringPath, type Pt } from '../lib/nellipse';
interface Props { size?: number; class?: string }
const { size = 28, class: cls = '' } = Astro.props;
const foci: Pt[] = [[9.6, 20.2], [22.8, 19.4], [15.4, 8.6]];
const rings = [23.4, 29.5, 37.5];
---
<svg class={`mark ${cls}`} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" data-mark>
  {rings.map((c, i) => <path d={ringPath(foci, c, 72)} class={`mark__ring mark__ring--${i}`} />)}
  <circle cx={foci[1][0] - 1.2} cy={foci[1][1] - 0.6} r="2.1" class="mark__dot mark__dot--rose" />
</svg>
