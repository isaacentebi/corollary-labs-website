---
// The logo: a solid box with two inputs and two outputs; the upper output is returned to the upper input.
import { site, u } from '../config/site';
interface Props { size?: 'sm' | 'lg'; link?: boolean }
const { size = 'sm', link = true } = Astro.props;
const Tag = link ? 'a' : 'div';
---
<Tag class:list={['mark', `-${size}`]} href={link ? u('') : undefined} aria-label={link ? `${site.name}, home` : undefined}>
  <svg viewBox="0 0 64 40" aria-hidden="true">
    <path d="M0 30 H22 M42 30 H64" fill="none" stroke="currentColor" stroke-width="3.2" />
    <path class="mark__loop" d="M42 21 H50 Q56 21 56 15 V9 Q56 4 50 4 H14 Q8 4 8 9 V15 Q8 21 14 21 H22" fill="none" stroke="currentColor" stroke-width="3.2" />
    <rect x="22" y="15" width="20" height="23" fill="currentColor" />
  </svg>
  <span>{site.name}</span>
</Tag>
