---
// The mark: one cut strip (the organisation) overprinted by one disc (an agent). Their
// overlap prints a third colour neither ink has on its own.
import { INK } from '../lib/parts';
interface Props { size?: number; class?: string }
const { size = 28, class: cls = '' } = Astro.props;
// drawn clean (no wear) so it holds at 16px
const strip = 'M-15.5 -3.4H15.5L13.2 3.4H-15.5Z M-11.2 0a1.35 1.35 0 1 0 2.7 0a1.35 1.35 0 1 0 -2.7 0Z M-3.4 0a1.35 1.35 0 1 0 2.7 0a1.35 1.35 0 1 0 -2.7 0Z M5.6 0a1.35 1.35 0 1 0 2.7 0a1.35 1.35 0 1 0 -2.7 0Z';
const disc = 'M-8.4 0a8.4 8.4 0 1 0 16.8 0a8.4 8.4 0 1 0 -16.8 0Z M-1.5 0a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0Z';
---
<svg class:list={['mark', cls]} width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <path class="mark__s" d={strip} fill={INK.c} fill-rule="evenodd" transform="translate(18 23) rotate(-34)" />
  <path class="mark__d" d={disc} fill={INK.m} fill-rule="evenodd" transform="translate(26.5 14.5)" />
</svg>
