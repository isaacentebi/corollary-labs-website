---
// The mark: the string diagram of a trace. A black box f with two inputs and two outputs; the upper output is
// returned to the upper input (Tr f). Solid box = the black box and the end-of-proof sign.
import { site, u } from '../config/site';
interface Props { size?: 'sm' | 'lg'; link?: boolean }
const { size = 'sm', link = true } = Astro.props;
const Tag = link ? 'a' : 'div';
---
<Tag class:list={['mark', `-${size}`]} href={link ? u('') : undefined} aria-label={link ? `${site.name}, home` : undefined}>
  <svg viewBox="0 0 60 40" aria-hidden="true">
    <path d="M0 29 H21 M39 29 H60" fill="none" stroke="currentColor" stroke-width="2" />
    <path class="mark__loop" d="M39 19 H45 Q50 19 50 14 V8 Q50 3 45 3 H15 Q10 3 10 8 V14 Q10 19 15 19 H21" fill="none" stroke="currentColor" stroke-width="2" />
    <rect x="21" y="13" width="18" height="23" fill="currentColor" />
  </svg>
  <span>{site.name}</span>
</Tag>
