---
// A title woven as damask: the letters are weft-faced satin, the ground warp-faced satin,
// the same two threads throughout. One saffron warp runs through the label.
import { bitmap, groundUp, figureUp, hash } from '../lib/weave';
interface Props { text: string; k?: number; margin?: number }
const { text, k = 4, margin = 6 } = Astro.props;
const bm = bitmap(text);
const W = bm.w * k + margin * 2, H = bm.h * k + margin * 2;
const id = 'wv-' + text.toLowerCase().replace(/[^a-z]/g, '') + '-' + k;
const clip: string[] = [];
for (let y = 0; y < bm.h; y++) {
  let x = 0;
  while (x < bm.w) {
    if (!bm.on(x, y)) { x++; continue; }
    let e = x; while (e < bm.w && bm.on(e, y)) e++;
    clip.push(`<rect x="${margin + x * k}" y="${margin + y * k}" width="${(e - x) * k}" height="${k}"/>`);
    x = e;
  }
}
const tile = (fn: (i: number, j: number) => boolean) => {
  let s = '';
  for (let i = 0; i < 8; i++) for (let j = 0; j < 8; j++) s += fn(i, j)
    ? `<rect class="w" x="${j + 0.1}" y="${i}" width="0.8" height="1"/>`
    : `<rect class="f" x="${j}" y="${i + 0.1}" width="1" height="0.8"/>`;
  return s;
};
// the new thread runs in a gap column between letters, chosen from the text
const gaps: number[] = [];
for (let x = 0; x < bm.w; x++) { let any = false; for (let y = 0; y < bm.h; y++) any ||= bm.on(x, y); if (!any) gaps.push(x); }
const gx = gaps.length ? gaps[Math.floor(hash(text) * gaps.length)] : -1;
const ac = gx >= 0 ? margin + gx * k + Math.floor(k / 2) : W - 2;
let accent = '';
for (let i = 0; i < H; i++) accent += groundUp(i, ac)
  ? `<rect class="a" x="${ac + 0.1}" y="${i}" width="0.8" height="1"/>`
  : `<rect class="f" x="${ac}" y="${i + 0.1}" width="1" height="0.8"/>`;
---
<svg class="woven" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={text} shape-rendering="crispEdges">
  <defs>
    <pattern id={`${id}-g`} width="8" height="8" patternUnits="userSpaceOnUse"><rect width="8" height="8" class="gap"/><Fragment set:html={tile(groundUp)} /></pattern>
    <pattern id={`${id}-f`} width="8" height="8" patternUnits="userSpaceOnUse"><rect width="8" height="8" class="gap"/><Fragment set:html={tile(figureUp)} /></pattern>
    <clipPath id={`${id}-c`}><Fragment set:html={clip.join('')} /></clipPath>
  </defs>
  <rect width={W} height={H} fill={`url(#${id}-g)`} />
  <rect width={W} height={H} fill={`url(#${id}-f)`} clip-path={`url(#${id}-c)`} />
  <rect x={ac} y="0" width="1" height={H} class="gap" />
  <Fragment set:html={accent} />
</svg>
<style>
  .woven :global(.gap) { fill: var(--gap); }
  .woven :global(.w) { fill: var(--warp-2); }
  .woven :global(.f) { fill: var(--weft-1); }
  .woven :global(.a) { fill: var(--saffron); }
</style>
