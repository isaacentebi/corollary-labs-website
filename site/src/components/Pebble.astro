---
// A small pebble (the same shape rule as the stones in the shader) resting on its shadow.
// On hover it warms to rose and rings open around it (styles in global.css).
import { smoothClosed, type Pt } from '../lib/nellipse';
interface Props { size?: number; seed?: number }
const { size = 40, seed = 0 } = Astro.props;
const rot = (seed * 1.7) % Math.PI;
const asp = 1.12 + ((seed * 37) % 10) / 60;
const shape = (rx: number, ry: number, cx = 20, cy = 20): Pt[] => Array.from({ length: 28 }, (_, i) => {
  const a = (i / 28) * Math.PI * 2;
  const w = 1 + 0.045 * Math.sin(3 * a + seed * 1.7) + 0.025 * Math.sin(5 * a - seed * 2.3);
  const x = Math.cos(a) * rx * w, y = Math.sin(a) * ry * w;
  return [cx + x * Math.cos(rot) - y * Math.sin(rot), cy + x * Math.sin(rot) + y * Math.cos(rot)];
});
const body = smoothClosed(shape(10.6 * asp, 10.6 / asp));
const shadow = smoothClosed(shape(11 * asp, 10.8 / asp, 22.2, 23.2));
const ring1 = smoothClosed(shape(14.6 * asp, 14.6 / asp));
const ring2 = smoothClosed(shape(18.6 * asp, 18.6 / asp));
const id = `pg${seed}`;
---
<svg class="pebble" width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
  <defs>
    <radialGradient id={id} cx="36%" cy="30%" r="78%">
      <stop offset="0" stop-color="var(--peb-hi)" />
      <stop offset="0.5" stop-color="var(--peb)" />
      <stop offset="1" stop-color="var(--peb-lo)" />
    </radialGradient>
  </defs>
  <path class="pebble__ring pebble__ring--2" d={ring2} />
  <path class="pebble__ring pebble__ring--1" d={ring1} />
  <path class="pebble__shadow" d={shadow} />
  <path class="pebble__body" d={body} fill={`url(#${id})`} />
</svg>
