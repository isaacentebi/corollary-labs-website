---
// A real switch: turns the site's motion on and off (defaults to the system setting).
---
<button class="switch" type="button" role="switch" aria-checked="true" data-motion-switch>
  <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
  <span class="label">Motion</span>
  <span class="lamp" aria-hidden="true"></span>
</button>
