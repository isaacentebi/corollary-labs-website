---
// Page title set letter by letter so the width axis can settle on arrival.
// `view`: the absorption waits until the title is in view (home sections).
interface Props { text: string; id?: string; class?: string; as?: 'h1' | 'h2'; view?: boolean }
const { text, id, class: cls = '', as: Tag = 'h1', view = false } = Astro.props;
let i = 0;
const words = text.split(' ').map((w) => [...w].map((c) => ({ c, i: i++ })));
---
<Tag class={`ptitle ${view ? 'ptitle--view' : ''} ${cls}`} id={id} aria-label={text} data-view={view ? '' : undefined}><i class="ptitle__m" aria-hidden="true"></i>
  {words.map((w, k) => (
    <Fragment><span class="w" aria-hidden="true">{w.map((ch) => <span class="ch" style={`--i:${ch.i}`}>{ch.c}</span>)}</span>{k < words.length - 1 ? ' ' : ''}</Fragment>
  ))}
</Tag>
