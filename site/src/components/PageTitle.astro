---
// Page title set letter by letter so the width axis can settle on arrival.
interface Props { text: string; id?: string; class?: string }
const { text, id, class: cls = '' } = Astro.props;
let i = 0;
const words = text.split(' ').map((w) => [...w].map((c) => ({ c, i: i++ })));
---
<h1 class={`ptitle ${cls}`} id={id} aria-label={text}>
  {words.map((w, k) => (
    <Fragment><span class="w" aria-hidden="true">{w.map((ch) => <span class="ch" style={`--i:${ch.i}`}>{ch.c}</span>)}</span>{k < words.length - 1 ? ' ' : ''}</Fragment>
  ))}
</h1>
