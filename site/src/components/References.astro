---
// Footer. Leaves the bottom-right corner free (≈220×48) for the version switcher.
import { site, u } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '');
const pages = [
  { label: 'Capabilities', href: u('#capabilities') },
  { label: 'Approach', href: u('#approach') },
  { label: 'Research', href: u('essays/') },
  { label: 'About', href: u('about/') },
  { label: 'Team', href: u('team/') },
  { label: 'Contact', href: u('contact/') },
];
const cur = (h: string) => (h.replace(/\/$/, '') === path ? 'page' : undefined);
---
<footer class="refs" id="footer">
  <div class="refs__end">
    <p class="refs__h">{site.name}</p>
    <span class="refs__qed" aria-hidden="true"></span>
  </div>
  <div class="refs__grid">
    <nav class="refs__col" aria-label="Footer">
      <ul class="refs__list -row">
        {pages.map((p) => (
          <li><a href={p.href} aria-current={cur(p.href)}>{p.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="refs__col">
      <ul class="refs__list">
        <li>{site.email.startsWith('[') ? <span class="ph">{site.email}</span> : <a href={`mailto:${site.email}`}>{site.email}</a>}</li>
      </ul>
    </div>
  </div>
  <p class="refs__copy">© {site.year} {site.name}</p>
</footer>
