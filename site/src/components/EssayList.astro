---
import type { CollectionEntry } from 'astro:content';
import { u } from '../lib/url';
import { plateFor, fmtDate } from '../lib/plates';
interface Props { essays: CollectionEntry<'essays'>[]; size?: 'small' | 'large' }
const { essays, size = 'small' } = Astro.props;
---
<ol class={`essays essays--${size}`}>
  {essays.map((e, i) => {
    const pl = plateFor(e.id);
    return (
      <li data-reveal data-d={String(i % 3)}>
        <a class="essay-row" href={u(`/research/${e.id}/`)}>
          <canvas class="essay-row__plate" data-plate={pl.kind} data-palette={pl.palette} aria-hidden="true"></canvas>
          <span class="essay-row__meta faint"><time datetime={e.data.date.toISOString()}>{fmtDate(e.data.date)}</time></span>
          <span class="essay-row__title">{e.data.title}</span>
          <span class="essay-row__dek muted">{e.data.dek}</span>
          <span class="essay-row__arrow arrow" aria-hidden="true">→</span>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .essays { border-top: 1px solid var(--rule); }
  .essay-row {
    display: grid; grid-template-columns: 84px 7.5em minmax(0, 1.1fr) minmax(0, 1fr) 24px; gap: 8px 28px; align-items: center;
    padding: 18px 0; border-bottom: 1px solid var(--rule); position: relative;
  }
  .essay-row__plate { width: 84px; height: 60px; border-radius: 2px; background: var(--paper-2); transition: transform 0.8s var(--ease), filter 0.8s var(--ease); }
  .essay-row__meta { font-size: var(--fs-small); font-variant-numeric: tabular-nums; }
  .essay-row__title { font-size: var(--fs-h3); font-weight: 360; line-height: 1.2; letter-spacing: -0.01em; }
  .essay-row__dek { font-size: 0.98rem; line-height: 1.45; }
  .essay-row__arrow { justify-self: end; opacity: 0.5; }
  .essay-row:hover .essay-row__plate { filter: saturate(1.25) brightness(1.06); transform: scale(1.04); }
  .essay-row:hover .essay-row__arrow { opacity: 1; }
  .essays--large .essay-row { grid-template-columns: 180px 7.5em minmax(0, 1.2fr) minmax(0, 1fr) 24px; padding: 26px 0; }
  .essays--large .essay-row__plate { width: 180px; height: 124px; }
  @media (max-width: 900px) {
    .essay-row, .essays--large .essay-row { grid-template-columns: 72px minmax(0, 1fr); gap: 4px 18px; align-items: start; }
    .essay-row__plate, .essays--large .essay-row__plate { width: 72px; height: 88px; grid-row: 1 / span 3; }
    .essay-row__dek { font-size: 0.92rem; }
    .essay-row__arrow { display: none; }
  }
</style>
