---
// A tiny logistic curve glyph used inline in type (hero superscript, footer lines, rows).
interface Props { class?: string; progress?: number; dot?: number }
const { class: cls = 'inline-curve', progress = 0.32, dot = 2.6 } = Astro.props;
const pts = Array.from({ length: 25 }, (_, i) => {
  const t = i / 24; const y = 1 / (1 + Math.exp(-(t - 0.55) * 11));
  return [t * 40, 22 - y * 20];
});
const d = pts.map((p, i) => `${i ? 'L' : 'M'}${p[0].toFixed(2)} ${p[1].toFixed(2)}`).join(' ');
const k = Math.round(progress * 24); const m = pts[k];
---
<svg class={cls} viewBox="0 0 40 24" aria-hidden="true" data-inline-curve>
  <path d={d} fill="none" stroke="var(--ink)" stroke-width="1.6" vector-effect="non-scaling-stroke" pathLength="1" />
  <circle cx={m[0]} cy={m[1]} r={dot} fill="var(--signal)" data-front />
</svg>
