---
import Logo from './Logo.astro';
import { u } from '../config/site';
interface Props { current?: string; overlay?: boolean }
const { current, overlay = false } = Astro.props;
const links = [
  { label: 'Essays', href: u('/essays/'), key: 'essays' },
  { label: 'About', href: u('/about/'), key: 'about' },
  { label: 'Team', href: u('/team/'), key: 'team' },
  { label: 'Contact', href: u('/contact/'), key: 'contact' },
];
---
<header class:list={['head', { 'head--overlay': overlay }]}>
  <Logo />
  <nav class="head__nav" aria-label="Main">
    {links.map((l) => <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>)}
  </nav>
</header>
