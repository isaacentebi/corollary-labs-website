---
// The company's main nav: Capabilities · Approach · Company · Contact. Research is deliberately not here (footer only).
import Wordmark from './Wordmark.astro';
import { site, url } from '../config/site';
const path = Astro.url.pathname;
const current = (label: string) => ((label === 'Company' && /\/(about|team)\/?$/.test(path)) ? 'page' : undefined);
---
<div class="c-header__bg" aria-hidden="true"></div>
<header class="c-header" data-header>
  <div class="c-header__logo"><Wordmark href={url('/')} /></div>
  <nav class="c-header__nav" aria-label="Primary">
    <ul>
      {site.nav.map((n) => <li class:list={{ '-contact': n.label === 'Contact' }}><a href={n.href} aria-current={current(n.label)}>{n.label}</a></li>)}
    </ul>
  </nav>
  <button class="c-header__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle><span data-menu-label>Menu</span></button>
</header>
<div class="c-menu" id="menu" data-menu aria-hidden="true">
  <ul class="c-menu__list">
    {site.nav.map((n) => <li><a href={n.href} data-menu-link>{n.label}</a></li>)}
  </ul>
  <div class="c-menu__foot"><span>{site.email}</span><span>©{site.year}</span></div>
</div>
