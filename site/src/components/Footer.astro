---
// Footer: a tissue of cells (every cell a firm) behind the site's links. Drawn by scripts/tissue.ts.
import { nav, site, u } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const cur = (h: string) => ((h.replace(/\/$/, '') || '/') === path ? 'page' : undefined);
---
<footer class="foot" id="contact-footer">
  <canvas class="foot__tissue" data-tissue aria-hidden="true"></canvas>
  <div class="foot__inner">
    <nav class="foot__nav" aria-label="Footer">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={cur(n.href)}>{n.label}</a></li>)}
      </ul>
    </nav>
    <p class="foot__big t-display" aria-hidden="true">{site.name}</p>
    <div class="foot__meta">
      <a class="link-u" href={`mailto:${site.email}`}>{site.email}</a>
      <span>©{site.year} {site.name}</span>
      <a class="link-u" href="#top" data-to-top>Back to top</a>
    </div>
  </div>
</footer>
