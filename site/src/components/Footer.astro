---
import { site, url, emailLive } from '../config/site';
import Mark from './Mark.astro';
const path = Astro.url.pathname.replace(/\/?$/, '/');
const cur = (h: string) => (!h.includes('#') && path.startsWith(h.replace(/\/?$/, '/')) ? 'page' : undefined);
---
<footer class="c-footer" data-footer>
  <nav class="c-footer__menus" aria-label="Site">
    <div class="c-footer__menu -main">
      <p class="c-footer__title">Index</p>
      <ul class="c-footer__list">
        {site.footer.slice(0, 3).map((n) => <li><a href={n.href} aria-current={cur(n.href)}>{n.label}</a></li>)}
      </ul>
      <ul class="c-footer__list -b">
        {site.footer.slice(3).map((n) => <li><a href={n.href} aria-current={cur(n.href)}>{n.label}</a></li>)}
      </ul>
    </div>
    <div class="c-footer__menu -contact">
      <p class="c-footer__title">Contact</p>
      <ul class="c-footer__list">
        <li>{emailLive ? <a href={`mailto:${site.email}`}>{site.email}</a> : <span>{site.email}</span>}</li>
        <li><a href="#top" data-to-top>Back to top ↑</a></li>
      </ul>
    </div>
  </nav>
  <div class="c-footer__sign">
    <Mark class="c-footer__mark" />
    <p class="c-footer__big">{site.name}</p>
  </div>
  <p class="c-footer__copy">©{site.year} {site.name}</p>
</footer>
