---
import Mark from './Mark.astro';
import { site, nav, u } from '../config/site';
---
<footer class="foot">
  <div class="foot__in">
    <a class="foot__home" href={u('/')}><Mark size={22} /><span>{site.name}</span></a>
    <nav class="foot__links" aria-label="Footer">
      <a href={u('/')}>Home</a>
      {nav.map((l) => <a href={u(l.href)}>{l.label}</a>)}
    </nav>
    <p class="foot__meta"><span class="ph">{site.email}</span><span>© {site.year}</span></p>
  </div>
</footer>
