---
import Mark from './Mark.astro';
import { footerNav, site } from '../config/site';
import { u } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="footer" data-tone-section="day">
  <div class="footer__row">
    <a class="footer__brand" href={u('/')}><Mark size={16} /><span>{site.name}</span></a>
    <nav class="footer__nav" aria-label="Footer">
      {footerNav.map((l) => <a href={u(l.href)}>{l.label}</a>)}
    </nav>
  </div>
  <div class="footer__row footer__meta">
    <span>{site.email}</span>
    <span>{site.location}</span>
    <span>© {year} {site.name}</span>
  </div>
</footer>
