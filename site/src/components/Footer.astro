---
import Mark from './Mark.astro';
import { site, pages } from '../config/site';
import { url } from '../lib/url';
---
<footer class="site-foot wrap">
  <div class="site-foot__grid">
    <div class="site-foot__brand">
      <a class="brand" href={url()}><Mark /><span class="brand__word">{site.name}</span></a>
    </div>
    <nav aria-label="Footer">
      <ul>
        {pages.map((p) => <li><a href={url(p.path)}>{p.label}</a></li>)}
      </ul>
    </nav>
    <div class="site-foot__meta">
      <p><a href="#">{site.email}</a></p>
      <p class="ph">[Location]</p>
      <p class="ph">© {site.year} {site.name}</p>
    </div>
  </div>
</footer>
