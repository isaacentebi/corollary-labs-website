---
import { site, nav, url } from '../config/site';
---
<footer class="ft" id="contact-footer">
  <div class="ft__grid">
    <div class="ft__col">
      <h2 class="mono">Pages</h2>
      <ul>
        <li><a href={url()}>Index</a></li>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>
    <div class="ft__col">
      <h2 class="mono">Contact</h2>
      <ul><li><a href={`mailto:${site.email}`}>{site.email}</a></li></ul>
    </div>
    <div class="ft__col">
      <h2 class="mono">Entity</h2>
      <ul><li>{site.name}</li><li class="ph">[Location]</li></ul>
    </div>
    <div class="ft__col">
      <h2 class="mono">Top</h2>
      <ul><li><a href="#main">Back to top ↑</a></li></ul>
    </div>
  </div>
  <p class="ft__big" aria-hidden="true">{site.name}</p>
  <p class="ft__base mono"><span>©{site.year} {site.name}</span></p>
</footer>
