---
import Mark from './Mark.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="foot">
  <a class="foot__mark" href={base}><Mark size={30} /><span>Corollary Labs</span></a>
  <nav class="mono" aria-label="Site">
    <a href={`${base}#capabilities`}>Capabilities</a>
    <a href={`${base}#approach`}>Approach</a>
    <a href={`${base}essays/`}>Research</a>
    <a href={`${base}about/`}>About</a>
    <a href={`${base}team/`}>Team</a>
    <a href={`${base}contact/`}>Contact</a>
  </nav>
  <p class="foot__small mono"><span class="foot__email">[EMAIL]</span> <span>© 2026 Corollary Labs</span></p>
</footer>
