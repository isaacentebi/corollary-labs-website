---
import Logo from './Logo.astro';
import { site, u } from '../config/site';
---
<footer class="foot">
  <div class="foot__rule" aria-hidden="true"></div>
  <div class="foot__grid">
    <Logo />
    <nav class="foot__nav" aria-label="Footer">
      <a href={u('/#capabilities')}>Capabilities</a>
      <a href={u('/#approach')}>Approach</a>
      <a href={u('/essays/')}>Research</a>
      <a href={u('/about/')}>About</a>
      <a href={u('/team/')}>Team</a>
      <a href={u('/contact/')}>Contact</a>
    </nav>
    <p class="foot__meta"><span>{site.email}</span><span>© {site.year} {site.name}</span></p>
  </div>
</footer>
