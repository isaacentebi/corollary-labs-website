---
import Mark from './Mark.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="foot">
  <a class="foot__mark" href={base}><Mark size={30} /><span>Corollary Labs</span></a>
  <nav aria-label="Site">
    <a href={`${base}essays/`}>Essays</a>
    <a href={`${base}about/`}>About</a>
    <a href={`${base}team/`}>Team</a>
    <a href={`${base}contact/`}>Contact</a>
    <a href="#top">Top</a>
  </nav>
  <p class="foot__small mono">© 2026 Corollary Labs <span class="ph">[Entity — Location]</span></p>
</footer>
