---
// Page title woven as damask: Newsreader rasterised at thread resolution, 1/3 twill on 3/1 ground.
interface Props { text: string; cap?: number; width?: string }
const { text, cap = 24, width = '560px' } = Astro.props;
---
<div class="title">
  <h1 class="sr">{text}</h1>
  <div class="title__cloth" style={`--tw:${width}`}><canvas data-woven={text} data-cap={cap} aria-hidden="true"></canvas></div>
</div>
