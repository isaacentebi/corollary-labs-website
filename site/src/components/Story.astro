---
// Approach figure: one sticky stage, one scroll progress (scripts/story.ts), four labelled beats.
//   01 the organisation → 02 an agent enters → 03 it reorganises → 04 the change spreads (the firm shrinks back into
//   its node, the reorganisation diffuses through the field, and the lattice lifts into the torus).
export const beats = ['The organisation', 'An agent enters', 'It reorganises', 'The change spreads'];
---
<div class="story" data-story>
  <div class="story__stage" data-stage>
    <canvas class="field story__layer" data-field="diffuse" aria-hidden="true"></canvas>
    <svg class="story__diagram story__layer" viewBox="0 0 1200 700" data-diagram role="img"
      aria-label="The organisation: inputs pass through three people to one output, each instructed by a coordination centre. An agent enters at one step. The organisation reorganises: coordination becomes small agents between the steps, people move to the edges, new outputs appear. The change spreads from firm to firm.">
      <defs>
        <filter id="boil" filterUnits="userSpaceOnUse" x="0" y="0" width="1200" height="700">
          <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="1" seed="1" data-boil />
          <feDisplacementMap in="SourceGraphic" scale="2.2" />
        </filter>
      </defs>
      <g data-dg><g filter="url(#boil)" data-ink></g></g>
    </svg>
    <canvas class="story__layer story__surface" data-surface aria-hidden="true"></canvas>
    <ol class="legend" aria-label="Approach, in four steps">
      <li class="legend__head t-label" aria-hidden="true">Approach</li>
      {beats.map((b, i) => (
        <li><button class="legend__beat" type="button" data-beat={i}><span class="legend__n">{String(i + 1).padStart(2, '0')}</span><span class="legend__t">{b}</span></button></li>
      ))}
    </ol>
  </div>
</div>
