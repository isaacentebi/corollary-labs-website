---
// The home page is one story on one stage (Plotsoft: compressed to ~4 screen heights):
//   field (every node is a firm) → dive into one node → the statement beside the firm, figs 1–3 → pull back → diffusion, fig 4
//   → the whole lattice lifts into 3D and changes shape (homotopy coda).
// scripts/story.ts drives everything from one scroll progress.
import { site } from '../config/site';
import Mark from './Mark.astro';
// Captions: placeholders until the copy is written.
export const figs: { n: number; title: string; lines: string[] }[] = [1, 2, 3, 4, 5].map((n) => ({ n, title: '[Title]', lines: ['[Caption — line 1]', '[Caption — line 2]'] }));
---
<section class="story" data-story aria-labelledby="hero-title">
  <h1 class="u-sr" id="hero-title">{site.name}</h1>
  <div class="story__stage" data-stage>
    <canvas class="field story__layer" data-field="hero" aria-hidden="true"></canvas>
    <canvas class="field story__layer" data-field="diffuse" aria-hidden="true"></canvas>
    <svg class="story__diagram story__layer" viewBox="0 0 1200 700" data-diagram role="img"
      aria-label={figs.map((f) => `Figure ${f.n}, ${f.title}. ${f.lines.join(' ')}`).join(' ')}>
      <defs>
        <filter id="dg-blur" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="9" /></filter>
        <filter id="dg-soft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3" /></filter>
      </defs>
      <g data-dg><g data-ink></g></g>
    </svg>
    <canvas class="story__layer story__surface" data-surface aria-hidden="true"></canvas>
    <p class="story__mark" aria-hidden="true"><Mark class="story__markicon" />{site.name}</p>
    <p class="story__statement">
      {site.name} is a company. <span class="ph">[Placeholder — one sentence on what it studies.]</span> <span class="ph">[Placeholder — one sentence on what it builds.]</span>
    </p>
    <div class="story__caption" aria-hidden="true">
      {figs.map((f, i) => (
        <div class="story__fig" data-fig={i}>
          <p class="story__n"><span class="story__num">Fig. {f.n}</span> {f.title}</p>
          {f.lines.map((l) => <p class="story__line">{l}</p>)}
        </div>
      ))}
    </div>
    <span class="story__cue" aria-hidden="true" data-hero-scroll><i></i></span>
  </div>
</section>
