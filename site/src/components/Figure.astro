---
// Essay figure placeholder: a small interference plate (two gratings, one bent). No diagram until the essay is written.
interface Props { kind?: string; n: number; caption: string; wide?: boolean }
import Rings from './Rings.astro';
const { n, caption } = Astro.props;
---
<figure class="plate">
  <Rings cls="plate__img" shape="rect" w={640} h={280} cx={250 + n * 40} cy={150} dx={40 + n * 12} dy={-14} hx={-30} hy={10} pitch={6} />
  <figcaption><span class="plate__n">Fig. {n}</span> <span>{caption}</span></figcaption>
</figure>
