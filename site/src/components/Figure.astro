---
// Essay figures are placeholders here: a generated loop patch and a bracketed caption slot.
import Emblem from './Emblem.astro';
interface Props { kind: string; n: number; caption?: string; wide?: boolean }
const { kind, n } = Astro.props;
---
<figure class="efig">
  <Emblem seed={`${kind}-${n}`} n={7} stroke={0.14} />
  <figcaption><span class="mono">Figure {n}</span> <span class="ph">[Figure caption]</span></figcaption>
</figure>
