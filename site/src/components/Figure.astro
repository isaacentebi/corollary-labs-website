---
// An essay figure: a seeded print, set before (the organisation) and after (with agents).
import Print from './Print.astro';
interface Props { kind?: string; n?: number; caption?: string }
const { kind = 'fig', n = 1, caption = '' } = Astro.props;
const seed = `${kind}-${n}`;
---
<figure class="fig">
  <div class="fig__pair">
    <Print seed={seed} state="before" class="fig__print" />
    <Print seed={seed} state="after" class="fig__print" />
  </div>
  <figcaption><span class="fig__n">Fig. {n}</span> {caption}</figcaption>
</figure>
