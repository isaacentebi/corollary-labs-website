---
// Essay figures: a still of the needle field, drawn at build time with the same maths as the home instrument.
import { baseAngle, flowParams, swirl, holdAt } from '../lib/fieldmath';
interface Props { kind: string; n: number; caption: string }
const { kind, n, caption } = Astro.props;

const W = 760, H = 300, s = 25;
const cols = Math.round(W / s), rows = Math.round(H / s);
const L = H;
const flow = flowParams(n + (kind === 'gap' ? 5 : kind === 'dissolve' ? 9 : 2), -0.05);
// agents in figure units (0..1 of W, H)
const agents = kind === 'gap' ? [{ u: 0.27, v: 0.5 }] : kind === 'dissolve' ? [{ u: 0.2, v: 0.4 }, { u: 0.52, v: 0.62 }, { u: 0.8, v: 0.36 }] : [{ u: 0.5, v: 0.48 }];
const snap = (u: number, v: number) => ({ x: (Math.floor(u * cols) + 0.5) * (W / cols), y: (Math.floor(v * rows) + 0.5) * (H / rows) });
const pts = agents.map((a) => snap(a.u, a.v));
const out = { x: 0, y: 0 };
let needles = '', rings = '';
for (let j = 0; j < rows; j++) for (let i = 0; i < cols; i++) {
  const x = (i + 0.5) * (W / cols), y = (j + 0.5) * (H / rows);
  const b = baseAngle(flow, x / W, y / H);
  let vx = 0, vy = 0, keep = 1;
  // in the 'gap' figure only the left half has reorganised
  const reach = kind === 'gap' ? x < W * 0.52 : true;
  if (reach) for (const a of pts) {
    const dx = ((x - a.x) / L) * 0.62, dy = ((y - a.y) / L) * 0.62;
    swirl(dx, dy, out); vx += out.x; vy += out.y;
    keep *= 1 - holdAt(Math.hypot(dx, dy));
  }
  const t = Math.atan2(vy + keep * Math.sin(b), vx + keep * Math.cos(b));
  const hx = Math.cos(t) * s * 0.34, hy = Math.sin(t) * s * 0.34, tx = Math.cos(t) * s * 0.1, ty = Math.sin(t) * s * 0.1;
  const seg = `M${(x - tx).toFixed(1)} ${(y - ty).toFixed(1)}L${(x + hx).toFixed(1)} ${(y + hy).toFixed(1)}`;
  needles += seg;
  rings += `M${(x + s * 0.37).toFixed(1)} ${y.toFixed(1)}a${(s * 0.37).toFixed(1)} ${(s * 0.37).toFixed(1)} 0 1 0 0 0.01`;
}
---
<figure class="fig">
  <div class="fig__panel">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Figure ${n}`}>
      <path d={rings} fill="none" stroke="#dcdad4" stroke-opacity=".12" stroke-width="1" />
      <path d={needles} fill="none" stroke="#dcdad4" stroke-opacity=".82" stroke-width="1.6" stroke-linecap="round" />
      {kind === 'gap' && <path d={`M${W * 0.52} 6 V${H - 6}`} stroke="#dcdad4" stroke-opacity=".25" stroke-dasharray="2 5" />}
      {pts.map((a) => <circle cx={a.x} cy={a.y} r={s * 0.3} fill="#f2bf1b" />)}
    </svg>
  </div>
  <figcaption><span class="mono">Fig. {String(n).padStart(2, "0")}</span><span>{caption}</span></figcaption>
</figure>
