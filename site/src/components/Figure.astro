---
// Essay figures — generated in code (never images). Animated by scripts/essay.ts:
// paths with pathLength=1 draw in, [data-t] cells fill in order, [data-live] markers ride the curve with scroll.
interface Props { kind: 'gap' | 'dissolve' | 'org' | 'curve' | 'layers'; n: number; caption: string; wide?: boolean }
const { kind, n, caption, wide = true } = Astro.props;

const W = 760, H = 300, L = 44, R = 16, T = 22, B = 36;
const X = (t: number) => L + t * (W - L - R);
const Y = (v: number) => H - B - v * (H - T - B);
const logistic = (t: number, mid: number, k: number) => 1 / (1 + Math.exp(-(t - mid) * k));
const path = (f: (t: number) => number, n = 120) =>
  Array.from({ length: n + 1 }, (_, i) => { const t = i / n; return `${i ? 'L' : 'M'}${X(t).toFixed(1)} ${Y(f(t)).toFixed(1)}`; }).join(' ');

// deterministic pseudo-random
let s = 17 + n * 31;
const rnd = () => { s = (s * 16807) % 2147483647; return (s - 1) / 2147483646; };

let body = '';
const axes = `<path d="M${L} ${T} V${H - B} H${W - R}" class="fig-axis" pathLength="1"/>` +
  [0.25, 0.5, 0.75, 1].map((t) => `<path d="M${X(t)} ${H - B} v5" class="fig-tick"/>`).join('') +
  [0.25, 0.5, 0.75, 1].map((v) => `<path d="M${L} ${Y(v)} H${W - R}" class="fig-grid"/>`).join('');

if (kind === 'gap' || kind === 'curve') {
  const cap = (t: number) => logistic(t, 0.12, 30);
  const adopt = (t: number) => logistic(t, kind === 'gap' ? 0.62 : 0.55, 9);
  const between = Array.from({ length: 40 }, (_, i) => {
    const t = 0.1 + (i / 39) * 0.75; const a = adopt(t), c = cap(t);
    return c - a > 0.04 ? `<path d="M${X(t).toFixed(1)} ${Y(c).toFixed(1)} V${Y(a).toFixed(1)}" class="fig-hatch" data-t="${(i / 39).toFixed(3)}"/>` : '';
  }).join('');
  body = axes + (kind === 'gap' ? between + `<path d="${path(cap)}" class="fig-line -soft" pathLength="1"/>` : '') +
    `<path d="${path(adopt)}" class="fig-line" pathLength="1" data-curve/>` +
    `<rect x="-4" y="-4" width="8" height="8" class="fig-front" data-live data-live-from="${kind === 'gap' ? 0.05 : 0.02}" data-live-to="${kind === 'gap' ? 0.95 : 0.2}"/>` +
    (kind === 'gap'
      ? `<text x="${X(0.16)}" y="${Y(0.93)}" class="fig-label">capability</text><text x="${X(0.66)}" y="${Y(0.3)}" class="fig-label">adoption</text><text x="${X(0.36)}" y="${Y(0.62)}" class="fig-label -muted">the gap</text>`
      : `<text x="${X(0.05)}" y="${Y(0.2)}" class="fig-label">we are here</text><path d="M${X(0.06)} ${Y(0.16)} L${X(0.09)} ${Y(0.06)}" class="fig-tick"/>`) +
    `<text x="${L}" y="${H - 10}" class="fig-label -muted">time →</text><text x="6" y="${T + 4}" class="fig-label -muted">share</text>`;
}

if (kind === 'dissolve') {
  // a row of firms, left to right: each old firm (a ring issuing plans to three steps) gives way to a mesh
  // with agents at its nodes. Walls are soft closed curves, not a grid.
  const n = 7, cw = (W - 40) / n;
  const wall = (cx: number, cy: number, rx: number, ry: number, sd: number) => {
    let d = ''; const m = 48;
    for (let i = 0; i <= m; i++) { const t = (i / m) * Math.PI * 2; const w = 1 + 0.05 * Math.sin(3 * t + sd) + 0.03 * Math.sin(5 * t - sd); d += `${i ? 'L' : 'M'}${(cx + Math.cos(t) * rx * w).toFixed(1)} ${(cy + Math.sin(t) * ry * w).toFixed(1)}`; }
    return d + 'Z';
  };
  for (let i = 0; i < n; i++) {
    const t = i / (n - 1); const cx = 20 + cw * (i + 0.5), cy = 128 + (rnd() - 0.5) * 16;
    const rx = cw * 0.46, ry = 86 + (rnd() - 0.5) * 12;
    body += `<path d="${wall(cx, cy, rx, ry, i)}" class="fig-wall${t > 0.45 ? ' -on' : ''}"/>`;
    if (t <= 0.45) {
      body += `<circle cx="${cx}" cy="${cy - 30}" r="11" class="fig-ring"/>` + [-1, 0, 1].map((k) => `<path d="M${cx} ${cy - 19} Q${cx + k * 10} ${cy} ${cx + k * 22} ${cy + 18}" class="fig-strand"/><path d="M${cx + k * 22 - 6} ${cy + 32} A6.5 6 0 0 1 ${cx + k * 22 + 6} ${cy + 32}" class="fig-strand"/><circle cx="${cx + k * 22}" cy="${cy + 21}" r="3" class="fig-ring"/>`).join('');
    } else {
      const pts: [number, number][] = Array.from({ length: 7 }, () => [cx + (rnd() - 0.5) * rx * 1.3, cy + (rnd() - 0.5) * ry * 1.3]);
      pts.forEach((p, k) => { const q = pts[(k + 1) % pts.length], r2 = pts[(k + 3) % pts.length]; body += `<path d="M${p[0].toFixed(1)} ${p[1].toFixed(1)} Q${cx} ${cy} ${q[0].toFixed(1)} ${q[1].toFixed(1)} M${p[0].toFixed(1)} ${p[1].toFixed(1)} L${r2[0].toFixed(1)} ${r2[1].toFixed(1)}" class="fig-net"/>`; });
      pts.forEach((p, k) => { body += k % 3 === 0 ? `<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="5" class="fig-junction"/><circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="1.8" class="fig-node"/>` : `<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="2.4" class="fig-junction"/>`; });
    }
  }
  body += `<text x="${20}" y="${H - 8}" class="fig-label -muted">coordination issuing plans</text><text x="${W - 16}" y="${H - 8}" class="fig-label" text-anchor="end">coordination as a mesh</text>`;
}

if (kind === 'org') {
  const teams = ['finance', 'legal', 'ops', 'sales', 'support', 'eng', 'hr', 'research'];
  const months = 24, cw = (W - 90) / months, ch = (H - 60) / teams.length;
  const lag = [0.55, 0.8, 0.3, 0.45, 0.2, 0.1, 0.7, 0.05];
  body = teams.map((tm, j) => {
    let row = `<text x="0" y="${20 + j * ch + ch * 0.62}" class="fig-label -muted">${tm}</text>`;
    for (let i = 0; i < months; i++) {
      const t = i / months; const p = logistic(t, lag[j] + 0.18, 7 + j) * (0.85 + rnd() * 0.3);
      const on = p > 0.5, part = p > 0.18;
      row += `<circle cx="${(80 + i * cw + cw / 2).toFixed(1)}" cy="${(20 + j * ch + ch / 2).toFixed(1)}" r="${(Math.min(cw, ch) * (on ? 0.4 : part ? 0.3 : 0.22)).toFixed(1)}" class="fig-cell ${on ? '-on' : part ? '-part' : ''}" data-t="${t.toFixed(3)}"/>`;
    }
    return row;
  }).join('') + `<text x="80" y="${H - 12}" class="fig-label -muted">month 1</text><text x="${W - 70}" y="${H - 12}" class="fig-label -muted">month 24</text>`;
}

if (kind === 'layers') {
  const layers = ['tools', 'tasks', 'roles', 'processes', 'institutions'];
  body = axes + layers.map((ly, i) => {
    const f = (t: number) => logistic(t, 0.2 + i * 0.16, 12 - i * 1.4);
    return `<path d="${path(f)}" class="fig-line ${i ? '-soft' : ''}" pathLength="1" style="opacity:${1 - i * 0.15}"/>` +
      `<text x="${X(Math.min(0.94, 0.26 + i * 0.16))}" y="${Y(0.52) - 6}" class="fig-label ${i ? '-muted' : ''}" transform="rotate(-58 ${X(Math.min(0.94, 0.26 + i * 0.16))} ${Y(0.52) - 6})">${ly}</text>`;
  }).join('') + `<rect x="-4" y="-4" width="8" height="8" class="fig-front" data-live data-live-from="0.05" data-live-to="0.6"/>`;
}
---
<figure class:list={['fig', { '-wide': wide }]} data-figure data-kind={kind}>
  <div class="fig__plate">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Figure ${n}. ${caption}`} set:html={body} />
  </div>
  <figcaption class="fig__cap"><span class="fig__n">Fig. {String(n).padStart(2, '0')}</span> {caption}</figcaption>
</figure>
