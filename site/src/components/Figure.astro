---
// Essay figures: a small piece of ground (rendered live by scripts/band.ts). No labels; the caption is the essay's.
interface Props { kind?: string; n: number; caption: string }
const { kind = 'org', n, caption } = Astro.props;
const layouts: Record<string, { x: number; y: number; r: number; rose?: number; a?: number }[]> = {
  org: [{ x: -0.16, y: 0.02, r: 0.16 }, { x: 0.0, y: -0.05, r: 0.2 }, { x: 0.15, y: 0.03, r: 0.14 }],
  gap: [{ x: -0.26, y: -0.02, r: 0.17 }, { x: -0.12, y: 0.08, r: 0.13 }, { x: 0.2, y: 0.0, r: 0.17 }, { x: 0.3, y: -0.12, r: 0.08, rose: 1 }],
  dissolve: [{ x: 0.0, y: 0.0, r: 0.08, rose: 1 }, { x: -0.1, y: -0.12, r: 0.13 }, { x: 0.12, y: -0.08, r: 0.14 }, { x: 0.02, y: 0.18, r: 0.13 }],
};
const stones = layouts[kind] ?? layouts.org;
---
<figure class="efig" data-reveal>
  <div class="efig__ground band" data-band={JSON.stringify({ stones, space: 11 })}></div>
  <figcaption><span class="efig__n">Figure {n}</span> {caption}</figcaption>
</figure>
