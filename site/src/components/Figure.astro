---
// Essay figure placeholder: a typographic plate on the grid until the real figure exists.
interface Props { kind?: string; n: number; caption: string; wide?: boolean }
const { n, caption } = Astro.props;
---
<figure class="efig">
  <div class="efig__plate" aria-hidden="true"><span>[Figure {n}]</span><i></i></div>
  <figcaption><span class="label">Fig. {n}</span> {caption}</figcaption>
</figure>
