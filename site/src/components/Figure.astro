---
// Essay figure: a small structure at rest, drawn in the same axonometric. The caption is the essay's.
interface Props { kind?: string; n: number; caption: string }
const { kind = 'org', n, caption } = Astro.props;
---
<figure class="efig">
  <canvas class="efig__c" data-axon={kind} aria-hidden="true"></canvas>
  <figcaption><span class="mono">Fig. {n}</span> {caption}</figcaption>
</figure>
