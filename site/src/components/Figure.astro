---
// Essay figure: a cloth with one or more new threads, rewoven when it scrolls into view.
import Loom from './Loom.astro';
import { hash } from '../lib/weave';
interface Props { kind?: string; n: number; caption: string; wide?: boolean }
const { kind = 'org', n, caption } = Astro.props;
const h = hash(kind + n);
const threads = kind === 'dissolve'
  ? [{ af: 0.2, vc: 8, R: 30 }, { af: 0.56 + h * 0.1, vc: 18, R: 34 }, { af: 0.88, vc: 6, R: 22 }]
  : kind === 'gap' ? [{ af: 0.3 + h * 0.4, vc: 12, R: 16 }] : [{ af: 0.3 + h * 0.4, vc: 12, R: 44 }];
---
<figure class="fig">
  <Loom rows={26} cellCss={5} threads={threads} grow ms={2200} />
  <figcaption><span class="mono">Fig. {n}</span> <span class="ph">[{caption}]</span></figcaption>
</figure>
