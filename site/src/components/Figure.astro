---
// Essay figure: a drawdown generated in code. Props kept compatible with the essays' MDX.
import Drawdown from './Drawdown.astro';
import { hash } from '../lib/weave';
interface Props { kind?: string; n: number; caption: string; wide?: boolean }
const { kind = 'org', n, caption } = Astro.props;
const h = hash(kind + n);
const axis = 14 + Math.floor(h * 40);
const radius = kind === 'gap' ? 10 : kind === 'dissolve' ? 38 : 24;
---
<figure class="fig">
  <Drawdown cols={72} rows={22} axis={axis} radius={radius} seed={kind + n} />
  <figcaption><span class="mono">Fig. {n}</span> <span class="ph">[{caption}]</span></figcaption>
</figure>
