---
// Essay figure placeholder: a seeded composition with its caption. (Real figures are drawn later.)
import Glyph from './Glyph.astro';
interface Props { kind: string; n: number; caption: string; wide?: boolean }
const { kind, n, caption } = Astro.props;
---
<figure class="fig" data-glyph-host tabindex="0">
  <div class="fig__plate"><Glyph seed={`fig-${kind}-${n}`} big /></div>
  <figcaption><span class="t-label">Fig. {n}</span> <span>{caption}</span></figcaption>
</figure>
