---
// Essay figures: a small piece of ground (rendered live by scripts/band.ts). No labels; the caption is the essay's.
interface Props { kind?: string; n: number; caption: string }
const { kind = 'org', n, caption } = Astro.props;
const layouts: Record<string, { x: number; y: number; r: number; rose?: number; a?: number }[]> = {
  org: [{ x: -0.16, y: 0.02, r: 0.16, sq: 0.5, a: 1.3 }, { x: 0.02, y: -0.05, r: 0.1, tone: 1, gloss: 0.8 }, { x: 0.15, y: 0.05, r: 0.14 }],
  gap: [{ x: -0.26, y: -0.02, r: 0.17 }, { x: -0.13, y: 0.1, r: 0.07, tone: 1, gloss: 0.8 }, { x: 0.18, y: 0.0, r: 0.19, sq: 0.6, a: 1.25 }, { x: 0.33, y: -0.12, r: 0.07, rose: 1, gloss: 0.85 }],
  dissolve: [{ x: 0.0, y: 0.0, r: 0.07, rose: 1, gloss: 0.85 }, { x: -0.12, y: -0.1, r: 0.14, sq: 0.5 }, { x: 0.13, y: -0.07, r: 0.08, tone: 1, gloss: 0.8 }, { x: 0.02, y: 0.2, r: 0.12 }],
};
const stones = layouts[kind] ?? layouts.org;
---
<figure class="efig" data-reveal>
  <div class="efig__ground band" data-band={JSON.stringify({ stones, space: 11, group: true, drag: true, moat: 90, pad: 26 })}></div>
  <figcaption><span class="efig__n">Figure {n}</span> {caption}</figcaption>
</figure>
