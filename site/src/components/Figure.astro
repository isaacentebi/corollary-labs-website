---
// Essay figure: a still plate from the site's light, with a caption.
interface Props { kind?: string; n?: number; caption?: string }
const { kind = 'org', n, caption } = Astro.props;
const map: Record<string, [string, string]> = {
  org: ['volume', 'blossom'],
  gap: ['crossing', 'cross'],
  dissolve: ['fold', 'sunset'],
  horizon: ['horizon', 'dusk'],
};
const [plate, palette] = map[kind] ?? map.org;
---
<figure class="fig">
  <canvas class="fig__plate" data-plate={plate} data-palette={palette} aria-hidden="true"></canvas>
  {caption && <figcaption><span class="fig__n">Fig. {n}</span> {caption}</figcaption>}
</figure>
