---
// A small seeded composition of planes on the site's axis. On hover of the nearest [data-glyph-host]
// the planes re-order across the other diagonal and the cadmium bar (the agent) arrives.
// Both arrangements are fitted inside the 0–100 box, so nothing spills past the grid.
interface Props { seed: string | number; class?: string; big?: boolean }
const { seed, class: cls = '', big = false } = Astro.props;

let h = 2166136261;
for (const ch of String(seed)) { h ^= ch.charCodeAt(0); h = Math.imul(h, 16777619); }
let s = (h >>> 0) % 2147483646 || 1;
const r = () => { s = (s * 16807) % 2147483647; return (s - 1) / 2147483646; };

const cols = ['var(--chalk)', 'var(--haze)', 'var(--pewter)', 'var(--slate)', 'var(--chalk)', 'var(--haze)', 'var(--pewter)', 'var(--chalk)'];
const n = big ? 7 : 5;
const base = -28;
type R = { w: number; h: number; fill: string; ax: number; ay: number; ar: number; bx: number; by: number; br: number };
const raw: R[] = Array.from({ length: n }, (_, i) => {
  const long = i === 0 || r() > 0.62;
  const w = long ? 48 + r() * 36 : 8 + r() * 20;
  const hh = long ? (i === 0 ? 10 + r() * 8 : 2.5 + r() * 4) : 6 + r() * 12;
  return {
    w, h: hh, fill: cols[i % cols.length],
    ax: (r() - 0.5) * 50, ay: (r() - 0.5) * 50, ar: base + (r() > 0.78 ? 90 : 0) + (r() - 0.5) * 6,
    bx: (r() - 0.5) * 30, by: (r() - 0.5) * 30, br: base + 90 + (r() - 0.5) * 26,
  };
});
// fit: largest extent of any rotated rectangle in either arrangement
const ext = (x: number, y: number, w: number, hh: number, deg: number) => {
  const a = (deg * Math.PI) / 180, c = Math.abs(Math.cos(a)), sn = Math.abs(Math.sin(a));
  return Math.max(Math.abs(x) + (w * c + hh * sn) / 2, Math.abs(y) + (w * sn + hh * c) / 2);
};
const m = Math.max(...raw.map((q) => Math.max(ext(q.ax, q.ay, q.w, q.h, q.ar), ext(q.bx, q.by, q.w, q.h, q.br))));
const k = Math.min(1, 47 / m);
const T = (x: number, y: number, deg: number) => `translate(${(50 + x * k).toFixed(1)}px,${(50 + y * k).toFixed(1)}px) rotate(${deg.toFixed(1)}deg)`;
const rects = raw.map((q, i) => ({ w: q.w * k, h: q.h * k, fill: q.fill, a: T(q.ax, q.ay, q.ar), b: T(q.bx, q.by, q.br), d: (i * 0.035).toFixed(3) }));
const agA = `translate(92px,8px) rotate(${base + 90}deg) scale(0.2,1)`;
const agB = T((r() - 0.5) * 8, (r() - 0.5) * 8, base);
---
<svg class={`glyph ${cls}`} viewBox="0 0 100 100" aria-hidden="true">
  {rects.map((q) => (
    <rect x={-q.w / 2} y={-q.h / 2} width={q.w} height={q.h} fill={q.fill} style={`--a:${q.a};--b:${q.b};--d:${q.d}s`} />
  ))}
  <rect class="glyph__ag" x={-9 * k} y="-1.6" width={18 * k} height="3.2" fill="var(--cad)" style={`--a:${agA};--b:${agB};--d:0s`} />
</svg>

<style is:global>
  .glyph { overflow: visible; }
  .glyph rect { transform-box: view-box; transform: var(--a); transition: transform 0.9s var(--ease) var(--d); }
  .glyph .glyph__ag { opacity: 0; transition: transform 0.9s var(--ease), opacity 0.3s; }
  [data-glyph-host]:hover .glyph rect, [data-glyph-host]:focus-visible .glyph rect { transform: var(--b); }
  [data-glyph-host]:hover .glyph .glyph__ag, [data-glyph-host]:focus-visible .glyph .glyph__ag { opacity: 1; }
</style>
